---
import type { Faq } from '../data/faqs';

interface Props {
  items: Faq[];
  /** Open the first one by default */
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details class="faq__item" open={openFirst && i === 0} data-rise data-armed
               style={`--rise-delay:${Math.min(i * 60, 300)}ms`}>
        <summary class="faq__q">
          <span>{item.q}</span>
          <span class="faq__sign" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <div class="faq__a"><p>{item.a}</p></div>
      </details>
    ))
  }
</div>

<style>
  .faq { border-top: 1px solid var(--rule); }

  .faq__item { border-bottom: 1px solid var(--rule); }

  .faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-5);
    padding: var(--s-5) 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    line-height: 1.35;
    color: var(--ink);
    transition: color 200ms ease;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--navy); }

  .faq__sign {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 0.35em;
    color: var(--navy);
  }
  .faq__sign i {
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 320ms var(--ease), opacity 220ms ease;
  }
  .faq__sign i:last-child { transform: rotate(90deg); }
  .faq__item[open] .faq__sign i:last-child { transform: rotate(0deg); opacity: 0; }

  .faq__a {
    padding-bottom: var(--s-5);
    color: var(--ink-body);
    max-width: 68ch;
    font-size: var(--t-base);
    line-height: 1.65;
  }

  /* Native <details> can't transition height; this animates the content only,
     which reads the same and costs nothing. */
  .faq__item[open] .faq__a { animation: faq-open 380ms var(--ease); }
  @keyframes faq-open {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item[open] .faq__a { animation: none; }
  }
</style>
