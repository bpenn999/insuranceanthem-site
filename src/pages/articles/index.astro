---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import site from '../../config/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const title = 'Medicare Articles & Guides';
const description = `Plain-English Medicare explainers from ${site.agent.name} — enrollment windows, Advantage versus Supplement, drug plan costs and the traps that catch people out.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Articles', path: '/articles/' },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={title}
  description={description}
  path="/articles/"
  breadcrumbs={breadcrumbs}
  density="light"
>
  <PageHero
    eyebrow="Articles"
    title="The explanations, written out."
    lede="The questions that come up most often, answered properly rather than in a paragraph. No sign-up, no gate."
    breadcrumbs={breadcrumbs}
    caustics="0.4"
  />

  <section class="section section--tight" data-caustics="0.18">
    <div class="wrap">
      {
        articles.length === 0 ? (
          <p class="empty">No articles published yet — check back shortly.</p>
        ) : (
          <ul class="posts">
            {articles.map((a, i) => (
              <li data-rise data-armed style={`--rise-delay:${Math.min(i * 70, 280)}ms`}>
                <a href={`/articles/${a.id}/`} class="post">
                  <div class="post__meta">
                    <span class="post__topic">{a.data.topic}</span>
                    <span class="post__dot" aria-hidden="true">·</span>
                    <time datetime={a.data.publishedAt.toISOString()}>{fmt(a.data.publishedAt)}</time>
                    <span class="post__dot" aria-hidden="true">·</span>
                    <span>{a.data.readMinutes} min read</span>
                  </div>
                  <h2 class="post__title">{a.data.title}</h2>
                  <p class="post__summary">{a.data.summary}</p>
                  <span class="post__more">
                    Read it
                    <svg viewBox="0 0 14 10" aria-hidden="true">
                      <path d="M9 1l4 4-4 4M13 5H1" fill="none" stroke="currentColor"
                            stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <CtaBand
    title="Reading only gets you so far."
    body="Every one of these ends the same way: your own doctors, your own prescriptions, your own ZIP. That part needs a conversation — and it costs nothing."
  />
</BaseLayout>

<style>
  .posts { list-style: none; padding: 0; display: grid; gap: 0; }
  .posts > li { border-top: 1px solid var(--rule); }
  .posts > li:last-child { border-bottom: 1px solid var(--rule); }

  .post {
    display: block;
    padding: var(--s-6) 0;
    color: inherit;
    transition: padding-left 340ms var(--ease);
  }
  .post:hover { padding-left: var(--s-4); }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--t-xs);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    margin-bottom: var(--s-3);
  }
  .post__topic {
    color: var(--navy);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .post__dot { opacity: 0.5; }

  .post__title {
    font-size: var(--t-2xl);
    margin-bottom: var(--s-3);
    max-width: 24ch;
    transition: color 220ms ease;
  }
  .post:hover .post__title { color: var(--navy); }

  .post__summary {
    font-size: var(--t-base);
    color: var(--ink-muted);
    line-height: 1.65;
    max-width: 62ch;
    margin-bottom: var(--s-4);
  }

  .post__more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--navy);
  }
  .post__more svg { width: 14px; height: 10px; transition: transform 340ms var(--ease); }
  .post:hover .post__more svg { transform: translateX(4px); }

  .empty { color: var(--ink-muted); }

  @media (prefers-reduced-motion: reduce) {
    .post:hover { padding-left: 0; }
    .post:hover .post__more svg { transform: none; }
  }
</style>
