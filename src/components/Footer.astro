---
import { getCollection } from 'astro:content';
import site from '../config/site';
import { products } from '../data/products';
import { tools } from '../data/tools';
import { locations } from '../data/locations';
import { tpmoText, nonAffiliation, notAdvice } from '../data/compliance';

/**
 * Site-wide footer.
 *
 * Blocks, in order: advisor row → sitemap columns (incl. Contact/NAP) →
 * wordmark → compliance. Structure mirrors Medicare On Main's footer.
 *
 * The TPMO disclaimer appears HERE AND NOWHERE ELSE. It is required once per
 * page; repeating it on a page (as the Terms page used to) is not "extra
 * compliant", it just gives a reader two copies to reconcile. The audit script
 * asserts exactly one occurrence per page.
 *
 * Single office — Anthem, AZ. Do not add other locations here; the other
 * markets belong to a different brand entirely.
 */
const year = new Date().getFullYear();

// Top Learn articles, chosen by the same rule as the hub: featured first, then
// most recent. Publishing a new guide updates the footer with no edit here.
/**
 * Built as a single string rather than interpolated inline, so it renders as
 * one contiguous run of text. JSX interpolation inserts newlines mid-sentence,
 * which is invisible on screen but breaks any exact-match check over the HTML.
 */
const licenceLine = [
  site.agent.name,
  `National Producer Number ${site.agent.npn}`,
  `Licensed in ${site.agent.statesLicensed} states`,
  `Licensed insurance agency in ${site.address.regionName}`,
].join(' · ');

/**
 * EVERY published guide is listed — no slice. The footer is the site's sitemap
 * for readers and crawlers alike; truncating it to a "top 5" hides the newest
 * articles from both. Publishing a guide adds it here with no edit to this file.
 */
const learnAll = (await getCollection('learn', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});
---

<footer class="site-footer" data-caustics="0.18">
  <div class="wrap--wide">

    <!-- ── Advisor row ────────────────────────────────────────────────── -->
    <div class="foot__advisor">
      <a href="/" class="foot__logo" aria-label={`${site.name} — home`}>
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path d="M16 2.5 3.5 8v9.2c0 7.1 5.1 11.6 12.5 14.3 7.4-2.7 12.5-7.2 12.5-14.3V8L16 2.5Z"
                fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M10 16.6h3.4l1.5-4 2.2 7 1.6-3h3.3"
                fill="none" stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <div class="foot__advisor-txt">
        <span class="foot__advisor-kicker">Your local advisor</span>
        <strong>{site.agent.name}</strong>
        {/* The experience + NPN pair is asserted by scripts/audit.mjs on every
            page — it lives here and only here. Don't drop it from this line. */}
        <span class="foot__advisor-line">
          {site.agent.title} · {site.agent.experience} Experience · NPN {site.agent.npn}
        </span>
        <span class="foot__advisor-line">
          {site.address.locality}, {site.address.region} · Licensed in {site.agent.statesLicensed} states
        </span>
      </div>

      <div class="foot__advisor-actions">
        <a href={site.consult.url} class="btn btn--light" data-magnetic="0.26">
          {site.consult.label}
        </a>
        <a href={site.phone.href} class="btn btn--onNavy">Call {site.phone.display}</a>
      </div>
    </div>

    <!-- ── Sitemap ────────────────────────────────────────────────────── -->
    <nav class="foot__map" aria-label="Footer">
      <div class="foot__col">
        <h2 class="foot__heading">Company</h2>
        <ul>
          <li><a href="/about/">About Brian</a></li>
          <li><a href="/service-area/">Service Area</a></li>
          {locations.map((l) => <li><a href={`/service-area/${l.slug}/`}>Medicare in {l.city}</a></li>)}
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__heading">Guides &amp; Articles</h2>
        <ul>
          <li><a href="/learn/">All guides</a></li>
          {learnAll.map((a) => <li><a href={`/learn/${a.id}/`}>{a.data.title}</a></li>)}
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__heading">Plans &amp; Coverage</h2>
        <ul>
          {products.map((p) => <li><a href={`/${p.slug}/`}>{p.fullName}</a></li>)}
          <li><a href="/medicare-plans/">Compare all four</a></li>
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__heading">Free Tools</h2>
        <ul>
          <li><a href="/tools/">All tools</a></li>
          {tools.map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>)}
        </ul>
      </div>

      <!-- NAP — one office, structured for both humans and parsers -->
      <div class="foot__col foot__col--contact">
        <h2 class="foot__heading">Contact</h2>
        <address class="foot__nap">
          <p class="foot__nap-name">{site.legalName}</p>
          <p class="foot__nap-line">{site.address.display}</p>
          <p><a href={site.phone.href} class="foot__phone">{site.phone.display}</a></p>
          <p><a href={`mailto:${site.email}`} class="foot__email">{site.email}</a></p>
          <p class="foot__hours">{site.hours.display}</p>
        </address>
      </div>
    </nav>

    <!-- ── Wordmark ───────────────────────────────────────────────────── -->
    <div class="foot__wordmark"><span>Daisy Mountain <em>Insurance</em></span></div>

    <!-- ── Compliance — the ONLY place the TPMO disclaimer appears ─────── -->
    <div class="foot__legal">
      <p class="foot__licence">{licenceLine}</p>
      <p>{tpmoText()}</p>
      <p>{nonAffiliation}</p>
      <p>{notAdvice}</p>
      <p class="foot__legal-fine">
        We comply with applicable federal civil rights laws and do not discriminate on the basis of
        race, color, national origin, age, disability or sex.
      </p>
    </div>

    <div class="foot__base">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <p class="foot__base-right">
        Your local advisor · {site.address.locality}, {site.address.region}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--navy-deep);
    color: #B9CBD9;
    padding-block: clamp(3rem, 6vw, 4.5rem) var(--s-6);
    font-size: var(--t-sm);
    line-height: 1.65;
  }

  /* ── advisor row ─────────────────────────────────────────────────── */
  .foot__advisor {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding-bottom: var(--s-7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .foot__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex: none;
  }
  .foot__logo svg { width: 46px; height: 46px; }

  .foot__advisor-txt { display: flex; flex-direction: column; line-height: 1.35; }
  .foot__advisor-kicker {
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #7FA3BE;
    font-weight: 600;
  }
  .foot__advisor-txt strong {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #fff;
    letter-spacing: -0.015em;
  }
  .foot__advisor-line { font-size: var(--t-sm); color: #A6BCCC; }

  .foot__advisor-actions {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  @media (max-width: 720px) {
    .foot__advisor-actions { margin-left: 0; }
  }

  /* ── NAP ─────────────────────────────────────────────────────────── */
  .foot__nap { font-style: normal; display: grid; gap: 0.3rem; align-content: start; }
  .foot__nap-name {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #7FA3BE;
    margin-bottom: 0.2rem;
  }
  .foot__nap-line { color: #C3D5E2; }
  .foot__phone {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: #fff;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    display: inline-block;
    margin-block: 0.15rem;
  }
  .foot__phone:hover { color: #9CC0DC; }
  .foot__email { color: #DCE8F1; }
  .foot__email:hover { color: #fff; }
  .foot__hours { color: #8FA8BA; font-size: var(--t-xs); margin-top: 0.2rem; }

  /* ── sitemap ─────────────────────────────────────────────────────── */
  .foot__map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
    padding-block: var(--s-7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .foot__heading {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #7FA3BE;
    margin-bottom: var(--s-3);
  }
  .foot__col ul { list-style: none; padding: 0; display: grid; gap: 0.45rem; }
  .foot__col a {
    color: #C3D5E2;
    display: inline-block;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 380ms var(--ease), color 200ms ease;
    padding-bottom: 1px;
    line-height: 1.45;
  }
  .foot__col a:hover { color: #fff; background-size: 100% 1px; }

  .foot__col--contact .foot__nap p { margin: 0; }

  /* ── wordmark ────────────────────────────────────────────────────── */
  .foot__wordmark { padding-block: var(--s-6) var(--s-5); }
  .foot__wordmark span {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    /* Sized to span the band edge-to-edge. Two things drive these numbers: the
       name is 24 characters (~9.7em wide on Fraunces), and Fraunces is optically
       sized, so width-per-em grows as the type shrinks — hence the lower vw
       below 860px. Retune both values if the brand name ever changes length;
       nowrap + overflow:hidden is only the backstop, not the plan. */
    font-size: clamp(20px, 7vw, 44px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    max-width: 100%;
  }
  /* Three tiers, not two: between 860 and 1024 the optical size is still wide
     enough (~10.4em) that the desktop 9vw would run past the gutter. */
  @media (min-width: 860px) {
    .foot__wordmark span { font-size: 8vw; }
  }
  @media (min-width: 1024px) {
    .foot__wordmark span { font-size: min(9vw, 135px); }
  }
  .foot__wordmark em { font-style: normal; color: #7FA3BE; }

  /* ── compliance ──────────────────────────────────────────────────── */
  .foot__legal {
    padding-block: var(--s-6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    gap: 0.7rem;
    font-size: 0.78125rem;
    line-height: 1.6;
    color: #8FA8BA;
    max-width: 92ch;
  }
  .foot__licence { color: #C3D5E2; font-weight: 500; }
  .foot__legal-fine { color: #7A93A6; }

  .foot__base {
    padding-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    font-size: 0.78125rem;
    color: #7A93A6;
  }

  /* ── responsive ──────────────────────────────────────────────────── */
  @media (min-width: 860px) {
    /* Five columns, MOM-style. Guides carries the longest titles, Contact the
       widest unbreakable strings (email, phone), so both get extra track. */
    .foot__map { grid-template-columns: 1fr 1.35fr 1.15fr 1fr 1.1fr; }
  }
</style>
