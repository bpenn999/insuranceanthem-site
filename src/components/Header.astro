---
import site from '../config/site';
import { products } from '../data/products';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const nav = [
  { label: 'Medicare Plans', href: '/medicare-plans/', children: products.map((p) => ({ label: p.name, href: `/${p.slug}/`, blurb: p.blurb })) },
  { label: 'Free Tools', href: '/tools/' },
  { label: 'Service Area', href: '/service-area/' },
  { label: 'Learn', href: '/learn/' },
  { label: 'About', href: '/about/' },
];

/**
 * The wordmark is two-tone: "602" in the badge red, "Medicare" in the badge
 * navy. The halves come from `site.wordmark` rather than from splitting
 * `site.name` — the name is one word with no space to split on, and the lockup
 * sets the two halves flush against each other on purpose.
 *
 * Note the colors are the INVERSE of the badge itself, where "602" is navy and
 * "MEDICARE" is red. That is deliberate: side by side, matching them made the
 * lockup read as one long doubled word.
 */
const { mark, product } = site.wordmark;
---

<div class="header-sentinel" aria-hidden="true"></div>

<header class="site-header">
  <div class="wrap--wide header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      {/* The badge. Decorative here — the wordmark beside it already carries the
          name, and the <a> has its own aria-label — so it is alt="" rather than
          a second announcement of "602Medicare". Explicit width/height reserve
          the box before the PNG lands; `fetchpriority=high` because it is the
          one image above the fold on every page. */}
      <img
        class="brand__mark"
        src="/logo/602medicare-logo-transparent.png"
        alt=""
        width="464"
        height="464"
        decoding="async"
        fetchpriority="high"
      />
      <span class="brand__text">
        <span class="brand__name">
          <span class="brand__name-mark">{mark}</span><span class="brand__name-product">{product}</span>
        </span>
        <span class="brand__sub">Medicare, done locally</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li class={item.children ? 'has-menu' : ''}>
            <a href={item.href} class:list={['nav-link', { 'is-active': isActive(item.href) }]}
               aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && (
                <svg class="nav-caret" viewBox="0 0 10 6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"
                        stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="submenu">
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>
                        <span class="submenu__name">{c.label}</span>
                        <span class="submenu__blurb">{c.blurb}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href={site.phone.href} class="header__phone">
        <svg viewBox="0 0 16 16" aria-hidden="true" class="header__phone-icon">
          <path d="M3 1.5h2.2l1.1 2.8-1.4 1a8.5 8.5 0 0 0 3.8 3.8l1-1.4 2.8 1.1V11c0 1.9-1.6 3.4-3.5 3.1A11.4 11.4 0 0 1 1.4 5C1.1 3.1 2.6 1.5 4.5 1.5Z"
                fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
        </svg>
        <span class="sr-only">Call {site.name} at </span>{site.phone.display}
      </a>
      <a href="/contact/" class="btn btn--sm header__cta" data-magnetic="0.22">Get my review</a>

      <button class="nav-toggle" data-nav-toggle aria-expanded="false"
              aria-controls="mobile-nav" aria-label="Menu">
        <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="nav-mobile" id="mobile-nav" data-nav-panel>
  <nav aria-label="Mobile">
    <ul class="nav-mobile__list">
      <li><a href="/">Home</a></li>
      {products.map((p) => <li><a href={`/${p.slug}/`}>{p.name}</a></li>)}
      <li><a href="/tools/">Free Tools</a></li>
      <li><a href="/service-area/">Service Area</a></li>
      <li><a href="/learn/">Learn</a></li>
      <li><a href="/about/">About Brian</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
    <div class="nav-mobile__foot">
      <a href={site.phone.href} class="btn btn--block btn--lg">Call {site.phone.display}</a>
      <p class="nav-mobile__note">{site.hours.display}</p>
    </div>
  </nav>
</div>

<style>
  .header-sentinel { position: absolute; top: 0; height: 1px; width: 100%; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    background: color-mix(in srgb, var(--page) 82%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 300ms var(--ease), background-color 300ms var(--ease),
                box-shadow 300ms var(--ease);
  }
  /* Once stuck, the bar needs to be opaque enough that scrolling text does not
     ghost through it — at 92% the NPN line under the hero read as a smear. */
  .site-header.is-stuck {
    border-bottom-color: var(--rule);
    background: color-mix(in srgb, var(--page) 97%, transparent);
    box-shadow: 0 1px 20px rgba(23, 26, 29, 0.05);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 4.5rem;
  }

  /* --- brand --- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--navy);
    flex: none;
  }
  /* The badge, capped at 44px tall — under the 48px brief, and it keeps the
     header row at its existing 4.5rem without the lockup crowding the nav.
     Square source (464×464), so width follows height. */
  .brand__mark {
    height: 44px;
    width: 44px;
    flex: none;
  }
  @media (max-width: 400px) {
    .brand__mark { height: 38px; width: 38px; }
  }

  .brand__text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  /* Tight lockup: no margin, no space, no word break between the halves — they
     are two colors of ONE word. Both are real text colors on white (red
     5.6:1, navy 16.9:1), which the old gold half never was. */
  .brand__name-mark { color: var(--red); }
  .brand__name-product { color: var(--navy); }
  .brand__sub {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 500;
  }

  /* --- desktop nav --- */
  .nav-desktop { display: none; }
  .nav-desktop ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.25rem; }
  .nav-desktop li { position: relative; }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-body);
    border-radius: var(--radius);
    position: relative;
    transition: color 200ms ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.25rem;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 380ms var(--ease);
  }
  .nav-link:hover { color: var(--red); }
  .nav-link:hover::after,
  .nav-link.is-active::after { transform: scaleX(1); }
  .nav-link.is-active { color: var(--navy); }

  .nav-caret { width: 9px; height: 6px; opacity: 0.55; transition: transform 260ms var(--ease); }
  .has-menu:hover .nav-caret, .has-menu:focus-within .nav-caret { transform: rotate(180deg); }

  .submenu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 20rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 0.4rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 220ms var(--ease), transform 220ms var(--ease), visibility 220ms;
  }
  .has-menu:hover .submenu, .has-menu:focus-within .submenu {
    opacity: 1; visibility: visible; transform: none;
  }
  .submenu ul { display: block; }
  .submenu a {
    display: block;
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius);
    transition: background-color 180ms ease;
  }
  .submenu a:hover { background: var(--navy-wash); }
  .submenu__name { display: block; font-weight: 600; font-size: 0.875rem; color: var(--ink); }
  .submenu__blurb {
    display: block; font-size: 0.75rem; color: var(--ink-muted);
    line-height: 1.45; margin-top: 0.1rem;
  }

  /* --- actions --- */
  .header__actions { display: flex; align-items: center; gap: 0.6rem; flex: none; }

  .header__phone {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    padding: 0.4rem 0.5rem;
    font-variant-numeric: tabular-nums;
  }
  .header__phone:hover { color: var(--red); }
  .header__phone-icon { width: 15px; height: 15px; color: var(--red); }

  .header__cta { display: none; }
  :global(.btn--sm) { padding: 0.6rem 1.1rem; min-height: 40px; font-size: 0.8125rem; }

  /* --- mobile toggle --- */
  .nav-toggle {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border-radius: var(--radius);
    color: var(--ink);
  }
  .nav-toggle__bars { display: grid; gap: 5px; width: 20px; }
  .nav-toggle__bars i {
    display: block; height: 1.5px; background: currentColor; border-radius: 2px;
    transition: transform 300ms var(--ease), opacity 200ms ease;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars i:first-child { transform: translateY(3.25px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars i:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  /* --- mobile panel --- */
  .nav-mobile {
    position: fixed;
    inset: 4.5rem 0 0;
    z-index: 79;
    background: var(--page);
    padding: var(--s-6) var(--gutter) var(--s-8);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 280ms var(--ease), transform 280ms var(--ease), visibility 280ms;
  }
  .nav-mobile[data-open] { opacity: 1; visibility: visible; transform: none; }

  .nav-mobile__list { list-style: none; margin: 0 0 var(--s-7); padding: 0; }
  .nav-mobile__list li + li { border-top: 1px solid var(--rule-soft); }
  .nav-mobile__list a {
    display: block;
    padding: 0.95rem 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink);
  }
  .nav-mobile__foot { display: grid; gap: var(--s-3); }
  .nav-mobile__note { font-size: var(--t-sm); color: var(--ink-muted); text-align: center; }

  @media (min-width: 900px) {
    .nav-desktop { display: block; }
    .nav-toggle { display: none; }
    .nav-mobile { display: none; }
    .header__phone { display: inline-flex; }
    .header__cta { display: inline-flex; }
  }
  @media (min-width: 1100px) {
    .brand__sub { display: block; }
  }
  @media (max-width: 400px) {
    .brand__sub { display: none; }
  }
</style>
