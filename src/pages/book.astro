---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookingPicker from '../components/BookingPicker.astro';
import site, { abs } from '../config/site';

/**
 * The booking page.
 *
 * This is the page src/config/site.ts always anticipated: `consult.url` used to
 * point at /contact/?intent=30-minute-call because no calendar existed. It now
 * points here, so every "Book a free 1-hour call" CTA on the site — the
 * footer, every Learn article, every blog post, every tool page, the hubs —
 * lands on a real calendar with no other edit.
 *
 * WHAT CHANGED 2026-08-08. Until now this page was a facade in front of a
 * cross-origin `<iframe>` of GoGuruX's scheduler. The performance argument for
 * the facade was sound and is preserved in spirit below, but the embed itself
 * was wrong for the audience: its time picker was a scroll list, its date grid
 * did not render usably at 375px, and neither could be reached from here —
 * a cross-origin document cannot be styled, sized or tested by its host.
 *
 * So the calendar is now drawn by src/components/BookingPicker.astro, against
 * the same endpoints the embed itself calls. The iframe survives as a fallback
 * the picker reveals if those endpoints fail. See src/config/booking.ts for the
 * API, and for the warning that it is undocumented.
 *
 * The facade is gone with it, and the performance reason it existed goes too:
 * the picker is this site's own JavaScript, it renders the month grid before
 * any network call returns, and the one request it makes on load is an XHR to
 * an API rather than a competing cross-origin *document*. There is nothing left
 * for the browser to hold the paint for.
 *
 * The CSP hole in public/_headers changed shape to match: `frame-src` stays for
 * the fallback, and `connect-src` now names the same origin the picker fetches
 * from. It is still the only third party this site touches.
 *
 * The page is deliberately light: no caustics, no reveal animations, nothing
 * competing with the calendar. Someone who reached this page has already
 * decided.
 *
 * ONE MORE THING ABOUT THE INLINE SCRIPT BELOW. Its postMessage allowlist used
 * to carry GoGuruX's two `http://127.0.0.1` development origins. They were inert
 * in production — nothing can post from a loopback origin in a visitor's browser
 * unless they are running the app themselves — but CLAUDE.md's leak guard greps
 * the BUILT site for that word, HTML comments included, and they were its only
 * hits. They are gone. Keep the explanation up here in the frontmatter, which
 * Astro strips, rather than in the comment on the script, which ships.
 */

const title = 'Book a Free 1-Hour Medicare Call';
const description = `Pick a time that works — no cost, no obligation. Talk to ${site.agent.name} directly about your Medicare options, or call ${site.phone.display}.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Book a call', path: '/book/' },
];

const schemaNodes = [
  {
    '@type': 'WebPage',
    '@id': `${abs('/book/')}#webpage`,
    url: abs('/book/'),
    name: title,
    description,
    isPartOf: { '@id': `${site.origin}/#website` },
    about: { '@id': `${site.origin}/#organization` },
    potentialAction: {
      '@type': 'ReserveAction',
      name: site.consult.label,
      target: abs('/book/'),
      result: {
        '@type': 'Reservation',
        name: `${site.consult.minutes}-minute Medicare consultation`,
        provider: { '@id': `${site.origin}/#organization` },
      },
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/book/"
  breadcrumbs={breadcrumbs}
  schemaNodes={schemaNodes}
  density="light"
>
  <PageHero
    eyebrow="Book a call"
    title="Pick a time that suits you."
    lede={`No cost, no obligation, and no call center — you get ${site.agent.name} directly. Bring your prescription list and the doctors you want to keep if you have them handy; if not, we will start anyway.`}
    breadcrumbs={breadcrumbs}
  />

  <section class="section section--tight">
    <div class="wrap">
      <BookingPicker />

      {/* The intake form, offered BEFORE the appointment as well as on the
          picker's confirmation panel. Someone who books three weeks out will
          not scroll back to a panel they saw once — and a client who fills it
          in ahead of time turns the appointment into a plan comparison rather
          than an interview. Same link the GoGuruX confirmation text and the
          reminder email carry. */}
      <aside class="intake">
        <p class="intake__eyebrow">Before we meet</p>
        <h2 class="intake__h">Fill out your Medicare intake form</h2>
        <p class="intake__copy">{site.intake.blurb}</p>
        <a class="btn btn--lg" href={site.intake.url} target="_blank" rel="noopener">
          {site.intake.label} →
        </a>
          <p class="intake__hint">Medicare Advantage, or not sure yet? Use the button above. Getting a Medigap or a Part D drug plan only? Use the <a href={site.partDIntake.url} target="_blank" rel="noopener">{site.partDIntake.label}</a> instead.</p>
        <p class="intake__hint">
          Opens in a new tab. Already booked? Fill it in any time before your
          appointment — or we will do it together on the call.
        </p>
      </aside>

      {/* Self-serve path for people who already know their plan. Second, after
          the intake card: a call is still the recommended route. */}
      <aside class="intake intake--enroll">
        <p class="intake__eyebrow">Prefer to do it yourself?</p>
        <h2 class="intake__h">Compare plans and enroll online</h2>
        <p class="intake__copy">{site.enroll.blurb}</p>
        <a class="btn btn--lg btn--ghost" href={site.enroll.url} target="_blank" rel="noopener nofollow" data-cta="book-enroll">
          {site.enroll.label} →
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<!--
  Booking-confirmation redirect, for the FALLBACK EMBED ONLY.

  The native picker never posts this — it shows its own confirmation panel. But
  if the picker has fallen back to the iframe, the embed still posts a message
  when a booking completes and this hands the visitor onward.

  `is:inline` because it must NOT be bundled — it has to run on this page and
  only this page. The origin allowlist is the security boundary: a `message`
  listener with no origin check will accept a postMessage from ANY frame,
  including a hostile one, and this one ends in `window.location.assign`.

  GoGuruX's own two development origins used to be in this list — see the
  frontmatter note above for why they are gone.

  The URL is re-parsed and its protocol checked before navigating, so a
  `javascript:` payload from a compromised allowed origin still cannot execute.
-->
<script is:inline>
  // After a booking (2026-10-23, Brian: "confirmation page has the Medicare
  // intake form twice"): the picker's confirmation panel already carries the
  // intake ask, so the page's own intake card, the self-enroll card and the
  // "Calendar not loading?" line go away and the confirmation stands alone.
  document.addEventListener('ia:booked', function () {
    document.querySelectorAll('aside.intake, .bk__phone').forEach(function (el) { el.hidden = true; el.style.display = 'none'; });
  });
</script>
<script is:inline>
  (function () {
    var MSG = 'ggx-booking-confirmation-redirect';
    var ALLOWED = ['https://my.gogurux.com'];
    window.addEventListener('message', function (event) {
      if (!event.data || event.data.type !== MSG) return;
      if (ALLOWED.indexOf(event.origin) === -1) return;
      var raw = String(event.data.url || '').trim();
      if (!raw) return;
      try {
        var u = new URL(raw);
        if (u.protocol !== 'http:' && u.protocol !== 'https:') return;
        window.location.assign(u.toString());
      } catch (e) {}
    });
  })();
</script>

<!--
  Google Ads (2026-10-23). /book/ shows no consent bar of its own: the tag loads
  ONLY if the visitor already allowed it on the ad landing page
  (/turning-65-medicare-help/, localStorage ia_ads_consent=accept). A confirmed
  booking then records the "Book appointment" conversion. CSP: public/_headers.
-->
<script is:inline>
  (function () {
    var ok = false;
    try { ok = localStorage.getItem('ia_ads_consent') === 'accept'; } catch (e) {}
    if (!ok) return;
    var TAG = 'AW-1004695098';
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
    var s = document.createElement('script'); s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + TAG;
    document.head.appendChild(s);
    window.gtag('js', new Date());
    window.gtag('config', TAG, { allow_enhanced_conversions: false });
    document.addEventListener('ia:booked', function () {
      window.gtag('event', 'conversion', { send_to: 'AW-1004695098/BUXeCJ2avPEcELrcid8D', value: 1.0, currency: 'USD' });
    });
  })();
</script>

<style>
  .intake {
    max-width: 40rem;
    margin: var(--s-9) auto 0;
    padding: var(--s-6) var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--navy-wash);
    text-align: center;
  }
  .intake--enroll {
    margin-top: var(--s-5);
    background: transparent;
  }
  .intake__eyebrow {
    font-size: var(--t-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--navy);
    margin: 0;
  }
  .intake__h {
    font-size: var(--t-xl);
    margin: var(--s-2) 0 var(--s-3);
  }
  /* 18px body and a 54px button — the same floors the picker above it uses
     for a 65-plus audience. */
  .intake__copy {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--ink-body);
    max-width: 42ch;
    margin: 0 auto var(--s-5);
  }
  .intake__hint {
    font-size: var(--t-sm);
    color: var(--ink-muted);
    max-width: 46ch;
    margin: var(--s-4) auto 0;
  }
  @media (max-width: 430px) {
    .intake .btn { width: 100%; }
  }
</style>

<script>
  // ?topic=t65 (TurningSixtyFive.astro) or situation=turning-65 (home survey):
  // say so above the calendar; the picker tags the booking itself.
  {
    const q = new URLSearchParams(location.search);
    if (q.get('topic') === 't65' || q.get('situation') === 'turning-65') {
      const h = document.querySelector<HTMLElement>('main h1, .hero h1, h1');
      const eb = document.querySelector<HTMLElement>('.eyebrow');
      if (h) h.textContent = 'Book your Turning-65 planning call.';
      if (eb) eb.textContent = 'Turning 65';
    }
  }
</script>
