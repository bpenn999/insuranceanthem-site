# Cloudflare Pages redirects.
#
# /articles/ was the original content hub. It was consolidated into /learn/ so
# the site has one place to read rather than two competing ones. These keep any
# existing links and indexed URLs working.
/articles/                     /learn/            301
/articles/:slug                /learn/:slug       301
/articles/:slug/               /learn/:slug/      301

# Common guesses for the content hub.
#
# /blog USED to redirect here, back when /learn/ was the only place to read.
# It is a real section now, and on Cloudflare Pages a _redirects rule wins over
# a static asset at the same path — so those three lines made the entire blog
# unreachable in production while every local check passed. Do not put them
# back. scripts/audit.mjs now fails if any rule shadows a built route.
/guides                        /learn/            301
/guides/                       /learn/            301

# The product pages live at the root, not under /services/.
/services                      /medicare-plans/   301
/services/                     /medicare-plans/   301
