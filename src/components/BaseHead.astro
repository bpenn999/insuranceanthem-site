---
import site, { abs } from '../config/site';
import { fonts } from '../data/fonts';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/medicare-advantage/" — canonical is derived */
  path?: string;
  /** Override the OG image path */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: string;
  modifiedAt?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/og-602medicare-badge.png',
  type = 'website',
  noindex = false,
  publishedAt,
  modifiedAt,
} = Astro.props;

const canonical = abs(path);
const ogImage = abs(image);
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

/**
 * HARD CAP: 155 characters, every page, no exceptions.
 *
 * Google truncates past roughly 155, and a truncated description is the defect
 * that ships silently — it renders fine, it just gets cut in the one place
 * anybody sees it. Nineteen of this site's forty-two pages were over before
 * this check existed, several of them over by construction (a fixed tail
 * appended to a variable blurb).
 *
 * Thrown at BUILD rather than flagged in the audit so a long description can
 * never reach a deploy. scripts/audit.mjs re-checks the built HTML as a
 * backstop, because a description can also arrive from a static file that
 * never passes through here.
 */
if (description.length > 155) {
  throw new Error(
    `BaseHead: meta description for ${path} is ${description.length} chars (max 155).\n` +
      `  ${description}`,
  );
}

/**
 * The @font-face block, built here rather than written literally below, because
 * the filenames are content-hashed by scripts/build-fonts.py and change with
 * the bytes — see src/data/fonts.ts.
 */
const UNICODE_LATIN =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, ' +
  'U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, ' +
  'U+2212, U+2215, U+FEFF, U+FFFD';

const fontFaceCss = `
@font-face{font-family:'Fraunces';font-style:normal;font-weight:300 600;font-display:swap;src:url('${fonts.fraunces}') format('woff2');unicode-range:${UNICODE_LATIN};}
@font-face{font-family:'Inter';font-style:normal;font-weight:400 600;font-display:swap;src:url('${fonts.inter}') format('woff2');unicode-range:${UNICODE_LATIN};}
`.trim();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Local signals -->
<meta name="geo.region" content="US-AZ" />
<meta name="geo.placename" content={`${site.address.locality}, ${site.address.regionName}`} />
<meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
<meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />
<meta name="author" content={site.agent.name} />
<meta name="theme-color" content="#011459" />

<!--
  Icons — the real badge, shipped 2026-08-07. Every file comes straight out of
  602medicare-logo-pack.zip and lives under /logo/, a path that has never been
  served before. That is on purpose: public/_headers caches `/*.png` for seven
  days, so re-using the old /brand/mark-*.png names would have kept the navy-
  and-gold placeholder tiles in browser tabs for a week after this deploy.

  favicon.ico is generated from icon-512 by scripts/build-favicon-ico.py and
  carries 16/32/48 for older browsers; favicon-32 lets modern ones skip the .ico
  entirely. apple-touch-icon-180 and the two manifest icons are opaque, because
  iOS composites a transparent touch icon onto black.

  THE `-v2` SUFFIX IS INEXPENSIVE INSURANCE, NOT CLUTTER. These files were
  re-encoded 62% smaller after launch, and re-encoding them UNDER THE SAME NAMES
  changed nothing for anyone: the edge kept serving the originals for the rest of
  the seven days. Any future re-encode needs another new name.
-->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/logo/favicon-32-v2.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/logo/apple-touch-icon-180-v2.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!--
  Fonts: Fraunces (display) + Inter (body), both variable, latin subset, SELF
  HOSTED from /fonts/.

  They used to come from Google Fonts, which cost two extra origins on the
  critical path — a DNS lookup, a TCP connection and a TLS handshake each, for
  fonts.googleapis.com and then again for fonts.gstatic.com, before a single
  byte of font arrived. On a throttled 4G phone that was most of a second of
  First Contentful Paint, and it delayed the swap that Largest Contentful Paint
  is measured on, because the H1 is the LCP element.

  Preloaded rather than merely declared: an @font-face in a stylesheet is not
  fetched until the renderer finds text that needs it, which is one round trip
  too late for a font that styles the first thing on the page.

  `font-display: swap` keeps text visible in the fallback throughout, so this
  can never cause invisible text. The fallback stacks in global.css are metric-
  adjacent on purpose, which is why CLS stays at 0 across the swap.
-->
<!--
  BOTH are preloaded. Measured, not assumed: preloading Inter alone (on the
  theory that only the LCP paragraph's font matters) cost 0.4s of First
  Contentful Paint and seven points, because Fraunces is then not discovered
  until the renderer parses the CSS and finds the H1 — one round trip too late
  for the largest text on the screen. Preload both, and keep them small; that is
  what scripts/build-fonts.py is for.
-->
<link rel="preload" as="font" type="font/woff2" href={fonts.fraunces} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={fonts.inter} crossorigin />
<style is:inline set:html={fontFaceCss}></style>

<!--
  Decide the motion mode BEFORE first paint. Adding `.motion` here is what lets
  the CSS hold armed elements hidden — without it (JS off, or reduced-motion)
  every animated element simply renders in its final visible state.
-->
<script is:inline>
  (function () {
    try {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    } catch (e) {
      /* no matchMedia → no motion class → everything visible. Fine. */
    }
  })();
</script>
