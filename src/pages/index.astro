---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kinetic from '../components/Kinetic.astro';
import HeroFunnel from '../components/HeroFunnel.astro';
import TrustBar from '../components/TrustBar.astro';
import SectionHead from '../components/SectionHead.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ToolsPreview from '../components/ToolsPreview.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import PostCard from '../components/PostCard.astro';
import site from '../config/site';
import { homeFaqs } from '../data/faqs';
import { serviceAreaRows, serviceAreaListText } from '../data/locations';
import { posts } from '../data/posts';

const title = `Phoenix-Metro Medicare Help | ${site.name}`;
const description =
  "Independent Medicare help from a 22-year advisor in Anthem, AZ — Advantage, Supplement & Part D across Scottsdale, Glendale & the Valley. (602) 844-6002.";

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout title={title} description={description} path="/" schemaNodes={[faqSchema]}>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero" data-caustics="0.68">
    {/* ── Background video (Brian, 2026-10-25) ──────────────────────────────
        A 19-second muted loop: North Valley aerial → desert golf → golfers on the
        tee → a couple dining outdoors → a goldendoodle (Pexels, free licence).
        Speed rules, verified in the 602-video-mockup run:
          · the still frame is the LCP image and is preloaded (BaseHead.astro);
            it is full-size (1080x1920 on phones) on purpose — a smaller poster
            lets the video's first frame take over as LCP;
          · the <video> has no src and preload="none"; the inline script gives it
            one only after window "load", on idle;
          · phones get a vertical 540x960 cut (~0.8 MB), desktop 1280x720 (~1.5 MB);
          · skipped entirely for reduced motion, Save-Data and 2G.
        Pause button for WCAG 2.2.2. */}
    <picture>
      <source media="(max-width:820px)" srcset="/img/hero-north-valley-m.webp" width="1080" height="1920" />
      <img class="hero__bg" src="/img/hero-north-valley-1920.webp"
           srcset="/img/hero-north-valley-800.webp 800w, /img/hero-north-valley-1200.webp 1200w, /img/hero-north-valley-1920.webp 1920w"
           sizes="100vw" width="1920" height="1080" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
    </picture>
    <video class="hero__bg hero__video" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1"
           data-webm="/video/hero-v3.webm" data-mp4="/video/hero-v3.mp4"
           data-webm-m="/video/hero-v3-m.webm" data-mp4-m="/video/hero-v3-m.mp4"></video>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <div class="hero__copy">
        {/* Brian, 2026-09-24: the hero names the three places that matter —
            Anthem (home office), Peoria (the 85383 storefront) and the West
            Valley — not the nine-community list, which still lives on the
            service-area pages and the footer. */}
        <p class="hero__eyebrow">
          <span class="hero__pin" aria-hidden="true"></span>
          Independent Medicare help · Anthem, Peoria &amp; the West Valley
        </p>

        <h1 class="hero__title">
          <Kinetic text="The right Medicare plan, without the runaround." stagger={44} armed={false} />
        </h1>

        <p class="hero__lede">
          I check your doctors, prescriptions and budget against the plans in the Valley, then help
          you enroll in the one that fits. No call center, no script, and no cost to you.
        </p>

        {/* Call first and filled; the form CTA is the outline. Same reasoning as
            the header — the number is the primary path, so it gets the primary
            treatment and the first position. */}
        <div class="hero__actions">
          <a href={site.phone.href} class="btn btn--lg" data-magnetic="0.3" data-cta="hero-call">
            Call {site.phone.display}
          </a>
          <a href={site.consult.url} class="btn btn--ghost btn--lg" data-magnetic="0.22">
            Get a free plan review
          </a>
        </div>

        <p class="hero__meta">
          <strong>{site.agent.name}</strong> · {site.agent.title} · NPN {site.agent.npn}
        </p>
      </div>

      <aside class="hero__funnel" aria-label="Start a free plan review">
        <HeroFunnel />
      </aside>
    </div>
    <button class="hero__pause" type="button" hidden aria-label="Pause background video">❚❚&nbsp; Pause video</button>
  </section>
  <script is:inline>
    (function () {
      var v = document.querySelector('.hero__video');
      var btn = document.querySelector('.hero__pause');
      if (!v || !btn) return;
      var c = navigator.connection || {};
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || c.saveData || /(^|-)2g$/.test(c.effectiveType || '')) return;
      var phone = window.matchMedia('(max-width:820px)').matches;
      function start() {
        var webm = v.canPlayType('video/webm; codecs="vp9"');
        v.src = phone ? (webm ? v.dataset.webmM : v.dataset.mp4M) : (webm ? v.dataset.webm : v.dataset.mp4);
        v.addEventListener('playing', function () { v.classList.add('is-playing'); btn.hidden = false; }, { once: true });
        var p = v.play(); if (p && p.catch) p.catch(function () {});
      }
      function go() { 'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 300); }
      if (document.readyState === 'complete') go(); else addEventListener('load', go, { once: true });
      btn.addEventListener('click', function () {
        if (v.paused) { v.play(); btn.innerHTML = '❚❚&nbsp; Pause video'; btn.setAttribute('aria-label', 'Pause background video'); }
        else { v.pause(); btn.innerHTML = '▶&nbsp; Play video'; btn.setAttribute('aria-label', 'Play background video'); }
      });
    })();
  </script>

  <!-- ── Trust bar ────────────────────────────────────────────────────── -->
  <TrustBar />

  <!-- ── Services ─────────────────────────────────────────────────────── -->
  <section class="section" data-caustics="0.42">
    <div class="wrap">
      <SectionHead
        eyebrow="What we do"
        title="Medicare, and everything around it."
        lede="These four are where most conversations start. Around them sits the rest of what a household actually needs after 65 — dental-vision-hearing, cancer, heart attack and stroke plans, hospital indemnity, short-term home health care and final expense — plus retirement income and Social Security planning for households with $250,000 or more in investable assets."
      />
      <ServicesGrid />
      <p class="services__foot" data-rise data-armed>
        Not sure which of these you need? That is the normal starting point.
        <a href="/tools/plan-type-finder/" class="link">Answer six questions</a> and we will narrow it down.
      </p>
    </div>
  </section>

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <section class="section band--tint" data-caustics="0.3">
    <div class="wrap">
      <SectionHead
        eyebrow="How it works"
        title="Three steps. About forty minutes, total."
        lede="Most of the work happens before any paperwork comes out."
      />
      <ol class="steps">
        <li class="step" data-rise data-armed>
          <span class="step__num" aria-hidden="true">01</span>
          <h3 class="step__title">You tell me what matters</h3>
          <p class="step__body">
            Your doctors, your prescriptions with dosages, your pharmacy, whether you travel, and
            what you can comfortably spend each month. Twenty minutes on the phone or at a kitchen
            table in Anthem — your choice.
          </p>
        </li>
        <li class="step" data-rise data-armed style="--rise-delay:110ms">
          <span class="step__num" aria-hidden="true">02</span>
          <h3 class="step__title">I run the comparison</h3>
          <p class="step__body">
            Every plan available in your ZIP, priced against your actual medication list at your
            actual pharmacy, with your doctors checked against each network. Then I show you the
            two or three that survive — including where each one falls short.
          </p>
        </li>
        <li class="step" data-rise data-armed style="--rise-delay:220ms">
          <span class="step__num" aria-hidden="true">03</span>
          <h3 class="step__title">You decide, and I stay</h3>
          <p class="step__body">
            You pick. I handle the enrollment paperwork, and then I am still your agent — for the
            billing question in March, the network change in July, and the review every fall
            before the plan year rolls over.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── Free tools ───────────────────────────────────────────────────── -->
  <section class="section" data-caustics="0.42">
    <div class="wrap">
      <SectionHead
        eyebrow="Free tools"
        title="Work some of it out yourself first."
        lede="No email gate, no sign-up, nothing saved. Use them, close the tab, and call only if you want to."
      />
      <ToolsPreview />
      <p class="services__foot" data-rise data-armed>
        <a href="/tools/" class="link">See all free tools</a>
      </p>
    </div>
  </section>

  <!-- ── Advisor ──────────────────────────────────────────────────────── -->
  <section class="section band--tint-deep" data-caustics="0.26">
    <div class="wrap advisor">
      <div class="advisor__copy">
        <p class="eyebrow" data-rise data-armed>Your advisor</p>
        <h2><Kinetic text="Brian Penner" stagger={50} /></h2>
        <p class="lede advisor__lede" data-rise data-armed style="--rise-delay:180ms">
          {site.agent.experience} in Medicare, based in Anthem, working the north Valley.
        </p>
        <div class="advisor__body" data-rise data-armed style="--rise-delay:250ms">
          <p>
            I am independent, which means I am not tied to one carrier's product shelf and I am not
            paid more to steer you toward a particular plan. The carriers pay the same commission
            whichever one you choose, and it costs you nothing either way — so the only thing left
            to optimize is whether the plan is right.
          </p>
          <p>
            After twenty-two years, the part I am actually good at is the unglamorous bit: reading
            a formulary properly, catching the network change before it becomes a surprise bill,
            and telling you plainly when the plan you are on is already the right one.
          </p>
        </div>
        <div class="advisor__actions" data-rise data-armed style="--rise-delay:320ms">
          <a href="/about/" class="btn btn--ghost" data-magnetic="0.24">More about Brian</a>
        </div>
      </div>

      <div class="advisor__side">
      {/* Brian, 2026-10-18: his headshot on the Arizona-dusk background (option B).
          Below the fold, so it is lazy, ~17KB max, and sized up front (no layout shift). */}
      <img class="advisor__photo" src="/img/brian-penner-az-640.webp"
           srcset="/img/brian-penner-az-400.webp 400w, /img/brian-penner-az-640.webp 640w"
           sizes="(min-width: 900px) 360px, 80vw" width="640" height="800"
           alt="Brian Penner, independent Medicare advisor in Anthem, Arizona"
           loading="lazy" decoding="async" />
      <ul class="advisor__facts" data-rise data-armed style="--rise-delay:200ms">
        <li>
          <span class="advisor__fact-value tabular" data-countup={site.agent.experienceYears}
                data-suffix="+">{site.agent.experienceYears}+</span>
          <span class="advisor__fact-label">Years in Medicare</span>
        </li>
        {/* Was "18 · States licensed" until 2026-08-16 — pulled for the same reason
            as the trust bar's middle stat: a national number on the page whose whole
            argument is that the advisor is local. See TrustBar.astro. */}
        <li>
          <span class="advisor__fact-value">{site.address.locality}</span>
          <span class="advisor__fact-label">Where I am based, {site.address.region} {site.address.postalCode}</span>
        </li>
        <li>
          <span class="advisor__fact-value tabular">{site.agent.npn}</span>
          <span class="advisor__fact-label">National Producer Number</span>
        </li>
        <li>
          <span class="advisor__fact-value">$0</span>
          <span class="advisor__fact-label">Cost to work with me</span>
        </li>
      </ul>
      </div>
    </div>
  </section>

  <!-- ── Testimonials ─────────────────────────────────────────────────── -->
  {/* Display only. There is no Review or AggregateRating JSON-LD behind these
      and there must not be — see src/data/testimonials.ts. The red rule under
      the heading is the standard <SectionHead> draw-rule. */}
  <section class="section" data-caustics="0.4">
    <div class="wrap">
      <SectionHead
        eyebrow="In their words"
        title="What Brian's Clients Say"
        align="center"
      />
      <Testimonials />
    </div>
  </section>

  <!-- ── Service area ─────────────────────────────────────────────────── -->
  <section class="section band--tint" data-caustics="0.28">
    <div class="wrap area">
      <div class="area__copy">
        <p class="eyebrow" data-rise data-armed>Service area</p>
        <h2><Kinetic text="Local means local." stagger={44} /></h2>
        <p class="lede area__lede" data-rise data-armed style="--rise-delay:180ms">
          The office is in Anthem, 85086; the work runs across the Phoenix metro. Plan availability
          in Medicare is set county by county, and the differences between neighboring ZIPs are
          real — which is the whole argument for using somebody who works this patch.
        </p>
        {/* The canonical nine-community dot list (serviceAreaListText). It used to
            be the hero eyebrow; Brian wanted the hero to name Anthem, Peoria and
            the West Valley instead (2026-09-24), and scripts/audit.mjs still
            requires the nine here on the home page. */}
        <p class="area__serving" data-rise data-armed style="--rise-delay:260ms">{serviceAreaListText}</p>
      </div>
      {/* Ordered outward from the office, not in brand order — see
          serviceAreaRows in src/data/locations.ts. EVERY row is a link now:
          either to the community's own page or to the page whose copy covers
          it. Scottsdale used to render as plain text here, which read as a
          broken row rather than a deliberate one. locations.ts throws at build
          time if a row has nowhere to go, so the plain-text branch is gone. */}
      <ul class="area__list">
        {
          serviceAreaRows.map((r, i) => (
            <li data-rise data-armed style={`--rise-delay:${i * 55}ms`}>
              <a href={r.href} class="area__link">
                <span class="area__city">{r.city}</span>
                <span class="area__zip">{r.zips.join(' · ')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="section" data-caustics="0.3">
    <div class="wrap wrap--narrow">
      <SectionHead
        eyebrow="Common questions"
        title="The things everybody asks first."
      />
      <Faq items={homeFaqs} openFirst />
    </div>
  </section>

  <!-- ── Latest from the blog ────────────────────────────────────────── -->
  {/* The three newest posts, same cards as /blog/ (Brian, 2026-10-24 — "like
      MOM"). Gives the daily autoblogger's new posts a link from the home page
      the day they publish, so Google finds them without waiting on the hub. */}
  {posts.length > 0 && (
    <section class="section band--tint" data-caustics="0.3">
      <div class="wrap">
        <SectionHead
          eyebrow="From the blog"
          title="What's new in Arizona Medicare."
        />
        <ul class="latest">
          {posts.slice(0, 3).map((p, i) => (
            <li data-rise data-armed style={`--rise-delay:${i * 90}ms`}>
              <PostCard post={p} as="h3" />
            </li>
          ))}
        </ul>
        <p class="services__foot" data-rise data-armed>
          <a href="/blog/" class="link">See all blog posts</a>
        </p>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>

<style>
  /* ── hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-deep);
    color: #fff;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5.5rem);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  .hero__video { opacity: 0; transition: opacity 1.2s ease; }
  .hero__video.is-playing { opacity: 1; }
  .hero__pause {
    position: absolute; z-index: 2; left: 18px; bottom: 16px; /* left: the help launcher owns bottom-right */
    display: inline-flex; align-items: center; gap: .4rem;
    background: rgba(1,13,60,.55); color: #fff; border: 1px solid rgba(255,255,255,.35);
    border-radius: 999px; padding: .45rem .9rem; font: 600 .8rem/1 var(--font-body); cursor: pointer;
  }
  .hero__pause[hidden] { display: none; }
  @media (max-width: 959px) { .hero { padding-bottom: clamp(4.5rem, 12vw, 6rem); } }
  /* Navy reading-shade on the left where the copy sits, easing to a 20% wash on
     the right so the sunset and the saguaros come through; a warm glow in the
     upper-right picks up the sky. Contrast on the copy column measured against
     the darkest stop: white on rgba(1,13,60,.93) over the photo ≥ 12:1. */
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 82% at 92% 4%, rgba(255,150,90,.22) 0%, rgba(255,120,70,0) 56%),
      linear-gradient(90deg, rgba(1,13,60,.93) 0%, rgba(1,20,89,.78) 38%, rgba(1,20,89,.26) 66%, rgba(1,20,89,.06) 100%);
  }
  @media (max-width: 959px) {
    .hero__shade {
      background: linear-gradient(180deg, rgba(1,13,60,.82) 0%, rgba(1,20,89,.66) 55%, rgba(1,20,89,.62) 100%);
    }
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }
  .hero .hero__title { color: #fff; }
  .hero .hero__eyebrow { color: var(--red-lift); }
  .hero .hero__lede { color: #DCE2F5; }
  .hero .hero__meta { color: #A9B1C7; border-top-color: rgba(255,255,255,.22); }
  .hero .hero__meta strong { color: #fff; }
  .hero .btn--ghost {
    --btn-fg: #fff;
    border-color: rgba(255,255,255,.55);
  }
  .hero .btn--ghost:hover {
    --btn-fg: var(--navy);
    background: #fff;
    border-color: #fff;
  }

  /* Nine communities now, so this wraps on narrow screens. Align the pin to the
     first line rather than centring it against a multi-line block, and ease the
     tracking back so the list holds two lines at 390px instead of four. */
  .hero__eyebrow {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    max-width: 48ch;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.055em;
    line-height: 1.55;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: var(--s-5);
  }
  .hero__pin {
    margin-top: 0.45em;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
    position: relative;
  }
  .hero__pin::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid currentColor;
    opacity: 0.35;
  }

  .hero__title {
    font-size: var(--t-5xl);
    max-width: 15ch;
    letter-spacing: -0.03em;
  }

  .hero__lede {
    margin-top: var(--s-5);
    font-size: var(--t-lg);
    color: var(--ink-muted);
    max-width: 52ch;
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-7);
  }

  .hero__meta {
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    font-size: var(--t-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .hero__meta strong { color: var(--ink-body); }

  .hero__funnel { min-width: 0; }
  /* Frosted card: the saguaro silhouette and the pink sky show through as soft
     shape and colour, so the photo isn't simply hidden behind a white box. */
  .hero__funnel :global(.funnel) {
    background: rgba(255,255,255,.90);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  /* ── steps ────────────────────────────────────────────────────────── */
  .steps {
    list-style: none;
    padding: 0;
    counter-reset: step;
    display: grid;
    gap: var(--s-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .step {
    position: relative;
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }
  .step__num {
    position: absolute;
    top: var(--s-5);
    right: 0;
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1;
    color: var(--navy);
    opacity: 0.13;
    letter-spacing: -0.03em;
  }
  .step__title { font-size: var(--t-lg); margin-bottom: var(--s-3); max-width: 14ch; }
  .step__body { font-size: var(--t-sm); color: var(--ink-muted); line-height: 1.65; }

  /* ── advisor ──────────────────────────────────────────────────────── */
  .advisor { display: grid; gap: var(--s-8); align-items: start; }
  .advisor__lede { margin-top: var(--s-4); }
  .advisor__body { margin-top: var(--s-5); max-width: 58ch; color: var(--ink-body); }
  .advisor__actions { margin-top: var(--s-6); }
  .advisor__side { display: grid; gap: var(--s-5); }
  .advisor__photo {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    border-bottom: 4px solid var(--red);
    box-shadow: 0 18px 40px -24px rgba(1, 13, 60, 0.55);
  }

  .advisor__facts {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .advisor__facts li {
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    padding: var(--s-5);
    display: grid;
    gap: 0.25rem;
  }
  .advisor__fact-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .advisor__fact-label {
    font-size: var(--t-xs);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  @media (min-width: 900px) {
    .advisor { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--s-9); }
  }

  /* ── area ─────────────────────────────────────────────────────────── */
  .area { display: grid; gap: var(--s-7); align-items: start; }
  .area__lede { margin-top: var(--s-4); }
  .area__serving {
    margin-top: var(--s-5);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.055em;
    line-height: 1.7;
