---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookingPicker from '../components/BookingPicker.astro';
import site, { abs } from '../config/site';

/**
 * The booking page.
 *
 * This is the page src/config/site.ts always anticipated: `consult.url` used to
 * point at /contact/?intent=15-minute-call because no calendar existed. It now
 * points here, so every "Book a free 15-minute call" CTA on the site — the
 * footer, every Learn article, every blog post, every tool page, the hubs —
 * lands on a real calendar with no other edit.
 *
 * WHAT CHANGED 2026-08-08. Until now this page was a facade in front of a
 * cross-origin `<iframe>` of GoGuruX's scheduler. The performance argument for
 * the facade was sound and is preserved in spirit below, but the embed itself
 * was wrong for the audience: its time picker was a scroll list, its date grid
 * did not render usably at 375px, and neither could be reached from here —
 * a cross-origin document cannot be styled, sized or tested by its host.
 *
 * So the calendar is now drawn by src/components/BookingPicker.astro, against
 * the same endpoints the embed itself calls. The iframe survives as a fallback
 * the picker reveals if those endpoints fail. See src/config/booking.ts for the
 * API, and for the warning that it is undocumented.
 *
 * The facade is gone with it, and the performance reason it existed goes too:
 * the picker is this site's own JavaScript, it renders the month grid before
 * any network call returns, and the one request it makes on load is an XHR to
 * an API rather than a competing cross-origin *document*. There is nothing left
 * for the browser to hold the paint for.
 *
 * The CSP hole in public/_headers changed shape to match: `frame-src` stays for
 * the fallback, and `connect-src` now names the same origin the picker fetches
 * from. It is still the only third party this site touches.
 *
 * The page is deliberately light: no caustics, no reveal animations, nothing
 * competing with the calendar. Someone who reached this page has already
 * decided.
 *
 * ONE MORE THING ABOUT THE INLINE SCRIPT BELOW. Its postMessage allowlist used
 * to carry GoGuruX's two `http://127.0.0.1` development origins. They were inert
 * in production — nothing can post from a loopback origin in a visitor's browser
 * unless they are running the app themselves — but CLAUDE.md's leak guard greps
 * the BUILT site for that word, HTML comments included, and they were its only
 * hits. They are gone. Keep the explanation up here in the frontmatter, which
 * Astro strips, rather than in the comment on the script, which ships.
 */

const title = 'Book a Free 15-Minute Medicare Call';
const description = `Pick a time that works — no cost, no obligation. Talk to ${site.agent.name} directly about your Medicare options, or call ${site.phone.display}.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Book a call', path: '/book/' },
];

const schemaNodes = [
  {
    '@type': 'WebPage',
    '@id': `${abs('/book/')}#webpage`,
    url: abs('/book/'),
    name: title,
    description,
    isPartOf: { '@id': `${site.origin}/#website` },
    about: { '@id': `${site.origin}/#organization` },
    potentialAction: {
      '@type': 'ReserveAction',
      name: site.consult.label,
      target: abs('/book/'),
      result: {
        '@type': 'Reservation',
        name: `${site.consult.minutes}-minute Medicare consultation`,
        provider: { '@id': `${site.origin}/#organization` },
      },
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/book/"
  breadcrumbs={breadcrumbs}
  schemaNodes={schemaNodes}
  density="light"
>
  <PageHero
    eyebrow="Book a call"
    title="Pick a time that suits you."
    lede={`No cost, no obligation, and no call center — you get ${site.agent.name} directly. Bring your prescription list and the doctors you want to keep if you have them handy; if not, we will start anyway.`}
    breadcrumbs={breadcrumbs}
  />

  <section class="section section--tight">
    <div class="wrap">
      <BookingPicker />
    </div>
  </section>
</BaseLayout>

<!--
  Booking-confirmation redirect, for the FALLBACK EMBED ONLY.

  The native picker never posts this — it shows its own confirmation panel. But
  if the picker has fallen back to the iframe, the embed still posts a message
  when a booking completes and this hands the visitor onward.

  `is:inline` because it must NOT be bundled — it has to run on this page and
  only this page. The origin allowlist is the security boundary: a `message`
  listener with no origin check will accept a postMessage from ANY frame,
  including a hostile one, and this one ends in `window.location.assign`.

  GoGuruX's own two development origins used to be in this list — see the
  frontmatter note above for why they are gone.

  The URL is re-parsed and its protocol checked before navigating, so a
  `javascript:` payload from a compromised allowed origin still cannot execute.
-->
<script is:inline>
  (function () {
    var MSG = 'ggx-booking-confirmation-redirect';
    var ALLOWED = ['https://my.gogurux.com'];
    window.addEventListener('message', function (event) {
      if (!event.data || event.data.type !== MSG) return;
      if (ALLOWED.indexOf(event.origin) === -1) return;
      var raw = String(event.data.url || '').trim();
      if (!raw) return;
      try {
        var u = new URL(raw);
        if (u.protocol !== 'http:' && u.protocol !== 'https:') return;
        window.location.assign(u.toString());
      } catch (e) {}
    });
  })();
</script>
