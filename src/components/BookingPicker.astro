    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: var(--s-3);
  }

  .bk :global(.bk__slot) {
    position: relative;
    min-height: 3.75rem; /* 60px */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 0.5rem;
    border: 2px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--navy);
    font-family: var(--font-body);
    font-size: 1.25rem; /* 20px */
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: background-color 140ms var(--ease), color 140ms var(--ease),
                border-color 140ms var(--ease);
  }
  .bk :global(.bk__slot:hover) { border-color: var(--navy); background: var(--navy-wash); }
  .bk :global(.bk__slot--on) {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .bk :global(.bk__slot--on:hover) { background: var(--navy); }
  /* The tick occupies its width from the start, so selecting a time changes
     colour only — the grid never reflows under the visitor's finger. */
  .bk :global(.bk__slot-tick) {
    display: inline-grid;
    place-content: center;
    width: 22px;
    opacity: 0;
    transition: opacity 140ms var(--ease);
  }
  .bk :global(.bk__slot--on .bk__slot-tick) { opacity: 1; }

  .bk__note {
    margin-top: var(--s-4);
    font-size: var(--bk-type);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .bk__actions { margin-top: var(--s-5); }
  .bk__actions--split {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .bk__actions--split .btn { flex: 1 1 12rem; }

  /* The site's .btn is 48px tall at --t-sm. On this page every button is a
     booking control, so they all take the 18px floor and a taller box. */
  .bk :global(.btn--lg) {
    min-height: 3.5rem; /* 56px */
    font-size: var(--bk-type);
    padding-inline: var(--s-6);
  }
  .bk__continue { width: 100%; }
  .bk__continue:disabled {
    background: var(--tint-deep);
    color: var(--ink-faint);
    cursor: default;
    box-shadow: none;
  }
  .bk__continue:disabled:hover { background: var(--tint-deep); }

  /* ── the details form ──────────────────────────────────────────────── */
  .bk__form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--s-4);
  }
  .bk__field { display: grid; gap: 0.4rem; }
  .bk__field--full,
  .bk__error,
  .bk__actions,
  .bk__consent { grid-column: 1 / -1; }

  .bk__field label {
    font-size: var(--bk-type);
    font-weight: 600;
    color: var(--ink);
  }
  .bk__opt { font-weight: 400; color: var(--ink-muted); }

  .bk__field input,
  .bk__field textarea {
