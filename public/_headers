# The CSP is `default-src 'self'` plus exactly two holes, both for the scheduler
# on /book/ and both documented in src/config/booking.ts:
#   connect-src  roiypxggqlgbzrspkeoo.supabase.co  — the availability/booking API
#                                                    the native picker calls
#   frame-src    my.gogurux.com                    — the embed, kept only as the
#                                                    fallback when that API fails
# Nothing else third-party loads anywhere on this site: no scripts, no styles,
# no fonts, no images.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://roiypxggqlgbzrspkeoo.supabase.co; form-action 'self'; frame-src https://my.gogurux.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Astro fingerprints these filenames, so they can be cached indefinitely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

# HTML must revalidate — same filename, changing content.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
