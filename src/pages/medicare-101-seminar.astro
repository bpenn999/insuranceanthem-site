---
/**
 * /medicare-101-seminar/ — free IN-PERSON Medicare 101 seminar registration (2026-11-11).
 *
 * Sibling of /medicare-101-webinar/ (online class). Target of the Facebook ad and
 * the taco flyer ("Reserve your seat"). Registrations post to /api/lead (→ GoGuruX)
 * with source "602 Medicare 101 Seminar" and the event + guest count in the note.
 *
 * EVENTS below is the only place dates and venues live. Past events drop off
 * automatically; with none left the form turns into "call or text / book a
 * one-on-one". Times are Arizona (MST, no DST). `landing` = noindex, slim chrome,
 * out of the sitemap, in scripts/audit.mjs STANDALONE_DOCS.
 *
 * COMPLIANCE: this is an EDUCATIONAL event. No plan names, no enrollment, no
 * Scope of Appointment at the event. Food must stay under CMS nominal value
 * per person. No testimonials — only real, attributable reviews.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../config/site';
import { tpmoText, nonAffiliation } from '../data/compliance';

// ISO in Arizona time (UTC-7 year-round). One entry per seminar.
const EVENTS = [
  {
    id: 'anthem-2026-12-08',
    start: '2026-12-08T18:00:00-07:00',
    minutes: 75,
    venue: 'Anthem Civic Building',
    street: '3701 W Anthem Way',
    city: 'Anthem, AZ 85086',
    food: 'Free tacos from The Taco Spot',
  },
];

const title = 'Free Medicare 101 Seminar in Anthem — Free Tacos | 602Medicare';
const description =
  'Turning 65 or retiring? Free in-person Medicare 101 seminar at the Anthem Civic Building with a licensed local agent. Free tacos, no obligation.';

const tel = site.phone.href;
const phone = site.phone.display;
const flyer = '/img/seminar/anthem-taco-seminar-2026-12-08.jpg';

const learn = [
  'The parts of Medicare — A, B, C and D — and how they fit together.',
  'When to sign up so you avoid lifetime late penalties.',
  'The gaps in Original Medicare that surprise most people.',
  'Medicare Supplement vs. Medicare Advantage — how each one works.',
  'How Part D drug coverage and the yearly out-of-pocket cap work.',
  'Still working at 65? Employer coverage, COBRA and HSAs.',
  'Open Q&A — bring every question you have.',
];

const mapUrl = (e: (typeof EVENTS)[number]) =>
  'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`${e.venue}, ${e.street}, ${e.city}`);
---

<BaseLayout {title} {description} path="/medicare-101-seminar/" density="light" image={flyer} landing>
  <header class="lp-head">
    <div class="wrap lp-head__row">
      <a class="lp-brand" href="/" aria-label={`${site.name} home`}>
        <img src="/logo/badge-128.webp" width="52" height="52" alt="" />
        <span class="lp-word"><span class="lp-word__mark">{site.wordmark.mark}</span>{site.wordmark.product}</span>
      </a>
      <a class="lp-head__call" href={tel}>📞 {phone}</a>
    </div>
  </header>

  <section class="wb-hero">
    <div class="wrap wb-hero__grid">
      <div>
        <p class="eyebrow">Free in-person seminar · Anthem · No obligation</p>
        <h1>Medicare 101: <span class="lp-hl">a free, plain-English class — and free tacos.</span></h1>
        <p class="wb-lede">Turning 65 or retiring soon? Spend one relaxed evening learning how Medicare works, when to sign up, and how to avoid the mistakes that cost people money for life. Taught in person by {site.agent.name}, a licensed independent Medicare agent who lives and works in the North Valley.</p>

        <ul class="sm-events" data-event-list>
          {EVENTS.map((e) => (
            <li data-start={e.start} data-id={e.id}>
              <p class="sm-when"><span aria-hidden="true">📅</span> <span data-label>{e.start}</span></p>
              <p class="sm-where"><span aria-hidden="true">📍</span> <strong>{e.venue}</strong><br />{e.street}, {e.city} · <a href={mapUrl(e)} target="_blank" rel="noopener">Map</a></p>
              {e.food && <p class="sm-food"><span aria-hidden="true">🌮</span> {e.food} — no cost, no obligation</p>}
            </li>
          ))}
        </ul>
        <p class="wb-small">Seating is limited. Spouses and friends welcome — just tell us how many are coming.</p>
        <img class="sm-flyer" src="/img/seminar/anthem-taco-seminar-2026-12-08-640.jpg" width="640" height="640" alt="Medicare 101 free seminar flyer: free tacos, Tuesday December 8, 2026 at 6 PM, Anthem Civic Building" loading="lazy" />
      </div>

      <div class="wb-card" id="register">
        <div data-form-wrap>
          <h2>Reserve your seat — it's free</h2>
          <form data-reg novalidate>
            <div class="wb-row">
              <label>First name*<input name="first" autocomplete="given-name" required /></label>
              <label>Last name*<input name="last" autocomplete="family-name" required /></label>
            </div>
            <label>Mobile phone*<input name="phone" type="tel" autocomplete="tel" required /></label>
            <label>Email<input name="email" type="email" autocomplete="email" /></label>
            <label>How many people are coming (including you)?*
              <select name="guests" required>
                <option value="1">Just me</option>
                <option value="2">2 people</option>
                <option value="3">3 people</option>
                <option value="4">4 people</option>
              </select>
            </label>
            <fieldset data-session-set>
              <legend>Which seminar?*</legend>
              <div data-session-radios></div>
            </fieldset>
            <label class="wb-consent">
              <input type="checkbox" name="consent" required />
              <span>I agree that {site.legalName} ({site.parentCompany}) and its licensed agents may contact me at the phone number and email above, including by automated calls and text messages, about this seminar and Medicare insurance products. Consent is not required to attend or to buy anything. Msg &amp; data rates may apply; reply STOP to opt out, HELP for help.</span>
            </label>
            <p class="wb-err" data-err hidden></p>
            <button type="submit" class="wb-btn">Reserve my seat</button>
          </form>
        </div>
        <div data-none hidden>
          <h2>Next seminar coming soon</h2>
          <p>The next date isn't posted yet. Call or text <a href={tel}>{phone}</a> and we'll save you a seat — or <a href="/book/">book a free one-on-one</a> and get your questions answered now.</p>
        </div>
        <div data-done hidden>
          <h2>✅ You're on the list!</h2>
          <p><strong data-done-when></strong><br /><span data-done-where></span></p>
          <p>We'll text you a reminder the day before. Need to change your count or can't make it? Call or text <a href={tel}>{phone}</a>.</p>
          <p><a class="wb-cal" href="#" data-ics download="medicare-101-seminar.ics">➕ Add to my calendar</a></p>
        </div>
        <p class="sm-alt">Can't make it? <a href="/book/">Book a free one-on-one instead →</a></p>
      </div>
    </div>
  </section>

  <section class="lp-sec lp-sec--soft">
    <div class="wrap">
      <h2>What you'll learn</h2>
      <ul class="wb-learn">{learn.map((l) => <li>{l}</li>)}</ul>
      <p class="wb-cta"><a class="wb-btn wb-btn--inline" href="#register">Save my seat</a></p>
    </div>
  </section>

  <section class="lp-sec">
    <div class="wrap lp-narrow">
      <h2>What to expect</h2>
      <ul class="wb-learn sm-expect">
        <li>About an hour of teaching, then open questions.</li>
        <li>No sales pitch and no plan enrollment at the seminar.</li>
        <li>Nothing to bring — no Medicare card or personal information needed.</li>
        <li>Want help with your own situation later? Ask for a free one-on-one.</li>
      </ul>
    </div>
  </section>

  <section class="lp-sec lp-sec--soft">
    <div class="wrap lp-narrow wb-host">
      <div class="wb-host__photo"><img src="/img/brian-penner-az-640.webp" alt={`${site.agent.name}, ${site.agent.title}`} width="640" height="800" loading="lazy" /></div>
      <div>
        <p class="lp-card__tag">Your teacher</p>
        <h2>{site.agent.name}</h2>
        <p>{site.agent.title} · NPN {site.agent.npn}. Brian has spent {site.agent.experience.toLowerCase()} helping people make sense of Medicare. He's independent, so he isn't selling one company's plans — this seminar is about understanding the what, the when and the how so you can decide for yourself.</p>
        <p><a class="wb-btn wb-btn--inline" href="#register">Reserve my seat</a></p>
      </div>
    </div>
  </section>

  <footer class="lp-foot">
    <div class="wrap">
      <p>This is an educational event. No plans will be sold or enrolled, no Medicare or personal health information is collected at the seminar, and there is no obligation to buy anything. Food is provided free of charge to all attendees. For accommodation of persons with special needs, call or text {phone}. {tpmoText()} {nonAffiliation} {site.agent.name} · NPN {site.agent.npn} · licensed independent insurance agent. Not affiliated with or endorsed by Facebook or any social media platform.</p>
      <p>© {new Date().getFullYear()} {site.legalName}, a DBA of {site.parentCompany} · {site.address.display} · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="lp-foot__links"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/">602medicare.com</a></p>
    </div>
  </footer>

  <script is:inline define:vars={{ EVENTS, PHONE: phone, TEL: tel }}>
    (function () {
      var fmt = function (iso) {
        return new Date(iso).toLocaleString('en-US', { timeZone: 'America/Phoenix', weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' });
      };
      var where = function (e) { return e.venue + ', ' + e.street + ', ' + e.city; };
      var now = Date.now();
      var live = EVENTS.filter(function (e) { return new Date(e.start).getTime() + e.minutes * 60000 > now; });
      document.querySelectorAll('[data-event-list] li').forEach(function (li) {
        var ev = EVENTS.filter(function (e) { return e.id === li.dataset.id; })[0];
        if (!ev || new Date(ev.start).getTime() + ev.minutes * 60000 <= now) { li.remove(); return; }
        li.querySelector('[data-label]').textContent = fmt(li.dataset.start);
      });
      var form = document.querySelector('[data-reg]');
      if (!live.length) {
        document.querySelector('[data-form-wrap]').hidden = true;
        document.querySelector('[data-none]').hidden = false;
        return;
      }
      var radios = document.querySelector('[data-session-radios]');
      live.forEach(function (e) {
        var l = document.createElement('label'); l.className = 'wb-radio';
        var r = document.createElement('input'); r.type = 'radio'; r.name = 'session'; r.value = e.id; r.required = true;
        if (live.length === 1) r.checked = true;
        l.appendChild(r); l.appendChild(document.createTextNode(' ' + fmt(e.start) + ' — ' + e.venue));
        radios.appendChild(l);
      });
      if (live.length === 1) document.querySelector('[data-session-set]').hidden = true;
      var err = form.querySelector('[data-err]');
      function ics(e) {
        var d = function (t) { return new Date(t).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, ''); };
        var end = new Date(new Date(e.start).getTime() + e.minutes * 60000);
        var esc = function (s) { return s.replace(/[,;]/g, function (c) { return '\\' + c; }); };
        return 'data:text/calendar;charset=utf-8,' + encodeURIComponent([
          'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//602Medicare//Seminar//EN', 'BEGIN:VEVENT',
          'UID:' + e.id + '@602medicare.com', 'DTSTAMP:' + d(new Date()),
          'DTSTART:' + d(e.start), 'DTEND:' + d(end),
          'SUMMARY:Medicare 101 free seminar (602Medicare)',
          'LOCATION:' + esc(where(e)),
          'DESCRIPTION:Free Medicare 101 seminar. Questions or changes: ' + PHONE + '.',
          'END:VEVENT', 'END:VCALENDAR'].join('\r\n'));
      }
      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var f = Object.fromEntries(new FormData(form));
        var badEmail = f.email && !/^\S+@\S+\.\S+$/.test(f.email);
        if (!f.first || !f.last || (f.phone || '').replace(/\D/g, '').length < 10 || badEmail) {
          err.textContent = 'Please fill in your name and a 10-digit phone number' + (badEmail ? ', and check your email address.' : '.');
          err.hidden = false; return;
        }
        if (!f.session) { err.textContent = 'Please choose a seminar.'; err.hidden = false; return; }
        if (!f.consent) { err.textContent = 'Please check the box so we can send you a reminder.'; err.hidden = false; return; }
        err.hidden = true;
        var e = live.filter(function (x) { return x.id === f.session; })[0];
        var when = fmt(e.start);
        var btn = form.querySelector('button'); btn.disabled = true; btn.textContent = 'Saving your seat…';
        fetch('/api/lead', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            first: f.first, last: f.last, email: f.email || '', phone: f.phone, zip: '',
            source: '602 Medicare 101 Seminar', situation: 'turning-65', consent: 'on',
            message: 'Registered for Medicare 101 SEMINAR (in person): ' + when + ' at ' + where(e) + ' — party of ' + (f.guests || '1') + ' [' + e.id + ']',
            page: location.pathname,
          }),
        }).then(function (r) {
          if (!r.ok) throw new Error('relay ' + r.status);
          document.querySelector('[data-form-wrap]').hidden = true;
          var done = document.querySelector('[data-done]'); done.hidden = false;
          done.querySelector('[data-done-when]').textContent = when;
          done.querySelector('[data-done-where]').textContent = where(e);
          done.querySelector('[data-ics]').href = ics(e);
          window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: 'seminar_registered' });
          done.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }).catch(function () {
          btn.disabled = false; btn.textContent = 'Reserve my seat';
          err.innerHTML = 'Something went wrong saving your seat. Please call or text <a href="' + TEL + '">' + PHONE + '</a> and we’ll save it for you.';
          err.hidden = false;
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .lp-head { background: #fff; border-bottom: 1px solid var(--rule); }
  .lp-head__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.6rem; }
  .lp-brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .lp-brand img { width: 52px; height: 52px; display: block; }
  .lp-word { font-family: var(--font-display, inherit); font-weight: 800; font-size: 1.45rem; color: var(--navy); letter-spacing: -0.01em; }
  .lp-word__mark { color: var(--red); }
  .lp-head__call { font-weight: 800; font-size: 1.05rem; white-space: nowrap; color: var(--navy); text-decoration: none; }
  .lp-hl { color: var(--red); }
  .wb-hero { padding: clamp(2rem, 5vw, 4rem) 0; background: var(--navy-wash); }
  .wb-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: 2.5rem; align-items: start; }
  .wb-hero h1 { font-size: clamp(1.9rem, 4.4vw, 3rem); margin: 0.3em 0 0.5em; color: var(--ink); }
  .wb-lede { font-size: clamp(1.05rem, 1.3vw, 1.2rem); max-width: 58ch; color: var(--ink-body); margin: 0 0 1.2rem; }
  .sm-events { list-style: none; padding: 0; margin: 0 0 0.6rem; display: grid; gap: 0.9rem; }
  .sm-events li { background: #fff; border: 1px solid var(--rule); border-left: 5px solid var(--red); border-radius: 10px; padding: 0.9rem 1rem; }
  .sm-events p { margin: 0; }
  .sm-when { font-weight: 800; font-size: 1.2rem; color: var(--navy); }
  .sm-where { margin-top: 0.35rem !important; font-size: 1.05rem; color: var(--ink-body); }
  .sm-where a { font-weight: 700; color: var(--navy); }
  .sm-food { margin-top: 0.35rem !important; font-weight: 700; color: var(--ink); }
  .sm-flyer { display: block; width: 100%; max-width: 420px; height: auto; margin-top: 1.2rem; border-radius: 12px; box-shadow: 0 10px 30px rgba(1, 20, 89, 0.12); }
  .sm-alt { margin: 1rem 0 0; text-align: center; font-weight: 700; }
  .sm-alt a { color: var(--navy); }
  .wb-small { font-size: 0.95rem; color: var(--ink-muted); margin: 0; }
  .wb-card { background: #fff; border: 1px solid var(--rule); border-top: 6px solid var(--red); border-radius: 14px; padding: 1.4rem; box-shadow: 0 10px 30px rgba(1, 20, 89, 0.08); }
  .wb-card h2 { font-size: 1.5rem; margin: 0 0 0.9rem; color: var(--ink); }
  .wb-card form { display: grid; gap: 0.75rem; }
  .wb-card label { display: grid; gap: 0.25rem; font-weight: 700; font-size: 0.95rem; color: var(--ink); }
  .wb-card input:not([type=checkbox]):not([type=radio]), .wb-card select { min-height: 48px; padding: 0 0.8rem; border: 1px solid #b9c0d4; border-radius: 8px; font: inherit; font-size: 1.05rem; width: 100%; box-sizing: border-box; background: #fff; }
  .wb-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .wb-card fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
  .wb-card fieldset[hidden] { display: none; }
  .wb-card legend { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.4rem; color: var(--ink); }
  :global(.wb-radio) { display: flex !important; align-items: center; gap: 0.6rem; min-height: 48px; padding: 0 0.8rem; border: 1px solid #b9c0d4; border-radius: 8px; font-weight: 600 !important; cursor: pointer; }
  :global(.wb-radio:has(input:checked)) { border-color: var(--navy); background: var(--navy-wash); }
  :global(.wb-radio input) { width: 20px; height: 20px; accent-color: var(--red); }
  .wb-consent { display: flex !important; gap: 0.6rem; align-items: flex-start; font-weight: 400 !important; font-size: 0.78rem !important; line-height: 1.45; color: var(--ink-muted) !important; }
  .wb-consent input { width: 20px; height: 20px; flex-shrink: 0; margin-top: 2px; accent-color: var(--red); }
  .wb-err { margin: 0; color: var(--red-deep); font-weight: 700; font-size: 0.95rem; }
  .wb-btn, .wb-btn:visited { display: inline-flex; align-items: center; justify-content: center; min-height: 56px; padding: 0 1.4rem; border: 0; border-radius: 10px; background: var(--red); color: #fff; font: inherit; font-weight: 800; font-size: 1.2rem; text-decoration: none; cursor: pointer; width: 100%; }
  .wb-btn:hover { background: var(--red-deep); }
  .wb-btn[disabled] { opacity: 0.7; cursor: wait; }
  .wb-btn--inline { width: auto; }
  .wb-cal { font-weight: 700; color: var(--navy); }
  .lp-sec { padding: clamp(2rem, 5vw, 3.5rem) 0; background: #fff; }
  .lp-sec--soft { background: var(--navy-wash); }
  .lp-sec h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin: 0 0 0.8em; color: var(--ink); }
  .lp-narrow { max-width: 860px; }
  .lp-card__tag { margin: 0 0 0.3rem; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--red); }
  .wb-learn { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem 2rem; font-size: 1.08rem; color: var(--ink-body); }
  .wb-learn li::before { content: '✓'; color: var(--red); font-weight: 800; margin-right: 0.55rem; }
  .sm-expect { grid-template-columns: 1fr; }
  .wb-cta { margin: 1.6rem 0 0; }
  .wb-host { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 2rem; align-items: center; }
  .wb-host__photo { width: 160px; height: 160px; border-radius: 50%; overflow: hidden; position: relative; }
  .wb-host__photo img { position: absolute; width: 153.8%; height: auto; max-width: none; left: -36.5%; top: -1.9%; }
  .wb-host p { font-size: 1.05rem; color: var(--ink-body); }
  .lp-foot { padding: 2rem 0 3rem; border-top: 1px solid var(--rule); font-size: 0.85rem; color: var(--ink-muted); line-height: 1.6; background: #fff; }
  .lp-foot a { color: inherit; }
  @media (max-width: 820px) {
    .wb-hero__grid, .wb-learn, .wb-host { grid-template-columns: 1fr; }
    .wb-host__photo { width: 120px; height: 120px; }
    .lp-word { font-size: 1.2rem; }
    .lp-brand img { width: 42px; height: 42px; }
    .lp-head__call { font-size: 0.95rem; }
    .sm-flyer { max-width: 100%; }
  }
  @media (max-width: 420px) { .wb-row { grid-template-columns: 1fr; } }
</style>
