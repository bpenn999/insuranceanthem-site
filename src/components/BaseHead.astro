---
import site, { abs } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/medicare-advantage/" — canonical is derived */
  path?: string;
  /** Override the OG image path */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: string;
  modifiedAt?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/og.png',
  type = 'website',
  noindex = false,
  publishedAt,
  modifiedAt,
} = Astro.props;

const canonical = abs(path);
const ogImage = abs(image);
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Local signals -->
<meta name="geo.region" content="US-AZ" />
<meta name="geo.placename" content={`${site.address.locality}, ${site.address.regionName}`} />
<meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
<meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />
<meta name="author" content={site.agent.name} />
<meta name="theme-color" content="#FBF9F6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0F3A5C" media="(prefers-color-scheme: dark)" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Fonts: Fraunces (display) + Inter (body), both variable, latin subset -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Inter:wght@400;500;600&display=swap"
/>
<!--
  Loaded as `media="print"` so it never blocks first paint, then promoted to
  `all` on load. The promotion lives in a script rather than an inline `onload`
  attribute so the Content-Security-Policy in public/_headers does not need to
  permit inline event handlers.
-->
<link
  rel="stylesheet"
  id="ia-fonts"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Inter:wght@400;500;600&display=swap"
  media="print"
/>
<script is:inline>
  (function () {
    var l = document.getElementById('ia-fonts');
    if (!l) return;
    var promote = function () { l.media = 'all'; };
    if (l.sheet) promote();
    else l.addEventListener('load', promote, { once: true });
  })();
</script>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Inter:wght@400;500;600&display=swap"
  />
</noscript>

<!--
  Decide the motion mode BEFORE first paint. Adding `.motion` here is what lets
  the CSS hold armed elements hidden — without it (JS off, or reduced-motion)
  every animated element simply renders in its final visible state.
-->
<script is:inline>
  (function () {
    try {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    } catch (e) {
      /* no matchMedia → no motion class → everything visible. Fine. */
    }
  })();
</script>
