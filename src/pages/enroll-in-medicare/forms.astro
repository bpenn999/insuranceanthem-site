---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import site, { abs } from '../../config/site';

/**
 * Fill CMS-40B + CMS-L564 on the visitor's own device (Brian, 2026-11-07:
 * "have them fill it on their device").
 *
 * ⚠️ PRIVACY IS THE DESIGN. The SSN and Medicare number are typed into this page
 * and written into the PDFs by pdf-lib IN THE BROWSER. Nothing is posted,
 * stored, logged or sent anywhere — no fetch except loading the two blank PDFs
 * from /forms/. Do not add analytics events with field values, do not post this
 * form to /api/lead, and do not add a "send to Brian" button without a secure
 * upload behind it.
 *
 * Field names were read from the 07/2025 CMS-40B and 03/2025 CMS-L564 with
 * pypdf on 2026-11-07. If CMS revises a form, re-check the names (a missing
 * field throws and the page shows the error rather than a half-filled form).
 */

const PATH = '/enroll-in-medicare/forms/';
const title = 'Fill Out Medicare Forms CMS-40B and CMS-L564 Online';
const description = 'Fill out CMS-40B and CMS-L564 on your own device, then download them ready to sign. Your SSN and Medicare number never leave it. Free help: ' + site.phone.display + '.';
const published = '2026-11-07';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'How to Enroll in Medicare', path: '/enroll-in-medicare/' },
  { name: 'Fill out your forms', path: PATH },
];
const BOOK = `${site.consult.url}?topic=t65`;
const schemaNodes = [
  {
    '@type': 'WebPage',
    '@id': `${abs(PATH)}#webpage`,
    url: abs(PATH),
    name: title,
    description,
    isPartOf: { '@id': `${site.origin}/#website` },
    inLanguage: 'en-US',
    datePublished: published,
    dateModified: published,
    publisher: { '@id': `${site.origin}/#organization` },
  },
];
---
<BaseLayout title={title} description={description} path={PATH} breadcrumbs={breadcrumbs}
  schemaNodes={schemaNodes} publishedAt={published} modifiedAt={published}>
  <PageHero
    eyebrow="Leaving employer coverage"
    title="Fill out your Part B forms"
    lede="Answer a few questions and we’ll fill in forms CMS-40B and CMS-L564 for you. Then download them, sign, and send them to Social Security."
    breadcrumbs={breadcrumbs}
  >
    <div class="fx__choose">
      <p class="fx__choose-h">Rather have us do it?</p>
      <p class="fx__choose-p">Send your answers to 602Medicare and we’ll fill out both forms for you, then call to go over them before you sign.</p>
      <a class="btn" href="https://my.gogurux.com/f/ypfeoie6fdppazyn6j7g/part-b-forms" target="_blank" rel="noopener">Have us fill them out for me ↗</a>
    </div>
    <p class="fx__private"><span aria-hidden="true">🔒</span> <strong>Or do it yourself below, privately:</strong> your Social Security number, Medicare number and job details stay on this device. We only get your name and how to reach you, so we can help if you get stuck.</p>
  </PageHero>

  <section class="section" data-caustics="0.2">
    <div class="wrap fx">
      <form id="fx" class="fx__form" autocomplete="on" novalidate>
        <fieldset>
          <legend><span class="fx__n">1</span> About you</legend>
          <div class="fx__grid fx__grid--name">
            <label>First name<input name="first" required autocomplete="given-name" /></label>
            <label>Middle<input name="middle" autocomplete="additional-name" /></label>
            <label>Last name<input name="last" required autocomplete="family-name" /></label>
            <label>Suffix<input name="suffix" placeholder="Jr., Sr." autocomplete="honorific-suffix" /></label>
          </div>
          <div class="fx__radio" role="radiogroup">
            <span>Do you already have Medicare Part A? <span class="fx__hint">Most people do: it usually starts on its own at 65 if you get Social Security, or you signed up for it.</span></span>
            <label><input type="radio" name="hasA" value="yes" checked /> Yes</label>
            <label><input type="radio" name="hasA" value="no" /> No, not yet</label>
            <label><input type="radio" name="hasA" value="unsure" /> Not sure</label>
          </div>
          <label class="fx__mbi">Medicare number <span class="fx__hint">On your red, white and blue card. Not handy? Leave it blank and we’ll fill it in with you.</span>
            <input name="mbi" maxlength="20" placeholder="1EG4-TE5-MK72" autocomplete="off" spellcheck="false" style="text-transform:uppercase" /></label>
          <label>Mailing address<input name="street" required autocomplete="address-line1" /></label>
          <div class="fx__grid fx__grid--city">
            <label>City<input name="city" required autocomplete="address-level2" /></label>
            <label>State<input name="state" required maxlength="2" value="AZ" autocomplete="address-level1" style="text-transform:uppercase" /></label>
            <label>ZIP<input name="zip" required inputmode="numeric" maxlength="5" autocomplete="postal-code" /></label>
          </div>
          <div class="fx__grid fx__grid--2">
            <label>Phone<input name="phone" required inputmode="tel" autocomplete="tel" placeholder="10-digit number" /></label>
            <label>Email <span class="fx__hint">optional</span><input name="email" type="email" autocomplete="email" /></label>
          </div>
          <label>Social Security number <span class="fx__hint">Goes on form CMS-L564 only. It never leaves this device.</span>
            <input name="ssn" required inputmode="numeric" maxlength="11" placeholder="123-45-6789" autocomplete="off" /></label>
        </fieldset>

        <fieldset>
          <legend><span class="fx__n">2</span> The job with the health coverage</legend>
          <div class="fx__radio" role="radiogroup">
            <span>Whose job was it?</span>
            <label><input type="radio" name="whose" value="me" checked /> Mine</label>
            <label><input type="radio" name="whose" value="spouse" /> My spouse’s</label>
          </div>
          <div class="fx__spouse" hidden>
            <div class="fx__grid fx__grid--2">
              <label>Spouse’s full name<input name="empName" /></label>
              <label>Spouse’s Social Security number<input name="empSsn" inputmode="numeric" maxlength="11" autocomplete="off" /></label>
            </div>
          </div>
          <label>Employer’s name<input name="employer" required autocomplete="organization" /></label>
          <label>Employer’s address<input name="eStreet" required /></label>
          <div class="fx__grid fx__grid--city">
            <label>City<input name="eCity" required /></label>
            <label>State<input name="eState" required maxlength="2" value="AZ" style="text-transform:uppercase" /></label>
            <label>ZIP<input name="eZip" required inputmode="numeric" maxlength="5" /></label>
          </div>
          <div class="fx__grid fx__grid--2">
            <label>Job started <span class="fx__hint">month/year</span><input name="jobStart" required placeholder="03/2010" maxlength="20" /></label>
            <label>Job ended <span class="fx__hint">leave blank if still working</span><input name="jobEnd" placeholder="12/2026" maxlength="20" /></label>
          </div>
          <div class="fx__grid fx__grid--2">
            <label>Health coverage started<input name="covStart" required placeholder="03/2010" maxlength="20" /></label>
            <label>Health coverage ends/ended <span class="fx__hint">blank if you don’t know yet</span><input name="covEnd" placeholder="12/2026" maxlength="20" /></label>
          </div>
          <div class="fx__radio fx__radio--stack" role="radiogroup">
            <span>Is that health coverage from a job you (or your spouse) still have?</span>
            <label><input type="radio" name="basis" value="current" checked /> Yes, from current work (or it ended within the last 8 months)</label>
            <label><input type="radio" name="basis" value="cobra" /> No, it’s COBRA or retiree coverage</label>
          </div>
          <div class="fx__radio" role="radiogroup">
            <span>Has an employer or insurer required you to sign up for Part B?</span>
            <label><input type="radio" name="required" value="no" checked /> No</label>
            <label><input type="radio" name="required" value="yes" /> Yes</label>
          </div>
          <label class="fx__why" hidden>Explain how and why <span class="fx__hint">attach proof when you send the form</span><textarea name="requiredWhy" rows="2"></textarea></label>
        </fieldset>

        <fieldset class="fx__startset">
          <legend><span class="fx__n">3</span> When should Part B start?</legend>
          <p class="fx__p">If you’re still on the employer plan (or in the first full month off it), you can pick your start date. Most people want it to start the 1st of the month after their employer coverage ends, so there’s no gap.</p>
          <div class="fx__radio fx__radio--stack" role="radiogroup">
            <label><input type="radio" name="start" value="after" checked /> <span><strong>The 1st of the month after my employer coverage ends</strong> (most people)</span></label>
            <label><input type="radio" name="start" value="now" /> The 1st of the month I send this in</label>
            <label><input type="radio" name="start" value="later" /> A later month (up to 3 months after I sign up):
              <input name="startMonth" class="fx__inline" placeholder="01/2027" maxlength="20" /></label>
            <label><input type="radio" name="start" value="none" /> Not sure. Leave it blank and I’ll ask</label>
          </div>
        </fieldset>

        <p class="fx__err" role="alert" hidden></p>
        <button type="submit" class="btn btn--lg">Fill out my forms</button>
        <p class="fx__tcpa">By clicking, you agree 602Medicare may call, text or email you about your Medicare enrollment. Not required to buy anything. Msg &amp; data rates may apply; reply STOP to opt out.</p>
      </form>

      <aside class="fx__out" id="fx-out" hidden tabindex="-1">
        <h2>Your forms are ready</h2>
        <div class="fx__dl">
          <a class="btn btn--lg" id="dl-40b" download="CMS-40B-filled.pdf">Download CMS-40B</a>
          <a class="btn btn--lg btn--ghost" id="dl-l564" download="CMS-L564-filled.pdf">Download CMS-L564</a>
        </div>
        <p class="fx__noa fx__warn" id="fx-cobra" hidden><strong>Heads up: COBRA and retiree coverage don’t count as coverage from current work.</strong> Your Special Enrollment Period is based on when the job (not the COBRA) ended, and it lasts 8 months. If that window has passed, a late penalty can apply. Please call us before you send anything so we can check your dates.</p>
        <p class="fx__noa" id="fx-nostart" hidden><strong>We left your Part B start month blank</strong> because you didn’t enter when your employer coverage ends. Once you know, write it in on the CMS-40B (question 4), or book your free call and we’ll fill it in with you.</p>
        <div class="fx__noa" id="fx-noa" hidden>
          <p><strong>You don’t have Part A yet, so you don’t need form CMS-40B.</strong> You’ll apply for Part A and Part B together online, the same application people turning 65 use.</p>
          <ol>
            <li><strong>Give CMS-L564 to your employer’s HR or benefits office</strong> to fill out Section B and sign. (A signed letter or email from HR with the same dates also works.)</li>
            <li><strong>Apply for Part A and Part B online</strong> at Social Security. Don’t use the “Part B only” page; it needs a Medicare number.</li>
            <li><strong>Upload your signed L564</strong> when the online application asks for proof of your employer coverage. (You can also fax, mail or take it to your local office.)
              <div class="fx__links">
                <a class="link" href="https://www.ssa.gov/medicare/sign-up" target="_blank" rel="noopener">Apply for Part A &amp; B online ↗</a>
                <a class="link" href="https://www.ssa.gov/locator" target="_blank" rel="noopener">Find your local office ↗</a>
              </div>
            </li>
          </ol>
        </div>
        <ol class="fx__next" id="fx-next">
          <li><strong>Give CMS-L564 to your employer’s HR or benefits office</strong> to fill out Section B and sign. (A signed letter or email from HR with the same dates also works.)</li>
          <li><strong>Easiest: apply for Part B online</strong> with your Medicare number and upload the signed L564. Online, you don’t need the CMS-40B.</li>
          <li><strong>Prefer paper?</strong> Sign and date CMS-40B (page 3), then fax, mail or take both forms to your local Social Security office.
            <div class="fx__links">
              <a class="link" href="https://www.ssa.gov/medicare/sign-up/part-b-only" target="_blank" rel="noopener">Apply for Part B online ↗</a>
              <a class="link" href="https://www.ssa.gov/locator" target="_blank" rel="noopener">Find your local office ↗</a>
            </div>
          </li>
        </ol>
        <div class="fx__check">
          <p><strong>Want us to check them before you send them?</strong> One mistake can delay your Part B. Book a free call and we’ll go over both forms with you, then help you pick your coverage.</p>
          <a class="btn" href={BOOK}>Book my free enrollment call</a>
          <p class="fx__or">or call <a class="link" href={site.phone.href}>{site.phone.display}</a></p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { PDFDocument, PDFName } from 'pdf-lib';

  const form = document.getElementById('fx') as HTMLFormElement;
  const out = document.getElementById('fx-out') as HTMLElement;
  const err = form.querySelector('.fx__err') as HTMLElement;
  const spouse = form.querySelector('.fx__spouse') as HTMLElement;
  const why = form.querySelector('.fx__why') as HTMLElement;
  let urls: string[] = [];

  const mbiBox = form.querySelector('.fx__mbi') as HTMLElement;
  const startSet = form.querySelector('.fx__startset') as HTMLElement;
  form.addEventListener('change', () => {
    const d = new FormData(form);
    const hasA = d.get('hasA');
    const noA = hasA === 'no' || (hasA === 'unsure' && !String(d.get('mbi') || '').trim());
    mbiBox.hidden = hasA === 'no'; startSet.hidden = noA;
    spouse.hidden = d.get('whose') !== 'spouse';
    why.hidden = d.get('required') !== 'yes';
  });

  const digits = (v: string) => v.replace(/\D/g, '');
  const MON = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
  const my = (v: string, label: string) => {
    const x = v.trim().toLowerCase(); let m: RegExpMatchArray | null;
    let r: string[] | null = null;
    if ((m = x.match(/^(\d{1,2})\s*[\/\-.]\s*(?:\d{1,2}\s*[\/\-.]\s*)?(\d{4})$/))) r = +m[1] >= 1 && +m[1] <= 12 ? [m[1].padStart(2, '0'), m[2]] : null;
    else if ((m = x.match(/^(\d{4})\s*[\/\-.]\s*(\d{1,2})(?:\s*[\/\-.]\s*\d{1,2})?$/))) r = +m[2] >= 1 && +m[2] <= 12 ? [m[2].padStart(2, '0'), m[1]] : null;
    else if ((m = x.match(/^([a-z]{3})[a-z]*\.?\s*(?:\d{1,2},?\s*)?(\d{4})$/)) && MON.includes(m[1])) r = [String(MON.indexOf(m[1]) + 1).padStart(2, '0'), m[2]];
    if (!r) throw new Error(`${label}: enter a date like 03/2010 or 03/01/2010.`);
    return r;
  };


  async function load(path: string) {
    const doc = await PDFDocument.load(await (await fetch(path)).arrayBuffer());
    const af = doc.catalog.get(PDFName.of('AcroForm'));
    const afd = af ? (doc.context.lookup(af) as any) : null;
    if (afd?.delete) afd.delete(PDFName.of('XFA'));
    return doc;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    try {
      const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const need = ['first', 'last', 'street', 'city', 'state', 'zip', 'phone', 'ssn', 'employer', 'eStreet', 'eCity', 'eState', 'eZip', 'jobStart', 'covStart'];
      const missing = need.filter((k) => !String(d[k] || '').trim());
      if (missing.length) throw new Error('Please fill in every field that isn’t marked optional.');
      const mbi = d.hasA === 'no' ? '' : d.mbi.toUpperCase().replace(/[^A-Z0-9]/g, '');
      const noA = d.hasA === 'no' || (d.hasA === 'unsure' && mbi.length === 0);
      if (mbi.length && mbi.length !== 11) throw new Error('Your Medicare number should be 11 letters and numbers. Not handy? Leave it blank.');
      const ssn = digits(d.ssn);
      if (ssn.length !== 9) throw new Error('Your Social Security number should be 9 digits.');
      const ph = digits(d.phone).replace(/^1(?=\d{10}$)/, '');
      if (ph.length !== 10) throw new Error('Please enter a 10-digit phone number.');
      const js = my(d.jobStart, 'Job started');
      const cs = my(d.covStart, 'Health coverage started');
      const je = d.jobEnd.trim() ? my(d.jobEnd, 'Job ended') : null;
      const ce = d.covEnd.trim() ? my(d.covEnd, 'Health coverage ended') : null;
      const sm = d.start === 'later' ? my(d.startMonth || '', 'Part B start month') : null;
      const name = [d.first, d.middle, d.last, d.suffix].map((s) => (s || '').trim()).filter(Boolean).join(' ');

      // ── CMS-40B (only with Part A) ──
      const b = noA ? null : await load('/forms/cms-40b.pdf');
      const f = (b ?? (await load('/forms/cms-40b.pdf'))).getForm();
      const t = (k: string, v: string) => f.getTextField(k).setText(v);
      const c = (k: string) => f.getCheckBox(k).check();
      t('1-1-1', mbi.slice(0, 4)); t('1-1-2', mbi.slice(4, 7)); t('1-1-3', mbi.slice(7));
      t('1-2', name);
      t('1-3-1', d.street.trim()); t('1-3-2', d.city.trim()); t('1-3-3', d.state.trim().toUpperCase().slice(0, 2)); t('1-3-4', digits(d.zip).slice(0, 5));
      t('1-4-1', ph.slice(0, 3)); t('1-4-2', ph.slice(3, 6)); t('1-4-3', ph.slice(6));
      if (d.email?.trim()) t('1-5', d.email.trim());
      c('CheckBox1-2-1-1'); // employer coverage since 65: yes
      c('CheckBox1-2-2-2'); // international volunteer: no
      t('1-2-3-1', js[0]); t('1-2-3-2', js[1]);
      if (je) { t('1-2-3-3', je[0]); t('1-2-3-4', je[1]); } else c('CheckBox1-2-3-5');
      t('1-2-3-11', cs[0]); t('1-2-3-12', cs[1]);
      if (ce) { t('1-2-3-13', ce[0]); t('1-2-3-14', ce[1]); } else c('CheckBox1-2-3-15');
      if (d.required === 'yes') { c('CheckBox1-2-4-1'); if (d.requiredWhy?.trim()) t('1-2-4-3', d.requiredWhy.trim()); } else c('CheckBox1-2-4-2');
      if (d.start === 'now') c('CheckBox1-2-4-4');
      if (sm) { c('CheckBox1-2-4-5'); t('1-2-4-6', sm[0]); t('1-2-4-7', sm[1]); }
      if (d.start === 'after') {
        if (ce) {
        let mm = +ce[0] + 1, yy = +ce[1]; if (mm > 12) { mm = 1; yy++; }
        const now = new Date(); const cur = now.getFullYear() * 12 + now.getMonth(); const tgt = yy * 12 + (mm - 1);
        if (tgt <= cur) c('CheckBox1-2-4-4'); else { c('CheckBox1-2-4-5'); t('1-2-4-6', String(mm).padStart(2, '0')); t('1-2-4-7', String(yy)); }
      }
      }

      // ── CMS-L564 Section A ──
      const l = await load('/forms/cms-l564.pdf');
      const g = l.getForm();
      const u = (k: string, v: string) => g.getTextField(k).setText(v);
      u('1-1', name);
      u('1-2-1', ssn.slice(0, 3)); u('1-2-2', ssn.slice(3, 5)); u('1-2-3', ssn.slice(5));
      if (d.whose === 'spouse') {
        if (d.empName?.trim()) u('1-3', d.empName.trim());
        const es = digits(d.empSsn || '');
        if (es.length === 9) { u('1-4-1', es.slice(0, 3)); u('1-4-2', es.slice(3, 5)); u('1-4-3', es.slice(5)); }
      }
      u('1-5', d.employer.trim()); u('1-6', d.eStreet.trim()); u('1-7', d.eCity.trim());
      u('1-8', d.eState.trim().toUpperCase().slice(0, 2)); u('1-9', digits(d.eZip).slice(0, 5));

      urls.forEach((x) => URL.revokeObjectURL(x));
      const mk = async (doc: PDFDocument) => URL.createObjectURL(new Blob([(await doc.save()) as BlobPart], { type: 'application/pdf' }));
      urls = [noA ? '' : await mk(b!), await mk(l)];
      const a40 = document.getElementById('dl-40b') as HTMLAnchorElement;
      a40.hidden = noA; if (!noA) a40.href = urls[0];
      (document.getElementById('fx-cobra') as HTMLElement).hidden = d.basis !== 'cobra';
      (document.getElementById('dl-l564') as HTMLAnchorElement).href = urls[1];
      (document.getElementById('fx-noa') as HTMLElement).hidden = !noA;
      (document.getElementById('fx-nostart') as HTMLElement).hidden = noA || !(d.start === 'after' && !ce);
      (document.getElementById('fx-next') as HTMLElement).hidden = noA;
      out.hidden = false;
      // Lead to X: name + contact ONLY. Never SSN, MBI, employer or dates (Brian 11/8: "it didn't create a contact in X").
      const startLbl: Record<string, string> = { after: 'month after employer coverage ends', now: 'month they send it in', later: 'a later month', none: 'not sure' };
      fetch('/api/lead', { method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        first: d.first.trim(), last: d.last.trim(), phone: d.phone.trim(), email: (d.email || '').trim(), zip: digits(d.zip).slice(0, 5),
        source: '602medicare.com Part B forms (did it themselves)', situation: 'retiring', consent: 'yes',
        message: `Filled out their own Part B forms on 602medicare.com/enroll-in-medicare/forms/ (${noA ? 'NO Part A yet: L564 only, applying for A+B online' : 'has Part A: CMS-40B + CMS-L564'}${d.basis === 'cobra' ? '. WARNING: says coverage is COBRA/retiree, check SEP dates' : ''}). Wants Part B to start: ${startLbl[d.start] || d.start}. Call to help them sign and send it to Social Security.`,
      }) }).catch(() => {});
      out.scrollIntoView({ behavior: 'smooth', block: 'start' });
      out.focus({ preventScroll: true });
    } catch (x) {
      err.textContent = (x as Error).message || 'Something went wrong. Please call us and we’ll fill it out with you.';
      err.hidden = false;
      err.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
</script>

<style>
  .fx [hidden] { display: none !important; }
  .fx__choose { max-width: 46rem; margin-bottom: var(--s-4); padding: var(--s-5); border-radius: 14px; background: var(--navy); color: #fff; }
  .fx__choose-h { margin: 0 0 var(--s-2); font-family: var(--font-display); font-size: var(--t-xl); color: #fff; }
  .fx__choose-p { margin: 0 0 var(--s-4); color: #dfe5f2; line-height: 1.6; }
  .fx { display: grid; gap: var(--s-6); max-width: 46rem; }
  .fx__warn { border-left: 4px solid var(--red); }
  .fx__noa ol { margin: var(--s-3) 0 0; padding-left: 1.2rem; }
  .fx__tcpa { margin-top: var(--s-3); max-width: 40rem; font-size: var(--t-xs, 0.8rem); color: var(--ink-muted, #5b6472); line-height: 1.5; }
  .fx__private { display: inline-block; padding: var(--s-3) var(--s-4); border-radius: 10px; background: var(--surface); border: 1px solid var(--rule-soft); font-size: var(--t-sm); }
  .fx__form fieldset { margin: 0 0 var(--s-5); padding: var(--s-5); border: 1px solid var(--rule-soft); border-radius: 14px; background: var(--surface); display: grid; gap: var(--s-4); }
