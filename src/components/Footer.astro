---
import { getCollection } from 'astro:content';
import site from '../config/site';
import { products } from '../data/products';
import { tools } from '../data/tools';
import { locations } from '../data/locations';
import { tpmoText, nonAffiliation, notAdvice } from '../data/compliance';

/**
 * Site-wide footer.
 *
 * Blocks, in order: advisor row → sitemap columns (incl. Contact/NAP) →
 * wordmark → compliance. Structure mirrors Medicare On Main's footer.
 *
 * The TPMO disclaimer appears HERE AND NOWHERE ELSE. It is required once per
 * page; repeating it on a page (as the Terms page used to) is not "extra
 * compliant", it just gives a reader two copies to reconcile. The audit script
 * asserts exactly one occurrence per page.
 *
 * Single office — Anthem, AZ. Do not add other locations here; the other
 * markets belong to a different brand entirely.
 */
const year = new Date().getFullYear();

// Top Learn articles, chosen by the same rule as the hub: featured first, then
// most recent. Publishing a new guide updates the footer with no edit here.
/**
 * Built as a single string rather than interpolated inline, so it renders as
 * one contiguous run of text. JSX interpolation inserts newlines mid-sentence,
 * which is invisible on screen but breaks any exact-match check over the HTML.
 */
const licenseLine = [
  `${site.agent.name}, NPN ${site.agent.npn}`,
  `Licensed in ${site.agent.statesLicensed} states`,
  `Licensed insurance agency in ${site.address.regionName}`,
].join(' · ');

/**
 * The copyright line. 602Medicare is a DBA rather than a corporation, so the
 * entity that actually holds it has to be named here. Reads as
 * "© 2026 602Medicare, a DBA of Kenztara INC".
 */
const copyrightLine = `${site.legalName}, a DBA of ${site.parentCompany}`;

/**
 * EVERY published guide is listed — no slice. The footer is the site's sitemap
 * for readers and crawlers alike; truncating it to a "top 5" hides the newest
 * articles from both. Publishing a guide adds it here with no edit to this file.
 */
const learnAll = (await getCollection('learn', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});
---

<footer class="site-footer" data-caustics="0.18">
  <div class="wrap--wide">

    <!-- ── Advisor row ────────────────────────────────────────────────── -->
    <div class="foot__advisor">
      {/* No mark on this row on purpose — the badge already appears twice in
          this footer (over the NAP, and as the wordmark band below), and a
          third copy in the same 900px of page reads as a template that lost
          count rather than as branding. */}
      <div class="foot__advisor-txt">
        <span class="foot__advisor-kicker">Your local advisor</span>
        <strong>{site.agent.name}</strong>
        {/* The experience + NPN pair is asserted by scripts/audit.mjs on every
            page — it lives here and only here. Don't drop it from this line. */}
        <span class="foot__advisor-line">
          {site.agent.title} · {site.agent.experience} Experience · NPN {site.agent.npn}
        </span>
        <span class="foot__advisor-line">
          {site.address.locality}, {site.address.region} · Licensed in {site.agent.statesLicensed} states
        </span>
      </div>

      <div class="foot__advisor-actions">
        <a href={site.consult.url} class="btn btn--light" data-magnetic="0.26">
          {site.consult.label}
        </a>
        <a href={site.phone.href} class="btn btn--onNavy">Call {site.phone.display}</a>
      </div>
    </div>

    <!-- ── Sitemap ────────────────────────────────────────────────────── -->
    <nav class="foot__map" aria-label="Footer">
      <div class="foot__col">
        <h2 class="foot__heading">Company</h2>
        <ul>
          <li><a href="/about/">About Brian</a></li>
          <li><a href="/service-area/">Service Area</a></li>
          {locations.map((l) => <li><a href={`/service-area/${l.slug}/`}>Medicare in {l.city}</a></li>)}
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__heading">Guides &amp; Articles</h2>
        <ul>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/learn/">All guides</a></li>
          {learnAll.map((a) => <li><a href={`/learn/${a.id}/`}>{a.data.title}</a></li>)}
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__heading">Plans &amp; Coverage</h2>
        <ul>
          {products.map((p) => <li><a href={`/${p.slug}/`}>{p.fullName}</a></li>)}
          <li><a href="/medicare-plans/">Compare all four</a></li>
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__heading">Free Tools</h2>
        <ul>
          <li><a href="/tools/">All tools</a></li>
          {tools.map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>)}
        </ul>
      </div>

      <!-- NAP — one office, structured for both humans and parsers -->
      <div class="foot__col foot__col--contact">
        <h2 class="foot__heading">Contact</h2>
        {/* The badge over the NAP, on its own white disc. The shipped PNG is
            transparent inside its ring, so dropped straight onto this navy the
            mountains and the "602" — both navy — disappear and only the red sun
            and red "MEDICARE" survive. The disc IS the navy-ground variant. */}
        <span class="foot__disc" aria-hidden="true">
          <picture>
            <source srcset="/logo/badge-128.webp" type="image/webp" />
            <img src="/logo/badge-128.png" alt="" width="128" height="128"
                 loading="lazy" decoding="async" />
          </picture>
        </span>
        <address class="foot__nap">
          <p class="foot__nap-name">{site.legalName}</p>
          {/* City and state only — there is no published street address, and
              inventing one for a footer is how a NAP audit starts failing. */}
          <p class="foot__nap-line">{site.address.display}</p>
          <p class="foot__nap-serving">{site.servingLine}</p>
          <p><a href={site.phone.href} class="foot__phone">{site.phone.display}</a></p>
          <p><a href={`mailto:${site.email}`} class="foot__email">{site.email}</a></p>
          <p class="foot__hours">{site.hours.display}</p>
        </address>
      </div>
    </nav>

    <!-- ── Wordmark ───────────────────────────────────────────────────── -->
    <div class="foot__wordmark">
      <span><em>{site.wordmark.mark}</em>{site.wordmark.product}</span>
    </div>

    <!-- ── Compliance — the ONLY place the TPMO disclaimer appears ─────── -->
    <div class="foot__legal">
      <p class="foot__license">{licenseLine}</p>
      <p>{tpmoText()}</p>
      <p>{nonAffiliation}</p>
      <p>{notAdvice}</p>
      <p class="foot__legal-fine">
        We comply with applicable federal civil rights laws and do not discriminate on the basis of
        race, color, national origin, age, disability or sex.
      </p>
    </div>

    <div class="foot__base">
      <p>&copy; {year} {copyrightLine}. All rights reserved.</p>
      <p class="foot__base-right">
        Your local advisor · {site.address.display}
      </p>
    </div>
  </div>
</footer>

<style>
  /* Badge navy ground, white text, red hovers. Every literal below is measured
     against #011459: #DCE2F5 is 13.6:1, #A9B4DB is 7.4:1, and the red used for
     hovers is --red-lift (5.5:1), never the raw --red, which is 3.0:1 here. */
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--navy);
    color: #DCE2F5;
    padding-block: clamp(3rem, 6vw, 4.5rem) var(--s-6);
    font-size: var(--t-sm);
    line-height: 1.65;
  }

  /* ── advisor row ─────────────────────────────────────────────────── */
  .foot__advisor {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding-bottom: var(--s-7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .foot__advisor-txt { display: flex; flex-direction: column; line-height: 1.35; }
  .foot__advisor-kicker {
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #A9B4DB;
    font-weight: 600;
  }
  .foot__advisor-txt strong {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #fff;
    letter-spacing: -0.015em;
  }
  .foot__advisor-line { font-size: var(--t-sm); color: #B7C0E0; }

  .foot__advisor-actions {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  @media (max-width: 720px) {
    .foot__advisor-actions { margin-left: 0; }
  }

  /* ── NAP ─────────────────────────────────────────────────────────── */
  /* The white disc behind the badge. See the note on the markup: the PNG is
     transparent inside its ring, so this is not decoration — without it half
     the mark is navy-on-navy and simply not there. */
  .foot__disc {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: #fff;
    margin-bottom: var(--s-4);
  }
  .foot__disc picture { display: block; line-height: 0; }
  .foot__disc img { width: 62px; height: 62px; }

  .foot__nap { font-style: normal; display: grid; gap: 0.3rem; align-content: start; }
  .foot__nap-serving { color: #B7C0E0; font-size: var(--t-xs); line-height: 1.5; }
  .foot__nap-name {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #A9B4DB;
    margin-bottom: 0.2rem;
  }
  .foot__nap-line { color: #DCE2F5; }
  .foot__phone {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: #fff;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    display: inline-block;
    margin-block: 0.15rem;
  }
  .foot__phone:hover { color: var(--red-lift); }
  .foot__email { color: #DCE2F5; }
  .foot__email:hover { color: var(--red-lift); }
  .foot__hours { color: #A9B4DB; font-size: var(--t-xs); margin-top: 0.2rem; }

  /* ── sitemap ─────────────────────────────────────────────────────── */
  .foot__map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
    padding-block: var(--s-7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .foot__heading {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #A9B4DB;
    margin-bottom: var(--s-3);
  }
  .foot__col ul { list-style: none; padding: 0; display: grid; gap: 0.45rem; }
  .foot__col a {
    color: #DCE2F5;
    display: inline-block;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 380ms var(--ease), color 200ms ease;
    padding-bottom: 1px;
    line-height: 1.45;
  }
  .foot__col a:hover { color: var(--red-lift); background-size: 100% 1px; }

  .foot__col--contact .foot__nap p { margin: 0; }

  /* ── wordmark ────────────────────────────────────────────────────── */
  /* Sized against the BAND, not the viewport — `cqw` is a share of this element's
     own width, which is what the type actually has to fill. The band is
     `min(1360px, 100% - 2×gutter)`, so a vw-based size drifts off target as the
     gutter's share of the viewport changes; the old vw tiers left the name
     filling anywhere from 68% to 87% of the band. */
  .foot__wordmark { padding-block: var(--s-6) var(--s-5); container-type: inline-size; }
  .foot__wordmark span {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    /* vw first as the fallback for anything without container queries — an
       invalid `cqw` declaration is dropped and this one survives the cascade. */
    font-size: clamp(34px, 12vw, 76px);
    /* Sized to span the band edge-to-edge, ~97% of it at every width. Two things
       drive these numbers: the name is 11 characters (~5.1em wide on Fraunces),
       and Fraunces is optically sized, so width-per-em GROWS as the type shrinks
       — 5.9em at 45px against 5.1em at 220px. That is the whole reason there are
       three tiers rather than one value.

       RETUNE ALL THREE IF THE BRAND NAME CHANGES LENGTH. They were measured for
       "602Medicare" and were roughly half these sizes when the name was 23
       characters long. nowrap + overflow:hidden is the backstop, not the plan. */
    font-size: clamp(38px, 16.5cqw, 112px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    max-width: 100%;
  }
  /* The tablet-portrait window. Without it the base tier's cqw, tuned for a
     ~335px band where Fraunces is at its widest per em, leaves the name filling
     only ~85% of a 615px band. */
  @media (min-width: 560px) {
    .foot__wordmark span { font-size: 12vw; font-size: 18.7cqw; }
  }
  @media (min-width: 860px) {
    .foot__wordmark span { font-size: 13.5vw; font-size: 18.8cqw; }
  }
  @media (min-width: 1024px) {
    /* The px ceiling matters: past ~1455px the band stops growing at 1360px, so
       without it the type would keep scaling off the end of a wide monitor. */
    .foot__wordmark span { font-size: min(15.4vw, 230px); font-size: min(19.2cqw, 262px); }
  }
  /* The "602" half. --red-lift, not --red: the raw badge red is 3.0:1 on this
     navy and would read as a bruise at 200px. The lifted twin is 5.5:1. */
  .foot__wordmark em { font-style: normal; color: var(--red-lift); }

  /* ── compliance ──────────────────────────────────────────────────── */
  .foot__legal {
    padding-block: var(--s-6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    gap: 0.7rem;
    font-size: 0.78125rem;
    line-height: 1.6;
    color: #A9B4DB;
    max-width: 92ch;
  }
  .foot__license { color: #DCE2F5; font-weight: 500; }
  .foot__legal-fine { color: #A9B4DB; }

  .foot__base {
    padding-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    font-size: 0.78125rem;
    color: #A9B4DB;
  }

  /* ── responsive ──────────────────────────────────────────────────── */
  @media (min-width: 860px) {
    /* Five columns, MOM-style. Guides carries the longest titles, Contact the
       widest unbreakable strings (email, phone), so both get extra track. */
    .foot__map { grid-template-columns: 1fr 1.35fr 1.15fr 1fr 1.1fr; }
  }
</style>
