---
import {
  testimonials,
  testimonialsSlim,
  testimonialsDisclosure,
} from '../data/testimonials';

interface Props {
  /** `slim` renders the three-card cut — currently the About page. */
  variant?: 'full' | 'slim';
}

const { variant = 'full' }: Props = Astro.props;
const items = variant === 'slim' ? testimonialsSlim : testimonials;

/**
 * Display-only social proof. There is deliberately NO Review or
 * AggregateRating JSON-LD emitted anywhere for these — see the header comment
 * in src/data/testimonials.ts for why, and do not add any.
 *
 * The five stars are decorative in the accessibility tree: every card carries
 * the same rating, so five separate "5 out of 5 stars" announcements per screen
 * would be noise. One visually-hidden line per card says it once.
 */
---

<ul class:list={['quotes', `quotes--${variant}`]}>
  {
    items.map((t, i) => (
      <li data-rise data-armed style={`--rise-delay:${i * 90}ms`}>
        <figure class="card quote">
          <span class="quote__stars" aria-hidden="true">
            {[0, 1, 2, 3, 4].map(() => (
              <svg viewBox="0 0 20 19" class="quote__star">
                <path d="M10 0l2.9 6.2 6.6.9-4.8 4.8 1.2 6.9L10 15.5 4.1 18.8l1.2-6.9L.5 7.1l6.6-.9L10 0Z"
                      fill="currentColor" />
              </svg>
            ))}
          </span>
          <span class="sr-only">Rated 5 out of 5.</span>

          <blockquote class="quote__text">
            <p>{t.quote}</p>
          </blockquote>

          <figcaption class="quote__by">
            <span class="quote__name">{t.name}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<p class="quotes__disclosure">{testimonialsDisclosure}</p>

<style>
  .quotes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .quotes > li { display: flex; }

  .quote {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--s-6) var(--s-5);
  }

  /* The accent, at its most literal. --red is 5.6:1 on the white card, so the
     stars are legible as shapes rather than as a pink smudge. */
  .quote__stars {
    display: flex;
    gap: 0.15rem;
    color: var(--red);
    margin-bottom: var(--s-4);
  }
  .quote__star { width: 15px; height: 14px; flex: none; }

  .quote__text {
    flex: 1;
    margin: 0 0 var(--s-5);
    font-family: var(--font-display);
    font-size: var(--t-lg);
    line-height: 1.45;
    color: var(--ink-body);
    letter-spacing: -0.005em;
  }
  .quote__by {
    display: grid;
    gap: 0.1rem;
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-soft);
  }
  .quote__name { font-size: var(--t-sm); font-weight: 600; color: var(--ink); }

  /* Muted, and directly under the cards — it has to be read as part of them. */
  .quotes__disclosure {
    margin-top: var(--s-5);
    font-size: var(--t-xs);
    line-height: 1.6;
    color: var(--ink-faint);
    max-width: 78ch;
  }
  .quotes--full + .quotes__disclosure { text-align: center; margin-inline: auto; }

  /* Five cards on one row is too thin to read at desktop widths; three-up with
     a second row of two sits better and keeps the quotes at a sane measure. */
  @media (min-width: 900px) {
    .quotes--full { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
