---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import site, { abs } from '../config/site';
import { serviceAreaRows } from '../data/locations';

/**
 * Why 602Medicare — the agency-comparison page.
 *
 * The left column states what this practice does. The right column is a
 * CHECKLIST of what to verify with any agent. It never says what another agent
 * lacks: no competitor has been evaluated, and a claim about one would be both
 * unprovable and a CMS marketing problem. Keep it that way when adding rows.
 *
 * ⚠️ Every "ours" cell must already be true and stated elsewhere on this site.
 *   - No review count and no star rating: the testimonials are reviews of the
 *     sister agency, display only, and the audit fails review structured data.
 *   - The 18-state license appears ONCE, in the "if you move" row, because
 *     that is the question it answers. It is not a headline stat — 602Medicare
 *     sells local (see TrustBar.astro).
 *   - No TPMO or non-affiliation sentence in the body. Both render exactly
 *     once, in the footer, and the audit fails a second copy.
 *   - Do not add a credential row (AHIP, E&O, carrier count, chamber
 *     membership) until Brian has confirmed the fact.
 */

const PATH = '/why-602medicare/';
const title = 'Why 602Medicare: Comparing Medicare Agents in Phoenix';
const description = `A checklist for choosing a Medicare agent in the Phoenix metro: ${site.agent.experience.toLowerCase()} in Medicare, based in Anthem, no fee. Call ${site.phone.display}.`;
const published = '2026-09-29';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Why 602Medicare', path: PATH },
];

const stats = [
  { n: `${site.agent.experienceYears}+`, l: 'Years in Medicare' },
  { n: String(serviceAreaRows.length), l: 'Valley communities' },
  { n: '$0', l: 'Fee for my help' },
  { n: site.address.locality, l: `Where I am based, ${site.address.region}` },
];

type Row = { what: string; ours: string; verify: string; href?: string; link?: string };
const groups: { name: string; rows: Row[] }[] = [
  {
    name: 'Experience',
    rows: [
      { what: 'Years in the business', ours: `${site.agent.experience.toLowerCase()} in Medicare, and one stage of life the whole time`, verify: 'Ask when the agent was first licensed, and how much of that time has been spent on Medicare.' },
      { what: 'A license you can check', ours: `Arizona-licensed. National Producer Number ${site.agent.npn}, searchable in any state lookup`, verify: 'Look the agent up with the Arizona Department of Insurance and Financial Institutions, or by National Producer Number.' },
      { what: 'Independent or captive', ours: 'Independent. I contract with multiple carriers and work for none of them', verify: 'Ask whether the agent is independent or works for a single carrier.', href: '/about/', link: 'What independent means' },
      { what: 'How the agent is paid', ours: 'By the carrier, and only if you enroll. Your premium is the same either way', verify: 'Ask how the agent is paid. A plain answer is a good sign.' },
      { what: 'Where the agent actually is', ours: `Based in ${site.address.display}, working ${serviceAreaRows.length} Valley communities`, verify: 'Ask where the person you are talking to is sitting. A local area code is not a local office.', href: '/service-area/', link: 'Service area' },
    ],
  },
  {
    name: 'Service',
    rows: [
      { what: 'Consultation fees', ours: 'None, for the conversation or the enrollment', verify: 'Ask about fees. Many agents also work at no charge to you.' },
      { what: 'Ways to meet', ours: 'Phone, video or in person, in Anthem and across the Valley', verify: 'Confirm whether meeting in person is possible where you live.' },
      { what: 'Scheduling', ours: 'Pick your own time online. Evening and weekend appointments by request', verify: 'Scheduling tools and availability vary.', href: site.consult.url, link: 'See open times' },
      { what: 'Who you talk to', ours: `${site.agent.name}, directly. The same person this year and next`, verify: 'Ask who takes your call next March: the agent who enrolled you, or a queue.' },
      { what: 'Preparation', ours: 'A five-minute intake form, so the appointment is a plan comparison rather than an interview', verify: 'Ask whether your doctors and prescriptions are checked before a plan is recommended.' },
      { what: 'Your pace, your decision', ours: 'No pressure. If your current plan still fits, I will tell you to stay put', verify: 'Ask for time to think it over. Notice how the agent responds.' },
      { what: 'After enrollment', ours: 'I stay your agent of record: the billing question in March, the network change in July, the review every fall', verify: 'Ask exactly what happens after you enroll, and who does it.' },
      { what: 'Education', ours: 'Free calculators and plain-English guides you can use before you ever call', verify: 'Ask what you can read before you decide.', href: '/tools/', link: 'Free tools' },
    ],
  },
  {
    name: 'Local insight',
    rows: [
      { what: 'Provider networks', ours: 'Your own doctors checked against each network before I recommend anything', verify: 'Ask a specific question: is my doctor in this plan’s network at this hospital?', href: '/learn/medicare-advantage-networks/', link: 'How networks work' },
      { what: 'ZIP by ZIP', ours: 'Plan availability and networks mapped by ZIP across the north and west Valley', verify: 'Availability is set county by county and networks differ by ZIP. Ask about yours.', href: '/service-area/', link: 'Find your ZIP' },
      { what: 'If you move or split the year', ours: `Licensed in ${site.agent.statesLicensed} states, so a move rarely means starting over with a stranger`, verify: 'Ask whether the agent is licensed where you spend the rest of the year.' },
      { what: 'Beyond Medicare', ours: 'Long-term care, dental-vision-hearing, hospital indemnity and the other coverage that fills Medicare’s gaps', verify: 'Ask what happens when your question is next door to Medicare rather than inside it.', href: '/medicare-plans/', link: 'Compare plan types' },
    ],
  },
];

const faqs = [
  {
    q: 'How do I choose a Medicare agent in the Phoenix area?',
    a: 'Check four things before you share any personal information. First, the license: look the agent up with the Arizona Department of Insurance and Financial Institutions or by National Producer Number. Second, independence: ask whether they work for one insurance company or contract with several. Third, location: ask where the person you are speaking with is based and whether you can meet in person. Fourth, service after enrollment: ask who answers when you have a billing or claim question next year. The checklist on this page lists the questions under each heading.',
  },
  {
    q: 'Does it cost anything to work with 602Medicare?',
    a: 'No. There is no fee for a conversation, a plan comparison or help enrolling. I am paid by the insurance carrier, and only if you enroll, and your premium is the same whether you use an agent or enroll on your own. Plan premiums, deductibles and copays still apply to whatever coverage you choose.',
  },
  {
    q: 'Is 602Medicare independent?',
    a: 'Yes. I contract with multiple carriers rather than working for one. Independent does not mean every plan, though. No agent represents every plan in a market, which is why the disclaimer sits at the bottom of every page here, and why I will point you to Medicare.gov or 1-800-MEDICARE if you want to see the complete list.',
  },
  {
    q: 'How can I verify Brian Penner’s insurance license?',
    a: `Search National Producer Number ${site.agent.npn} in the Arizona Department of Insurance and Financial Institutions license search, or in the national producer lookup run by the state insurance regulators. It takes about two minutes and is worth doing for any agent before you hand over a Medicare number.`,
  },
  {
    q: 'Can I meet in person?',
    a: `Yes. I am based in ${site.address.display} and meet face to face there and across the Valley, by arrangement. Phone and video work just as well if you would rather not drive. You can pick a time online for a ${site.consult.phrase}.`,
  },
];

const schemaNodes = [
  {
    '@type': 'WebPage',
    '@id': `${abs(PATH)}#webpage`,
    url: abs(PATH),
    name: title,
    description,
    isPartOf: { '@id': `${site.origin}/#website` },
    inLanguage: 'en-US',
    datePublished: published,
    dateModified: published,
    author: { '@id': `${site.origin}/#organization` },
    reviewedBy: { '@id': `${site.origin}/#brian-penner` },
    publisher: { '@id': `${site.origin}/#organization` },
    about: { '@id': `${site.origin}/#organization` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={PATH}
  breadcrumbs={breadcrumbs}
  schemaNodes={schemaNodes}
  publishedAt={published}
  modifiedAt={published}
>
  <PageHero
    eyebrow="Experience · Access · Follow-through"
    title="Why 602Medicare"
    lede="A Medicare agent should bring more than a quote. This page sets out what I do, in plain terms, next to the questions worth asking any agent you are considering. Me included."
    breadcrumbs={breadcrumbs}
  >
    <div class="why__actions">
      <a href={site.consult.url} class="btn" data-magnetic="0.22">{site.consult.label}</a>
      <a href={site.phone.href} class="btn btn--ghost">Call {site.phone.display}</a>
    </div>
    <ul class="why__stats">
      {stats.map((s) => (
        <li><span class="why__n tabular">{s.n}</span><span class="why__l">{s.l}</span></li>
      ))}
    </ul>
  </PageHero>

  <!-- ── Comparison ───────────────────────────────────────────────────── -->
  <section class="section band--tint" data-caustics="0.2">
    <div class="wrap">
      <SectionHead
        eyebrow="Compare the service behind the plan"
        title="602Medicare and other Medicare agents"
      />
      <p class="why__how">
        <strong>How to read this comparison.</strong>
        My column describes my own services and credentials. The right-hand column is a checklist
        of things to verify. It is not a finding that other agents lack them. No specific competitor
        has been evaluated here, and other agents may offer the same services.
      </p>
      <p class="why__swipe">On a small screen, swipe the chart sideways to see all three columns.</p>
      <div class="table-scroll why__scroll" tabindex="0" role="region" aria-label="Agency comparison checklist">
        <table class="why__table">
          <caption class="sr-only">Experience, service and local knowledge: a comparison checklist</caption>
          <thead>
            <tr>
              <th scope="col">What to compare</th>
              <th scope="col">{site.name}</th>
              <th scope="col">Other Medicare agents: what to verify</th>
            </tr>
          </thead>
          {groups.map((g) => (
            <tbody>
              <tr class="why__grp"><th colspan="3" scope="colgroup">{g.name}</th></tr>
              {g.rows.map((row) => (
                <tr>
                  <th scope="row">{row.what}</th>
                  <td class="why__ours">
                    <div>
                      <span class="why__tick" aria-hidden="true">✓</span>
                      <span>{row.ours}{row.href && (<><br /><a class="link" href={row.href}>{row.link} →</a></>)}</span>
                    </div>
                  </td>
                  <td class="why__verify">{row.verify}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
      <p class="why__note">
        Helping with a claim or an appeal does not guarantee a particular outcome. The insurer makes
        its own coverage decisions. Provider participation has to be checked for the specific plan
        and can change during the year. In-person appointments are by arrangement.
      </p>
    </div>
  </section>

  <!-- ── Narrative ────────────────────────────────────────────────────── -->
  <section class="section" data-caustics="0.26">
    <div class="wrap">
      <SectionHead
        eyebrow="What that adds up to"
        title="Twenty-two years. One advisor who picks up."
      />
      <div class="why__cards">
        <div class="card" data-rise data-armed>
          <h3>Experience that asks better questions</h3>
          <p>After twenty-two years the useful part is knowing what to ask before a plan is chosen: which doctors you would refuse to give up, what your prescriptions cost across a full year, and what happens to your coverage if you split the year somewhere cooler.</p>
        </div>
        <div class="card" data-rise data-armed style="--rise-delay:90ms">
          <h3>Someone who lives here</h3>
          <p>Provider networks are drawn around specific hospital systems. Whether the nearest in-network cardiologist is ten minutes away or forty changes which plan is right for you, and that is hard to weigh from a call center in another state.</p>
        </div>
        <div class="card" data-rise data-armed style="--rise-delay:180ms">
          <h3>Support after the paperwork</h3>
          <p>Most of the value of an agent shows up in years two through ten, not on enrollment day. The billing question, the denied claim, the plan that changes its network in the fall: those come to me, not to a 1-800 number.</p>
        </div>
      </div>
      <p class="why__after">
        Before we talk, the
        <a class="link" href={site.intake.url} target="_blank" rel="noopener">{site.intake.label}</a>
        sends me your doctors and prescriptions, so the appointment is spent comparing plans instead
        of collecting basics. Want the longer version of how I work?
        <a class="link" href="/about/">About Brian</a>.
      </p>
    </div>
  </section>

  <!-- ── Testimonials ─────────────────────────────────────────────────── -->
  {/* Display only — no Review or AggregateRating JSON-LD, here or anywhere. */}
  <section class="section section--tight" data-caustics="0.3">
    <div class="wrap">
      <SectionHead eyebrow="In their words" title="What Brian's Clients Say" align="center" />
      <Testimonials variant="slim" />
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="section band--tint" data-caustics="0.24">
    <div class="wrap wrap--narrow">
      <SectionHead
        eyebrow="Fair questions"
        title="What people ask before choosing an agent."
      />
      <Faq items={faqs} openFirst />
    </div>
  </section>

  <CtaBand
    title="Put a local advisor on your side."
    body="Bring your questions, your current plan card, the names of your doctors and your prescription list. No cost, no obligation, and you will speak to Brian directly."
  />
</BaseLayout>

<style>
  .why__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  .why__stats {
    list-style: none;
    padding: 0;
    margin-top: var(--s-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--s-3);
    max-width: 46rem;
  }
  .why__stats li {
    display: grid;
    gap: 0.2rem;
    padding: var(--s-4);
    border: 1px solid var(--rule-soft);
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
  }
  .why__n {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    line-height: 1;
    color: var(--navy);
  }
  .why__l { font-size: var(--t-xs); color: var(--ink-muted); }

  .why__how {
    max-width: 62rem;
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--rule-soft);
    border-left: 4px solid var(--red);
    border-radius: 10px;
    background: var(--surface);
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-body);
  }
  .why__swipe { display: none; margin-top: var(--s-3); font-size: var(--t-xs); color: var(--ink-muted); }

  .why__scroll { border-radius: 12px; border: 1px solid var(--rule); background: var(--surface); }
  .why__table { width: 100%; min-width: 47rem; border-collapse: collapse; font-size: var(--t-sm); }
  .why__table th,
  .why__table td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--rule-soft);
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
  }
  .why__table thead th {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--tint);
  }
  .why__grp th {
    background: var(--navy);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-block: 0.65rem;
  }
  .why__table tbody th[scope='row'] { width: 22%; font-weight: 600; color: var(--ink); }
  .why__ours { font-weight: 600; color: var(--ink); }
  .why__ours > div { display: flex; gap: 0.6rem; align-items: flex-start; }
  .why__tick {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    font-size: 0.8rem;
  }
  .why__verify { width: 36%; color: var(--ink-body); }
  .why__table tbody:last-child tr:last-child > * { border-bottom: 0; }

  .why__note {
    margin-top: var(--s-4);
    max-width: 62rem;
    font-size: var(--t-xs);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .why__cards { display: grid; gap: var(--s-5); }
  .why__cards h3 { font-size: var(--t-xl); margin-bottom: var(--s-3); }
  .why__cards p { color: var(--ink-body); line-height: 1.6; }
  .why__after { margin-top: var(--s-6); max-width: var(--measure); color: var(--ink-body); line-height: 1.6; }

  @media (min-width: 860px) {
    .why__cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .why__swipe { display: block; }
  }
</style>
