---
import { getCollection } from 'astro:content';
import site from '../config/site';
import { products } from '../data/products';
import { tools } from '../data/tools';
import { tpmoText, nonAffiliation, notAdvice } from '../data/compliance';

/**
 * Site-wide footer.
 *
 * Blocks, in order: brand → NAP → sitemap columns → CTA row → compliance.
 *
 * The TPMO disclaimer appears HERE AND NOWHERE ELSE. It is required once per
 * page; repeating it on a page (as the Terms page used to) is not "extra
 * compliant", it just gives a reader two copies to reconcile. The audit script
 * asserts exactly one occurrence per page.
 *
 * Single office — Anthem, AZ. Do not add other locations here; the other
 * markets belong to a different brand entirely.
 */
const year = new Date().getFullYear();

// Top Learn articles, chosen by the same rule as the hub: featured first, then
// most recent. Publishing a new guide updates the footer with no edit here.
/**
 * Built as a single string rather than interpolated inline, so it renders as
 * one contiguous run of text. JSX interpolation inserts newlines mid-sentence,
 * which is invisible on screen but breaks any exact-match check over the HTML.
 */
const licenceLine = [
  site.agent.name,
  `National Producer Number ${site.agent.npn}`,
  `Licensed in ${site.agent.statesLicensed} states`,
  `Licensed insurance agency in ${site.address.regionName}`,
].join(' · ');

const learnTop = (await getCollection('learn', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  })
  .slice(0, 5);
---

<footer class="site-footer" data-caustics="0.18">
  <div class="wrap--wide">

    <!-- ── Brand + NAP ────────────────────────────────────────────────── -->
    <div class="foot__identity">
      <div class="foot__brand">
        <a href="/" class="foot__logo" aria-label={`${site.name} — home`}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M16 2.5 3.5 8v9.2c0 7.1 5.1 11.6 12.5 14.3 7.4-2.7 12.5-7.2 12.5-14.3V8L16 2.5Z"
                  fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <path d="M10 16.6h3.4l1.5-4 2.2 7 1.6-3h3.3"
                  fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="foot__wordmark">Insurance Anthem</span>
        </a>

        <p class="foot__tagline">{site.tagline}</p>

        <p class="foot__agent">
          <strong>{site.agent.name}</strong>
          <span aria-hidden="true">·</span>
          <span>{site.agent.experience} Experience</span>
          <span aria-hidden="true">·</span>
          <span>NPN {site.agent.npn}</span>
        </p>
      </div>

      <!-- NAP — one office, structured for both humans and parsers -->
      <address class="foot__nap">
        <p class="foot__nap-name">{site.legalName}</p>
        <p class="foot__nap-line">{site.address.display}</p>
        <p>
          <a href={site.phone.href} class="foot__phone">{site.phone.display}</a>
        </p>
        <p><a href={`mailto:${site.email}`} class="foot__email">{site.email}</a></p>
        <p class="foot__hours">{site.hours.display}</p>
      </address>
    </div>

    <!-- ── Sitemap ────────────────────────────────────────────────────── -->
    <nav class="foot__map" aria-label="Footer">
      <div class="foot__col">
        <h2 class="foot__heading">Services</h2>
        <ul>
          {products.map((p) => <li><a href={`/${p.slug}/`}>{p.fullName}</a></li>)}
          <li><a href="/medicare-plans/">Compare all four</a></li>
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__heading">Learn</h2>
        <ul>
          <li><a href="/learn/">All guides</a></li>
          {learnTop.map((a) => <li><a href={`/learn/${a.id}/`}>{a.data.title}</a></li>)}
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__heading">Free Tools</h2>
        <ul>
          <li><a href="/tools/">All tools</a></li>
          {tools.map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>)}
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__heading">Company</h2>
        <ul>
          <li><a href="/about/">About Brian</a></li>
          <li><a href="/service-area/">Service Area</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
        </ul>
      </div>
    </nav>

    <!-- ── CTA row ────────────────────────────────────────────────────── -->
    <div class="foot__cta">
      <div class="foot__cta-copy">
        <p class="foot__cta-head">Not sure where to start?</p>
        <p class="foot__cta-sub">
          {site.consult.minutes} minutes on the phone, no cost, no obligation — and no product at
          the end of it unless one belongs there.
        </p>
      </div>
      <div class="foot__cta-actions">
        <a href={site.consult.url} class="btn btn--light" data-magnetic="0.26">
          {site.consult.label}
        </a>
        <a href={site.phone.href} class="btn btn--onNavy">Call {site.phone.display}</a>
      </div>
    </div>

    <!-- ── Compliance — the ONLY place the TPMO disclaimer appears ─────── -->
    <div class="foot__legal">
      <p class="foot__licence">{licenceLine}</p>
      <p>{tpmoText()}</p>
      <p>{nonAffiliation}</p>
      <p>{notAdvice}</p>
      <p class="foot__legal-fine">
        We comply with applicable federal civil rights laws and do not discriminate on the basis of
        race, color, national origin, age, disability or sex.
      </p>
    </div>

    <div class="foot__base">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <p class="foot__base-right">
        Your local advisor · {site.address.locality}, {site.address.region}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--navy-deep);
    color: #B9CBD9;
    padding-block: clamp(3rem, 6vw, 4.5rem) var(--s-6);
    font-size: var(--t-sm);
    line-height: 1.65;
  }

  /* ── brand + NAP ─────────────────────────────────────────────────── */
  .foot__identity {
    display: grid;
    gap: var(--s-7);
    padding-bottom: var(--s-7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .foot__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
    margin-bottom: var(--s-4);
  }
  .foot__logo svg { width: 30px; height: 30px; flex: none; }
  .foot__wordmark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .foot__tagline { color: #A6BCCC; max-width: 38ch; margin-bottom: var(--s-4); }

  .foot__agent {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: var(--t-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #8FA8BA;
  }
  .foot__agent strong { color: #DCE8F1; font-weight: 600; }

  .foot__nap { font-style: normal; display: grid; gap: 0.3rem; align-content: start; }
  .foot__nap-name {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #7FA3BE;
    margin-bottom: 0.2rem;
  }
  .foot__nap-line { color: #C3D5E2; }
  .foot__phone {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: #fff;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    display: inline-block;
    margin-block: 0.15rem;
  }
  .foot__phone:hover { color: #9CC0DC; }
  .foot__email { color: #DCE8F1; }
  .foot__email:hover { color: #fff; }
  .foot__hours { color: #8FA8BA; font-size: var(--t-xs); margin-top: 0.2rem; }

  /* ── sitemap ─────────────────────────────────────────────────────── */
  .foot__map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
    padding-block: var(--s-7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .foot__heading {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #7FA3BE;
    margin-bottom: var(--s-3);
  }
  .foot__col ul { list-style: none; padding: 0; display: grid; gap: 0.45rem; }
  .foot__col a {
    color: #C3D5E2;
    display: inline-block;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 380ms var(--ease), color 200ms ease;
    padding-bottom: 1px;
    line-height: 1.45;
  }
  .foot__col a:hover { color: #fff; background-size: 100% 1px; }

  /* ── CTA row ─────────────────────────────────────────────────────── */
  .foot__cta {
    display: grid;
    gap: var(--s-5);
    align-items: center;
    padding-block: var(--s-7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .foot__cta-head {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    color: #fff;
    letter-spacing: -0.015em;
    margin-bottom: 0.3rem;
  }
  .foot__cta-sub { color: #A6BCCC; max-width: 48ch; }
  .foot__cta-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  /* ── compliance ──────────────────────────────────────────────────── */
  .foot__legal {
    padding-block: var(--s-6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    gap: 0.7rem;
    font-size: 0.78125rem;
    line-height: 1.6;
    color: #8FA8BA;
    max-width: 92ch;
  }
  .foot__licence { color: #C3D5E2; font-weight: 500; }
  .foot__legal-fine { color: #7A93A6; }

  .foot__base {
    padding-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    font-size: 0.78125rem;
    color: #7A93A6;
  }

  /* ── responsive ──────────────────────────────────────────────────── */
  @media (min-width: 640px) {
    .foot__identity { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--s-8); }
  }
  @media (min-width: 860px) {
    .foot__map { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .foot__cta {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-7);
    }
  }
</style>
