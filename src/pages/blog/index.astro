---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import site, { abs } from '../../config/site';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../data/posts';

/**
 * The blog hub.
 *
 * Posts are .md files sitting next to this one. src/data/posts.ts globs them
 * eagerly at build time, so dropping a new file into src/pages/blog/ adds a
 * card here (and on the home page), a route, its structured data and its
 * sitemap entry with no edit to this file —
 * the same deal the Learn hub gives the content collection.
 *
 * Blog vs Learn: Learn is the evergreen reference shelf, revised in place. This
 * is dated and local — seasonal deadlines, this market, this plan year. See the
 * header comment in src/layouts/BlogLayout.astro.
 */
const title = 'Medicare Blog — Deadlines, Dates & Local Notes';
const description =
  "Plain-English Medicare answers for Anthem, Scottsdale & the Phoenix metro — enrollment windows, plan comparisons, IRMAA and long-term care.";

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const schemaNodes = [
  {
    '@type': 'Blog',
    '@id': `${abs('/blog/')}#blog`,
    url: abs('/blog/'),
    name: title,
    description,
    isPartOf: { '@id': `${site.origin}/#website` },
    publisher: { '@id': `${site.origin}/#organization` },
    inLanguage: 'en-US',
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.title,
      url: abs(p.href),
      datePublished: p.date.toISOString(),
      author: { '@id': `${site.origin}/#brian-penner` },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/blog/"
  breadcrumbs={breadcrumbs}
  schemaNodes={schemaNodes}
>
  <PageHero
    eyebrow="Blog"
    title="Dates, deadlines and local notes."
    lede={`Shorter and more time-bound than the guides: what is happening in Medicare right now, when your own window opens, and what any of it means if you live north of the 101. Every figure is stamped with the plan year it applies to.`}
    breadcrumbs={breadcrumbs}
    caustics="0.46"
  >
    <div class="btn-row">
      <a href={site.consult.url} class="btn btn--lg" data-magnetic="0.3">{site.consult.label}</a>
      <a href="/learn/" class="btn btn--ghost btn--lg" data-magnetic="0.22">Read the full guides</a>
    </div>
  </PageHero>

  <section class="section section--tight" data-caustics="0.22">
    <div class="wrap">
      {
        posts.length === 0 ? (
          <p class="empty">Nothing published yet — check back shortly.</p>
        ) : (
          <ul class="cards">
            {posts.map((p, i) => (
              <li data-rise data-armed style={`--rise-delay:${Math.min(i * 60, 320)}ms`}>
                <PostCard post={p} />
              </li>
            ))}
          </ul>
        )
      }

      <p class="hub__cross">
        Looking for the long version instead? The
        <a href="/learn/" class="link">Medicare guides</a> cover each topic end to end, and the
        <a href="/tools/" class="link">free tools</a> let you work the numbers yourself.
      </p>
    </div>
  </section>

  <CtaBand
    title="Deadlines are the one thing you cannot fix later."
    body={`If you are not sure which window you are in, that is a five-minute answer. ${site.agent.name}, ${site.agent.experience} in Medicare, based in ${site.address.display}.`}
    cta={site.consult.label}
  />
</BaseLayout>

<style>
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }
  .cards > li { display: flex; }

  .empty { color: var(--ink-muted); }
  .hub__cross { margin-top: var(--s-7); font-size: var(--t-sm); color: var(--ink-muted); }

</style>
