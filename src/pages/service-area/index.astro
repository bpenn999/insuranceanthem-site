---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import site from '../../config/site';
import { locations, additionalAreas } from '../../data/locations';
import countyHealth from '../../data/county-health';
import { abs } from '../../config/site';

const title = 'Service Area — Anthem, Glendale, Peoria & the Phoenix Metro';
const description = `Independent Medicare help across Anthem, Scottsdale & the Phoenix metro — plan availability and provider networks differ by ZIP. Call ${site.phone.display}.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Service Area', path: '/service-area/' },
];

/**
 * Dataset, wrapping the CDC PLACES figures below — the fourth pillar of the
 * location-page standard, and the only place on this site it applies, because
 * this is the only page carrying sourced statistics. `creator` is the CDC, not
 * 602Medicare: the agency is quoting this data, not producing it, and saying
 * otherwise in structured data would be a citation error dressed as markup.
 */
const schemaNodes = [
  {
    '@type': 'Dataset',
    name: `Adult health prevalence, ${countyHealth.county}, Arizona`,
    description:
      `Crude prevalence among adults 18 and over in ${countyHealth.county} for the ` +
      'chronic conditions that most often shape a Medicare plan comparison.',
    url: abs('/service-area/'),
    isAccessibleForFree: true,
    creator: {
      '@type': 'GovernmentOrganization',
      name: 'Centers for Disease Control and Prevention',
      url: countyHealth.sourceUrl,
    },
    distribution: {
      '@type': 'DataDownload',
      contentUrl: countyHealth.datasetUrl,
      encodingFormat: 'application/json',
    },
    spatialCoverage: {
      '@type': 'AdministrativeArea',
      name: countyHealth.county,
      identifier: countyHealth.fips,
    },
    temporalCoverage: String(Math.min(...countyHealth.measures.map((m) => m.year))),
    variableMeasured: countyHealth.measures.map((m) => ({
      '@type': 'PropertyValue',
      name: m.label,
      value: m.value,
      unitText: 'percent of adults 18+',
    })),
  },
];
---

<BaseLayout title={title} description={description} path="/service-area/" breadcrumbs={breadcrumbs} schemaNodes={schemaNodes}>
  <PageHero
    eyebrow="Service area"
    title="An office in Anthem, and a patch that runs across the Valley."
    lede="Medicare plan availability is set county by county, and within a county the differences between neighboring ZIPs are real — Glendale and Peoria alone span several. That is the entire argument for working with somebody who covers this specific patch rather than a call center three states away."
    breadcrumbs={breadcrumbs}
  />

  <section class="section section--tight" data-caustics="0.34">
    <div class="wrap">
      <ul class="places">
        {
          locations.map((l, i) => (
            <li data-rise data-armed style={`--rise-delay:${i * 80}ms`}>
              <a href={`/service-area/${l.slug}/`} class="card-link">
                <article class="card card--hover place">
                  {l.primary && <span class="place__badge">Home base</span>}
                  <h2 class="place__city">{l.label}</h2>
                  <p class="place__zips">{l.zips.map((z) => `ZIP ${z}`).join(' · ')} · {l.county}</p>
                  <p class="place__summary">{l.summary}</p>
                  <span class="place__more">
                    Medicare help in {l.city}
                    <svg viewBox="0 0 14 10" aria-hidden="true">
                      <path d="M9 1l4 4-4 4M13 5H1" fill="none" stroke="currentColor"
                            stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </article>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── County health ─────────────────────────────────────────────────
       The only sourced statistics on the site, and they sit HERE rather than
       on the city pages on purpose: all seven cities are in Maricopa, so these
       numbers are identical for every one of them. Repeating them seven times
       would rebuild the near-duplicate problem the city pages were rewritten
       to remove. This is the page whose subject is actually the county.
  ──────────────────────────────────────────────────────────────────── -->
  <section class="section" data-caustics="0.2">
    <div class="wrap wrap--narrow">
      <SectionHead
        eyebrow="Maricopa County"
        title="What people here are actually managing."
        lede="Plan comparisons get abstract fast. These are the conditions most likely to be sitting behind a Medicare decision in this county — and each one changes which part of a plan matters."
      />

      <ul class="ch">
        {
          countyHealth.measures.map((m, i) => (
            <li data-rise data-armed style={`--rise-delay:${i * 60}ms`}>
              <div class="ch__figure">
                <span class="ch__value">{m.value}%</span>
                <span class="ch__label">{m.label}</span>
              </div>
              <p class="ch__so">{m.soWhat}</p>
              <span class="ch__year">CDC PLACES, {m.year}</span>
            </li>
          ))
        }
      </ul>

      <p class="ch__source">
        Crude prevalence among <strong>adults 18 and over</strong> in {countyHealth.county} —
        not a Medicare-age figure, and the real rate among people over 65 is higher for
        most of these. Source:{' '}
        <a href={countyHealth.datasetUrl} target="_blank" rel="noopener">
          {countyHealth.source}
        </a>, retrieved {new Date(`${countyHealth.retrieved}T12:00:00Z`).toLocaleDateString('en-US',
          { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}.
        Figures describe the county, not any individual — nothing here predicts what your own
        coverage should be.
      </p>
    </div>
  </section>

  <section class="section band--tint" data-caustics="0.24">
    <div class="wrap wrap--narrow">
      <SectionHead
        eyebrow="Beyond the map"
        title="Not on the list?"
      />
      <div class="prose">
        {/* The tier-two communities: served and listed on the home page, but
            without a page of their own — each one covered in the copy of the
            page named in its `servedBy`. Naming them here keeps the hub from
            contradicting the home page's ZIP table. The count is derived, not
            written: this sentence said "those three" for a while after
            Scottsdale was promoted to a page of its own. */}
        <p>
          I also work
          {' '}{additionalAreas.map((a) => a.city).join(', ').replace(/, ([^,]*)$/, ' and $1')}
          {' '}— {additionalAreas.map((a) => `${a.city} (${a.zips.join(', ')})`).join('; ')}.
          {' '}{additionalAreas.length === 1 ? 'That one does' : 'Those do'} not have a page of
          {' '}{additionalAreas.length === 1 ? 'its' : 'their'} own, which says something about how
          much I have written rather than about whether I cover
          {' '}{additionalAreas.length === 1 ? 'it' : 'them'}.
        </p>
        <p>
          The pages above are the communities I work in most, but I am licensed in
          {' '}{site.agent.statesLicensed} states. If you are elsewhere in Maricopa County, elsewhere
          in Arizona, or somewhere else entirely and you have been referred here — call and ask.
          The worst case is that I point you to somebody better placed, which is a perfectly good
          outcome.
        </p>
        <p>
          What I will not do is take on a market I do not know well enough to be useful in.
          Medicare advice that is not grounded in the specific plans, networks and providers
          available where you live is not advice; it is a brochure.
        </p>
        <h3>Meeting in person</h3>
        <p>
          The office is in {site.address.display}. In-person appointments happen at kitchen tables,
          libraries, coffee shops and wherever else suits you across the Phoenix metro. Plenty of
          people would rather do the whole thing by phone or video, and that works equally well —
          the comparison is the same either way.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Wherever you are in the Valley."
    body={`${site.agent.name}, based in ${site.address.locality}. ${site.hours.display}. ${site.hours.note}`}
  />
</BaseLayout>

<style>
  .ch { list-style: none; padding: 0; margin: 0 0 var(--s-5); display: grid; gap: var(--s-4); }
  .ch li { padding-bottom: var(--s-4); border-bottom: 1px solid var(--rule-soft); }
  .ch li:last-child { border-bottom: 0; padding-bottom: 0; }
  .ch__figure { display: flex; align-items: baseline; gap: var(--s-3); flex-wrap: wrap; }
  .ch__value { font-family: var(--font-display, inherit); font-size: var(--t-2xl); font-weight: 600; color: var(--accent, currentColor); font-variant-numeric: tabular-nums; }
  .ch__label { font-size: var(--t-base); font-weight: 600; }
  .ch__so { font-size: var(--t-sm); color: var(--ink-body); line-height: 1.6; margin: 0.35rem 0 0.3rem; max-width: 60ch; }
  .ch__year { font-size: 0.6875rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-muted); }
  .ch__source { font-size: var(--t-sm); color: var(--ink-muted); line-height: 1.6; }
  @media (min-width: 720px) { .ch { grid-template-columns: 1fr 1fr; gap: var(--s-5) var(--s-6); } }

  .places {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .places > li { display: flex; }
  .places .card-link { display: flex; width: 100%; }

  .place { display: flex; flex-direction: column; width: 100%; position: relative; }
  .place__badge {
    position: absolute;
    top: var(--s-5);
    right: var(--s-5);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--navy);
    background: var(--navy-wash);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }
  .place__city { font-size: var(--t-xl); margin-bottom: var(--s-2); padding-right: 6rem; }
  .place__zips {
    font-size: var(--t-xs);
    color: var(--ink-faint);
    letter-spacing: 0.05em;
    margin-bottom: var(--s-4);
  }
  .place__summary {
    font-size: var(--t-sm);
    color: var(--ink-muted);
    line-height: 1.6;
    flex: 1;
    margin-bottom: var(--s-5);
  }
  .place__more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--navy);
  }
  .place__more svg { width: 14px; height: 10px; transition: transform 340ms var(--ease); }
  .card-link:hover .place__more svg { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .card-link:hover .place__more svg { transform: none; }
  }
</style>
