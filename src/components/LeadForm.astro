---
import site from '../config/site';

/**
 * Contact / quote-request form.
 *
 * Posts JSON to `site.leadEndpoint` — the /api/lead Pages Function, which
 * relays to GoGuruX server-side so the CRM webhook never ships in the page.
 * If that endpoint is empty, or answers anything other than 200, the form
 * composes a prefilled email to the agency instead of silently swallowing the
 * submission. An enquiry is never lost to a CRM outage.
 *
 * Honeypot is deliberately named `xtr_field`: browsers autofill fields called
 * "company", "website" or "address" even when told not to, which turns a
 * honeypot into a trap for real people.
 */
---

<form class="lead" data-lead data-endpoint={site.leadEndpoint || undefined} novalidate>
  <div class="lead__grid">
    <p class="field">
      <label for="lead-name">Your name <span aria-hidden="true">*</span></label>
      <input id="lead-name" name="name" type="text" autocomplete="name" required />
      <span class="field__error" data-error-for="name"></span>
    </p>

    <p class="field">
      <label for="lead-phone">Phone <span aria-hidden="true">*</span></label>
      <input id="lead-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
      <span class="field__error" data-error-for="phone"></span>
    </p>

    <p class="field">
      <label for="lead-email">Email</label>
      <input id="lead-email" name="email" type="email" autocomplete="email" />
      <span class="field__error" data-error-for="email"></span>
    </p>

    <p class="field">
      <label for="lead-zip">ZIP code</label>
      <input id="lead-zip" name="zip" type="text" inputmode="numeric" maxlength="5"
             autocomplete="postal-code" placeholder="85086" />
      <span class="field__error" data-error-for="zip"></span>
    </p>

    <p class="field field--full">
      <label for="lead-situation">What's going on?</label>
      <select id="lead-situation" name="situation">
        <option value="">Choose one…</option>
        <option value="turning-65">I'm turning 65</option>
        <option value="review">I have a plan and want it reviewed</option>
        <option value="retiring">I'm retiring / losing employer coverage</option>
        <option value="new-to-area">I just moved to Arizona</option>
        <option value="rx">My prescription costs went up</option>
        <option value="ltc">Long-term care planning</option>
        <option value="helping-parent">I'm helping a parent</option>
        <option value="other">Something else</option>
      </select>
    </p>

    <p class="field field--full">
      <label for="lead-message">Anything you'd like me to know?</label>
      <textarea id="lead-message" name="message" rows="4"
                placeholder="Doctors you want to keep, medications, questions — whatever's on your mind."></textarea>
    </p>
  </div>

  <!-- honeypot: not an autofill token, visually and semantically removed -->
  <div class="lead__hp" aria-hidden="true">
    <label for="xtr_field">Leave this field empty</label>
    <input id="xtr_field" name="xtr_field" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="field field--consent">
    <input id="lead-consent" name="consent" type="checkbox" required />
    <label for="lead-consent">
      I agree to be contacted by {site.name} at the phone number and email above about Medicare
      plan options, including by phone, text and email. Consent is not a condition of purchase,
      message and data rates may apply, and I can opt out at any time. See our
      <a href="/privacy/" class="link">Privacy Policy</a>.
    </label>
  </p>
  <span class="field__error field__error--consent" data-error-for="consent"></span>

  <div class="lead__submit">
    <button type="submit" class="btn btn--lg" data-magnetic="0.24" data-lead-submit>
      Send my request
    </button>
    <p class="lead__alt">
      Prefer to talk now? Call <a href={site.phone.href} class="link">{site.phone.display}</a>.
    </p>
  </div>

  <p class="lead__tcpa">
    By submitting this form you are requesting contact from a licensed insurance agent.
    We do not sell or share your information. No plan is enrolled without your explicit consent.
  </p>
</form>

<div class="lead-done" data-lead-done hidden role="status" aria-live="polite">
  <svg class="lead-done__tick" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3" />
    <path d="M12.5 20.5l5 5 10-11" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <h3 data-lead-done-title>Thanks — that's through.</h3>
  <p data-lead-done-body></p>
  <p class="lead-done__next">
    In the meantime, the <a href="/tools/" class="link">free tools</a> will get you a head start,
    or call <a href={site.phone.href} class="link">{site.phone.display}</a> if you'd rather not wait.
  </p>
</div>

<style>
  .lead__grid {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .field--full { grid-column: 1 / -1; }

  .field { display: grid; gap: 0.35rem; margin: 0; }
  .field label {
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink);
  }
  .field label span { color: var(--navy); }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    min-height: 48px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink);
    font-size: 1rem;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .field textarea { min-height: 7rem; resize: vertical; line-height: 1.55; }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--navy);
    box-shadow: 0 0 0 3px var(--navy-tint);
    outline: none;
  }
  .field [aria-invalid='true'] { border-color: #A42C1E; }

  .field__error { font-size: var(--t-xs); color: #A42C1E; min-height: 1em; }
  .field__error:empty { display: none; }
  .field__error--consent { display: block; margin-top: 0.25rem; }

  .field--consent {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    margin-top: var(--s-5);
  }
  .field--consent input {
    width: 20px; height: 20px; min-height: 0;
    margin-top: 0.15rem;
    accent-color: var(--navy);
    padding: 0;
  }
  .field--consent label {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink-muted);
    line-height: 1.55;
  }

  /* Honeypot — off-canvas rather than display:none, which some bots detect. */
  .lead__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .lead__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-6);
  }
  .lead__alt { font-size: var(--t-sm); color: var(--ink-muted); }

  .lead__tcpa {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-soft);
    font-size: 0.75rem;
    color: var(--ink-faint);
    line-height: 1.55;
  }

  /* --- success --- */
  .lead-done {
    text-align: center;
    padding: var(--s-8) var(--s-5);
  }
  .lead-done__tick { width: 44px; height: 44px; color: var(--navy); margin: 0 auto var(--s-5); }
  .lead-done h3 { font-size: var(--t-2xl); margin-bottom: var(--s-3); }
  .lead-done p { color: var(--ink-muted); max-width: 46ch; margin-inline: auto; }
  .lead-done__next { margin-top: var(--s-5); font-size: var(--t-sm); }
</style>

<script>
  import site from '../config/site';

  const EMAIL = site.email;

  document.querySelectorAll<HTMLFormElement>('[data-lead]').forEach((form) => {
    const done = document.querySelector<HTMLElement>('[data-lead-done]');
    const doneBody = done?.querySelector<HTMLElement>('[data-lead-done-body]');
    const submit = form.querySelector<HTMLButtonElement>('[data-lead-submit]');

    /* --- prefill from the hero funnel ------------------------------------ */
    const params = new URLSearchParams(location.search);
    let stashed: Record<string, string> = {};
    try {
      stashed = JSON.parse(sessionStorage.getItem('ia_funnel') || '{}');
    } catch { /* ignore */ }

    const prefill = (name: string, value?: string | null) => {
      if (!value) return;
      const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (!el) return;
      // Only fill an option that actually exists, or we silently blank a select.
      if (el instanceof HTMLSelectElement && !Array.from(el.options).some((o) => o.value === value)) return;
      if (!el.value) el.value = value;
    };
    prefill('zip', params.get('zip') || stashed.zip);
    prefill('situation', params.get('situation') || stashed.intent);

    const priority = params.get('priority') || stashed.priority;
    const msg = form.elements.namedItem('message') as HTMLTextAreaElement | null;
    const PRIORITY_TEXT: Record<string, string> = {
      doctors: 'Most important to me: keeping my current doctors.',
      cost: 'Most important to me: the lowest monthly cost.',
      rx: 'Most important to me: my prescription costs.',
      travel: 'Most important to me: coverage when I travel.',
    };
    if (priority && msg && !msg.value && PRIORITY_TEXT[priority]) {
      msg.value = PRIORITY_TEXT[priority];
    }

    /* --- validation ------------------------------------------------------ */
    const setError = (name: string, message: string) => {
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = form.elements.namedItem(name) as HTMLElement | null;
      if (slot) slot.textContent = message;
      input?.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    const validate = (): boolean => {
      let ok = true;
      const get = (n: string) => (form.elements.namedItem(n) as HTMLInputElement)?.value.trim() ?? '';

      ['name', 'phone', 'email', 'zip', 'consent'].forEach((n) => setError(n, ''));

      if (!get('name')) { setError('name', 'Please tell us your name.'); ok = false; }

      const phone = get('phone').replace(/\D/g, '');
      if (phone.length < 10) { setError('phone', 'Please enter a 10-digit phone number.'); ok = false; }

      const email = get('email');
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        setError('email', "That email doesn't look right."); ok = false;
      }

      const zip = get('zip');
      if (zip && !/^\d{5}$/.test(zip)) { setError('zip', 'ZIP should be 5 digits.'); ok = false; }

      const consent = form.elements.namedItem('consent') as HTMLInputElement;
      if (!consent.checked) {
        setError('consent', 'Please tick the box so we know we may contact you.'); ok = false;
      }

      if (!ok) form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return ok;
    };

    /* --- submit ----------------------------------------------------------
     *
     * POST first, email only if the POST could not be made to work. The two
     * are not interchangeable: a visitor who lands in the mailto path still
     * has to press send in their own mail client, and the ones who do not are
     * enquiries nobody ever sees. So the draft is the outage plan, never the
     * default — which is why `endpoint` is checked before anything is composed
     * and why the only route to the mailto branch is a fetch that failed.
     *
     * The success card must never be shown over a submission that went
     * nowhere. Every early return below either sent something or told the
     * visitor how to reach the practice another way.
     */
    const SUCCESS_COPY = `Got it — I'll be in touch within one business day.`;

    /**
     * Split "Your name" into first and last for the CRM.
     *
     * The relay does this too, for native form-encoded posts. Doing it here as
     * well is not duplication for its own sake — it is what lets the JSON body
     * carry the field names the CRM actually stores, so a payload read off the
     * network tab says what it will become on the contact record.
     */
    const splitName = (full: string): { first: string; last: string } => {
      const parts = full.trim().split(/\s+/).filter(Boolean);
      if (!parts.length) return { first: '', last: '' };
      return { first: parts[0], last: parts.slice(1).join(' ') };
    };

    const setBusy = (busy: boolean) => {
      if (!submit) return;
      submit.disabled = busy;
      submit.textContent = busy ? 'Sending…' : 'Send my request';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot: show the normal success path, drop the submission silently.
      // Never make a honeypot hit a visible no-op — that eats real leads too.
      const hp = (form.elements.namedItem('xtr_field') as HTMLInputElement)?.value;

      if (!validate()) return;

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      delete data.xtr_field;

      const showDone = (body: string) => {
        if (!done) return;
        if (doneBody) doneBody.textContent = body;
        form.hidden = true;
        done.hidden = false;
        done.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      if (hp) {
        showDone(`We'll be in touch shortly.`);
        return;
      }

      /* --- the primary path: post it -------------------------------------- */
      const endpoint = form.dataset.endpoint;

      if (endpoint) {
        const { first, last } = splitName(data.name || '');
        const payload = {
          first,
          last,
          email: data.email || '',
          phone: data.phone || '',
          zip: data.zip || '',
          message: data.message || '',
          // The "What's going on?" answer, under the name /api/lead documents.
          // The field itself stays `situation`, because that is what the hero
          // funnel's prefill and the query string both key off.
          coverage_interest: data.situation || '',
          // Not decoration: the relay folds this into the CRM note, and TCPA
          // requires the practice to be able to show the visitor agreed to be
          // contacted. Dropping it from the payload would quietly lose that.
          consent: data.consent || '',
          source: `${site.domain}/contact`,
        };

        setBusy(true);
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            showDone(SUCCESS_COPY);
            return;
          }
          throw new Error(`lead relay answered ${res.status}`);
        } catch (err) {
          // Logged, not swallowed. When this form last looked like it "wasn't
          // posting at all", it was posting fine and falling through here on a
          // 502 from the CRM — a silent catch is what made the two look alike.
          console.warn('[lead] POST failed, falling back to the email draft:', err);
          setBusy(false);
        }
      }

      /* --- the fallback: hand off to their mail client --------------------- */
      // Reached only when there is no endpoint, or the POST above failed.
      const lines = [
        `Name: ${data.name || ''}`,
        `Phone: ${data.phone || ''}`,
        `Email: ${data.email || ''}`,
        `ZIP: ${data.zip || ''}`,
        `Situation: ${data.situation || ''}`,
        '',
        data.message || '',
        '',
        `— Sent from ${site.domain}`,
      ].join('\n');

      const mailto =
        `mailto:${EMAIL}` +
        `?subject=${encodeURIComponent(`Medicare help request — ${data.name || 'Website'}`)}` +
        `&body=${encodeURIComponent(lines)}`;

      window.location.href = mailto;
      showDone(
        `Your email app should be opening with the details filled in — press send and it's on its way to ${EMAIL}. If nothing opened, call ${site.phone.display} instead.`
      );
    });
  });
</script>
