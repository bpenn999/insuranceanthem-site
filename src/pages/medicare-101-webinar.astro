---
/**
 * /medicare-101-webinar/ — free online Medicare 101 class registration (2026-11-11).
 *
 * Modeled on a competitor's T65 webinar funnel: two session times, short form,
 * "what you'll learn", host block. Registrations post to /api/lead (→ GoGuruX)
 * with source "602 Medicare 101 Webinar" and the chosen session in the note, so
 * an X workflow on that source can send the join link + reminders.
 *
 * SESSIONS below are the only place dates live. Update them before every run;
 * past sessions drop off automatically and the form hides when none are left.
 * Times are Arizona (MST, no DST). `landing` = noindex, no site chrome; the page
 * is out of the sitemap and in scripts/audit.mjs STANDALONE_DOCS.
 *
 * No testimonials on purpose — only real, attributable reviews go here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../config/site';
import { tpmoText, nonAffiliation } from '../data/compliance';

// ISO in Arizona time (UTC-7 year-round). Edit before each webinar.
const SESSIONS = [
  { id: 's1', start: '2026-11-19T11:30:00-07:00', minutes: 60 },
  { id: 's2', start: '2026-11-20T18:00:00-07:00', minutes: 60 },
];

const title = 'Free Medicare 101 Online Class | 602Medicare';
const description =
  'Turning 65 or retiring? Join a free one-hour online Medicare 101 class with a licensed Phoenix-area agent: the 5 steps to take before your 65th birthday.';

const tel = site.phone.href;
const phone = site.phone.display;

const learn = [
  'The parts of Medicare — A, B, C and D — and how they fit together.',
  'When and how to enroll so you avoid lifetime late penalties.',
  'The gaps in Original Medicare that surprise most people.',
  'Medicare Supplement vs. Medicare Advantage — how each one works.',
  'The do’s and don’ts of choosing a Part D drug plan.',
  'Still working at 65? What to do with employer coverage, COBRA and an HSA.',
  'Live Q&A — bring every question you have.',
];

const steps = [
  'Know your enrollment window (and the date it closes).',
  'Decide whether to take Part A and Part B now or later.',
  'Understand what Original Medicare does not cover.',
  'Choose how to fill the gaps — Supplement or Advantage.',
  'Line up drug coverage so you never pay a Part D penalty.',
];
---

<BaseLayout {title} {description} path="/medicare-101-webinar/" density="light" landing>
  <header class="lp-head">
    <div class="wrap lp-head__row">
      <a class="lp-brand" href="/" aria-label={`${site.name} home`}>
        <img src="/logo/badge-128.webp" width="52" height="52" alt="" />
        <span class="lp-word"><span class="lp-word__mark">{site.wordmark.mark}</span>{site.wordmark.product}</span>
      </a>
      <a class="lp-head__call" href={tel}>📞 {phone}</a>
    </div>
  </header>

  <section class="wb-hero">
    <div class="wrap wb-hero__grid">
      <div>
        <p class="eyebrow">Free online class · 1 hour · Live Q&amp;A</p>
        <h1>Medicare 101: <span class="lp-hl">the 5 steps to take before you turn 65.</span></h1>
        <p class="wb-lede">Turning 65 or retiring soon? In one plain-English hour, learn how Medicare works, when to sign up, and how to avoid the mistakes that cost people money for life. Hosted live by {site.agent.name}, a licensed independent Medicare agent in the Phoenix area.</p>
        <ul class="wb-sessions" data-session-list>
          {SESSIONS.map((s) => (
            <li data-start={s.start} data-id={s.id}><span aria-hidden="true">📅</span> <span data-label>{s.start}</span></li>
          ))}
        </ul>
        <p class="wb-small">All times Arizona time. Watch from your computer, tablet or phone.</p>
      </div>

      <div class="wb-card" id="register">
        <div data-form-wrap>
          <h2>Save your seat — it's free</h2>
          <form data-reg novalidate>
            <div class="wb-row">
              <label>First name*<input name="first" autocomplete="given-name" required /></label>
              <label>Last name*<input name="last" autocomplete="family-name" required /></label>
            </div>
            <label>Email*<input name="email" type="email" autocomplete="email" required /></label>
            <label>Mobile phone*<input name="phone" type="tel" autocomplete="tel" required /></label>
            <label>ZIP code<input name="zip" inputmode="numeric" maxlength="5" autocomplete="postal-code" /></label>
            <fieldset>
              <legend>Choose a day and time*</legend>
              <div data-session-radios></div>
            </fieldset>
            <label class="wb-consent">
              <input type="checkbox" name="consent" required />
              <span>I agree that {site.legalName} ({site.parentCompany}) and its licensed agents may contact me at the phone number and email above, including by automated calls and text messages, about this class and Medicare insurance products. Consent is not required to buy anything. Msg &amp; data rates may apply; reply STOP to opt out, HELP for help.</span>
            </label>
            <p class="wb-err" data-err hidden></p>
            <button type="submit" class="wb-btn">Register now — it's free</button>
          </form>
        </div>
        <div data-none hidden>
          <h2>Next class coming soon</h2>
          <p>The next date isn't posted yet. Call or text <a href={tel}>{phone}</a> and we'll save you a seat — or get your questions answered today.</p>
        </div>
        <div data-done hidden>
          <h2>✅ You're registered!</h2>
          <p>You picked <strong data-done-when></strong> (Arizona time).</p>
          <p>We'll email and text you the link to join before the class starts. Questions before then? Call or text <a href={tel}>{phone}</a>.</p>
          <p><a class="wb-cal" href="#" data-ics download="medicare-101.ics">➕ Add to my calendar</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-sec lp-sec--soft">
    <div class="wrap">
      <h2>What you'll learn</h2>
      <ul class="wb-learn">{learn.map((l) => <li>{l}</li>)}</ul>
      <p class="wb-cta"><a class="wb-btn wb-btn--inline" href="#register">Save my seat</a></p>
    </div>
  </section>

  <section class="lp-sec">
    <div class="wrap lp-narrow">
      <h2>The 5 steps before your 65th birthday</h2>
      <ol class="wb-steps">{steps.map((s) => <li>{s}</li>)}</ol>
      <p class="lp-note">Miss a step and the Part B penalty is 10% for every full year you were late — added to your premium for as long as you have Part B.</p>
    </div>
  </section>

  <section class="lp-sec lp-sec--soft">
    <div class="wrap lp-narrow wb-host">
      <div class="wb-host__photo"><img src="/img/brian-penner-az-640.webp" alt={`${site.agent.name}, ${site.agent.title}`} width="640" height="800" loading="lazy" /></div>
      <div>
        <p class="lp-card__tag">Your host</p>
        <h2>{site.agent.name}</h2>
        <p>{site.agent.title} · NPN {site.agent.npn}. Brian has spent {site.agent.experience.toLowerCase()} helping people make sense of Medicare. He's independent, so he isn't selling one company's plans — and his class is about understanding the what, the when and the how so you can decide for yourself.</p>
        <p><a class="wb-btn wb-btn--inline" href="#register">Register free</a></p>
      </div>
    </div>
  </section>

  <footer class="lp-foot">
    <div class="wrap">
      <p>This is an educational class. No plans are sold or enrolled during the webinar, and there is no obligation to buy anything. {tpmoText()} {nonAffiliation} {site.agent.name} · NPN {site.agent.npn} · licensed independent insurance agent. Not affiliated with or endorsed by Facebook or any social media platform.</p>
      <p>© {new Date().getFullYear()} {site.legalName}, a DBA of {site.parentCompany} · {site.address.display} · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="lp-foot__links"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/">602medicare.com</a></p>
    </div>
  </footer>

  <script is:inline define:vars={{ SESSIONS, PHONE: phone, TEL: tel }}>
    (function () {
      var fmt = function (iso) {
        return new Date(iso).toLocaleString('en-US', { timeZone: 'America/Phoenix', weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' });
      };
      var now = Date.now();
      var live = SESSIONS.filter(function (s) { return new Date(s.start).getTime() > now; });
      document.querySelectorAll('[data-session-list] li').forEach(function (li) {
        if (new Date(li.dataset.start).getTime() <= now) { li.remove(); return; }
        li.querySelector('[data-label]').textContent = fmt(li.dataset.start);
      });
      var form = document.querySelector('[data-reg]');
      if (!live.length) {
        document.querySelector('[data-form-wrap]').hidden = true;
        document.querySelector('[data-none]').hidden = false;
        return;
      }
      var radios = document.querySelector('[data-session-radios]');
      live.forEach(function (s, i) {
        var l = document.createElement('label'); l.className = 'wb-radio';
        var r = document.createElement('input'); r.type = 'radio'; r.name = 'session'; r.value = s.id; r.required = true;
        if (live.length === 1) r.checked = true;
        l.appendChild(r); l.appendChild(document.createTextNode(' ' + fmt(s.start)));
        radios.appendChild(l);
      });
      var err = form.querySelector('[data-err]');
      function ics(s) {
        var d = function (t) { return new Date(t).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, ''); };
        var end = new Date(new Date(s.start).getTime() + s.minutes * 60000);
        return 'data:text/calendar;charset=utf-8,' + encodeURIComponent([
          'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//602Medicare//Webinar//EN', 'BEGIN:VEVENT',
          'UID:' + s.id + '-' + d(s.start) + '@602medicare.com', 'DTSTAMP:' + d(new Date()),
          'DTSTART:' + d(s.start), 'DTEND:' + d(end),
          'SUMMARY:Medicare 101 online class (602Medicare)',
          'DESCRIPTION:Your join link will be emailed and texted before the class. Questions: ' + PHONE + '.',
          'END:VEVENT', 'END:VCALENDAR'].join('\r\n'));
      }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var f = Object.fromEntries(new FormData(form));
        var miss = !f.first || !f.last || !/^\S+@\S+\.\S+$/.test(f.email || '') || (f.phone || '').replace(/\D/g, '').length < 10;
        if (miss) { err.textContent = 'Please fill in your name, email and a 10-digit phone number.'; err.hidden = false; return; }
        if (!f.session) { err.textContent = 'Please choose a day and time.'; err.hidden = false; return; }
        if (!f.consent) { err.textContent = 'Please check the box so we can send you the class link.'; err.hidden = false; return; }
        err.hidden = true;
        var s = live.filter(function (x) { return x.id === f.session; })[0];
        var when = fmt(s.start);
        var btn = form.querySelector('button'); btn.disabled = true; btn.textContent = 'Saving your seat…';
        fetch('/api/lead', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            first: f.first, last: f.last, email: f.email, phone: f.phone, zip: f.zip || '',
            source: '602 Medicare 101 Webinar', situation: 'turning-65', consent: 'on',
            message: 'Registered for Medicare 101 webinar: ' + when + ' (Arizona time) [' + s.start + ']',
            page: location.pathname,
          }),
        }).then(function (r) {
          if (!r.ok) throw new Error('relay ' + r.status);
          document.querySelector('[data-form-wrap]').hidden = true;
          var done = document.querySelector('[data-done]'); done.hidden = false;
          done.querySelector('[data-done-when]').textContent = when;
          done.querySelector('[data-ics]').href = ics(s);
          window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: 'webinar_registered' });
          done.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }).catch(function () {
          btn.disabled = false; btn.textContent = "Register now — it's free";
          err.innerHTML = 'Something went wrong saving your seat. Please call or text <a href="' + TEL + '">' + PHONE + '</a> and we’ll register you.';
          err.hidden = false;
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .lp-head { background: #fff; border-bottom: 1px solid var(--rule); }
  .lp-head__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.6rem; }
  .lp-brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .lp-brand img { width: 52px; height: 52px; display: block; }
  .lp-word { font-family: var(--font-display, inherit); font-weight: 800; font-size: 1.45rem; color: var(--navy); letter-spacing: -0.01em; }
  .lp-word__mark { color: var(--red); }
  .lp-head__call { font-weight: 800; font-size: 1.05rem; white-space: nowrap; color: var(--navy); text-decoration: none; }
  .lp-hl { color: var(--red); }
  .wb-hero { padding: clamp(2rem, 5vw, 4rem) 0; background: var(--navy-wash); }
  .wb-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: 2.5rem; align-items: start; }
  .wb-hero h1 { font-size: clamp(1.9rem, 4.4vw, 3rem); margin: 0.3em 0 0.5em; color: var(--ink); }
  .wb-lede { font-size: clamp(1.05rem, 1.3vw, 1.2rem); max-width: 58ch; color: var(--ink-body); margin: 0 0 1.2rem; }
  .wb-sessions { list-style: none; padding: 0; margin: 0 0 0.5rem; display: grid; gap: 0.5rem; }
  .wb-sessions li { font-weight: 800; font-size: 1.15rem; color: var(--navy); }
  .wb-small { font-size: 0.92rem; color: var(--ink-muted); margin: 0; }
  .wb-card { background: #fff; border: 1px solid var(--rule); border-top: 6px solid var(--red); border-radius: 14px; padding: 1.4rem; box-shadow: 0 10px 30px rgba(1, 20, 89, 0.08); }
  .wb-card h2 { font-size: 1.5rem; margin: 0 0 0.9rem; color: var(--ink); }
  .wb-card form { display: grid; gap: 0.75rem; }
  .wb-card label { display: grid; gap: 0.25rem; font-weight: 700; font-size: 0.95rem; color: var(--ink); }
  .wb-card input:not([type=checkbox]):not([type=radio]) { min-height: 48px; padding: 0 0.8rem; border: 1px solid #b9c0d4; border-radius: 8px; font: inherit; font-size: 1.05rem; width: 100%; box-sizing: border-box; }
  .wb-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .wb-card fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
  .wb-card legend { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.4rem; color: var(--ink); }
  :global(.wb-radio) { display: flex !important; align-items: center; gap: 0.6rem; min-height: 48px; padding: 0 0.8rem; border: 1px solid #b9c0d4; border-radius: 8px; font-weight: 600 !important; cursor: pointer; }
  :global(.wb-radio:has(input:checked)) { border-color: var(--navy); background: var(--navy-wash); }
  :global(.wb-radio input) { width: 20px; height: 20px; accent-color: var(--red); }
  .wb-consent { display: flex !important; gap: 0.6rem; align-items: flex-start; font-weight: 400 !important; font-size: 0.78rem !important; line-height: 1.45; color: var(--ink-muted) !important; }
  .wb-consent input { width: 20px; height: 20px; flex-shrink: 0; margin-top: 2px; accent-color: var(--red); }
  .wb-err { margin: 0; color: var(--red-deep); font-weight: 700; font-size: 0.95rem; }
  .wb-btn, .wb-btn:visited { display: inline-flex; align-items: center; justify-content: center; min-height: 56px; padding: 0 1.4rem; border: 0; border-radius: 10px; background: var(--red); color: #fff; font: inherit; font-weight: 800; font-size: 1.2rem; text-decoration: none; cursor: pointer; width: 100%; }
  .wb-btn:hover { background: var(--red-deep); }
  .wb-btn[disabled] { opacity: 0.7; cursor: wait; }
  .wb-btn--inline { width: auto; }
  .wb-cal { font-weight: 700; color: var(--navy); }
  .lp-sec { padding: clamp(2rem, 5vw, 3.5rem) 0; background: #fff; }
  .lp-sec--soft { background: var(--navy-wash); }
  .lp-sec h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin: 0 0 0.8em; color: var(--ink); }
  .lp-narrow { max-width: 860px; }
  .lp-note { margin: 1.2rem 0 0; max-width: 70ch; font-size: 1.05rem; color: var(--ink-body); }
  .lp-card__tag { margin: 0 0 0.3rem; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--red); }
  .wb-learn { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem 2rem; font-size: 1.08rem; color: var(--ink-body); }
  .wb-learn li::before { content: '✓'; color: var(--red); font-weight: 800; margin-right: 0.55rem; }
  .wb-cta { margin: 1.6rem 0 0; }
  .wb-steps { padding-left: 1.3rem; display: grid; gap: 0.7rem; font-size: 1.1rem; color: var(--ink-body); }
  .wb-steps li::marker { color: var(--red); font-weight: 800; }
  .wb-host { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 2rem; align-items: center; }
  .wb-host__photo { width: 160px; height: 160px; border-radius: 50%; overflow: hidden; position: relative; }
  .wb-host__photo img { position: absolute; width: 153.8%; height: auto; max-width: none; left: -36.5%; top: -1.9%; }
  .wb-host p { font-size: 1.05rem; color: var(--ink-body); }
  .lp-foot { padding: 2rem 0 3rem; border-top: 1px solid var(--rule); font-size: 0.85rem; color: var(--ink-muted); line-height: 1.6; background: #fff; }
  .lp-foot a { color: inherit; }
  @media (max-width: 820px) {
    .wb-hero__grid, .wb-learn, .wb-host { grid-template-columns: 1fr; }
    .wb-host__photo { width: 120px; height: 120px; }
    .lp-word { font-size: 1.2rem; }
    .lp-brand img { width: 42px; height: 42px; }
    .lp-head__call { font-size: 0.95rem; }
  }
  @media (max-width: 420px) { .wb-row { grid-template-columns: 1fr; } }
</style>
