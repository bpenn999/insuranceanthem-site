---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kinetic from '../../components/Kinetic.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import site, { abs } from '../../config/site';
import { products } from '../../data/products';

export const getStaticPaths = (async () => {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, all: articles },
  }));
}) satisfies GetStaticPaths;

const { article, all } = Astro.props;
const { Content } = await render(article);

const related = all
  .filter((a) => a.id !== article.id)
  .sort((a, b) => {
    // Same topic first, then most recent.
    const sameA = a.data.topic === article.data.topic ? 0 : 1;
    const sameB = b.data.topic === article.data.topic ? 0 : 1;
    if (sameA !== sameB) return sameA - sameB;
    return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  })
  .slice(0, 2);

/** The product page this article's topic maps to, if any. */
const topicProduct = products.find((p) => p.fullName.startsWith(article.data.topic) || p.name === article.data.topic);

const path = `/articles/${article.id}/`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Articles', path: '/articles/' },
  { name: article.data.title, path },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const schemaNodes = [
  {
    '@type': 'Article',
    '@id': `${abs(path)}#article`,
    headline: article.data.title,
    description: article.data.summary,
    datePublished: article.data.publishedAt.toISOString(),
    dateModified: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
    author: { '@id': `${site.origin}/#brian-penner` },
    publisher: { '@id': `${site.origin}/#organization` },
    mainEntityOfPage: abs(path),
    inLanguage: 'en-US',
    about: article.data.topic,
    isAccessibleForFree: true,
  },
];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description ?? article.data.summary}
  path={path}
  type="article"
  publishedAt={article.data.publishedAt.toISOString()}
  modifiedAt={(article.data.updatedAt ?? article.data.publishedAt).toISOString()}
  breadcrumbs={breadcrumbs}
  schemaNodes={schemaNodes}
  density="light"
>
  <article class="art" data-caustics="0.16">
    <header class="art__head">
      <div class="wrap wrap--narrow">
        <Breadcrumbs items={breadcrumbs} />
        <p class="art__meta">
          <span class="art__topic">{article.data.topic}</span>
          <span aria-hidden="true">·</span>
          <time datetime={article.data.publishedAt.toISOString()}>
            {fmt(article.data.publishedAt)}
          </time>
          <span aria-hidden="true">·</span>
          <span>{article.data.readMinutes} min read</span>
        </p>
        <h1 class="art__title">
          <Kinetic text={article.data.title} stagger={26} max={420} />
        </h1>
        <p class="art__summary" data-rise data-armed style="--rise-delay:180ms">
          {article.data.summary}
        </p>
        {
          article.data.updatedAt && (
            <p class="art__updated">
              Updated {fmt(article.data.updatedAt)}
            </p>
          )
        }
      </div>
    </header>

    <div class="wrap wrap--narrow">
      <div class="prose art__body">
        <Content />
      </div>

      <!-- Compliance note on every article, not just the footer. -->
      <aside class="art__note">
        <p>
          <strong>A note on the numbers.</strong> Medicare figures change every plan year, and plan
          benefits, networks and formularies change with them. Anything dated in this article was
          accurate for the plan year stated. Before acting on it,
          <a href="/contact/">confirm the current figures</a> — that is a free phone call.
        </p>
      </aside>

      <!-- Author -->
      <aside class="art__author">
        <div class="art__author-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32">
            <path d="M16 2.5 3.5 8v9.2c0 7.1 5.1 11.6 12.5 14.3 7.4-2.7 12.5-7.2 12.5-14.3V8L16 2.5Z"
                  fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <path d="M10 16.6h3.4l1.5-4 2.2 7 1.6-3h3.3"
                  fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div>
          <p class="art__author-name">{site.agent.name}</p>
          <p class="art__author-bio">
            {site.agent.title} · {site.agent.experience} in Medicare · NPN {site.agent.npn}.
            Based in {site.address.display}, serving {site.serviceArea.slice(0, 3).join(', ')} and
            north Phoenix.
          </p>
          <p class="art__author-links">
            <a href="/about/" class="link">More about Brian</a>
            <span aria-hidden="true">·</span>
            <a href={site.phone.href} class="link">{site.phone.display}</a>
          </p>
        </div>
      </aside>

      {
        topicProduct && (
          <aside class="art__next">
            <p class="art__next-label">Related</p>
            <a href={`/${topicProduct.slug}/`} class="art__next-link">
              <span>{topicProduct.fullName}</span>
              <svg viewBox="0 0 14 10" aria-hidden="true">
                <path d="M9 1l4 4-4 4M13 5H1" fill="none" stroke="currentColor"
                      stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </aside>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section band--warm" data-caustics="0.16">
        <div class="wrap wrap--narrow">
          <h2 class="more__head">Keep reading</h2>
          <ul class="more">
            {related.map((r) => (
              <li>
                <a href={`/articles/${r.id}/`}>
                  <span class="more__topic">{r.data.topic}</span>
                  <span class="more__title">{r.data.title}</span>
                  <span class="more__summary">{r.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .art { padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4rem); }

  .art__head { margin-bottom: var(--s-7); }
  .art__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--t-xs);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    margin-bottom: var(--s-4);
  }
  .art__topic {
    color: var(--navy);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .art__title { font-size: var(--t-4xl); max-width: 22ch; }
  .art__summary {
    margin-top: var(--s-5);
    font-size: var(--t-lg);
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 58ch;
  }
  .art__updated {
    margin-top: var(--s-4);
    font-size: var(--t-xs);
    color: var(--ink-faint);
  }

  .art__body { margin-bottom: var(--s-8); }

  .art__note {
    padding: var(--s-5);
    background: color-mix(in srgb, var(--porcelain-warm) 90%, transparent);
    border-left: 2px solid var(--navy);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: var(--t-sm);
    color: var(--ink-body);
    line-height: 1.65;
    margin-bottom: var(--s-6);
  }

  .art__author {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    align-items: start;
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }
  .art__author-mark {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--navy-wash);
    color: var(--navy);
  }
  .art__author-mark svg { width: 26px; height: 26px; }
  .art__author-name { font-family: var(--font-display); font-size: var(--t-lg); color: var(--ink); }
  .art__author-bio {
    font-size: var(--t-sm);
    color: var(--ink-muted);
    line-height: 1.6;
    margin-top: 0.2rem;
  }
  .art__author-links {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    display: flex;
    gap: 0.5rem;
    color: var(--ink-faint);
  }

  .art__next {
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-soft);
  }
  .art__next-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--s-2);
  }
  .art__next-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    color: var(--navy);
  }
  .art__next-link svg { width: 14px; height: 10px; transition: transform 340ms var(--ease); }
  .art__next-link:hover svg { transform: translateX(4px); }

  /* --- keep reading --- */
  .more__head { font-size: var(--t-2xl); margin-bottom: var(--s-5); }
  .more { list-style: none; padding: 0; display: grid; gap: 0; }
  .more > li { border-top: 1px solid var(--rule); }
  .more > li:last-child { border-bottom: 1px solid var(--rule); }
  .more a { display: grid; gap: 0.3rem; padding: var(--s-5) 0; color: inherit; }
  .more__topic {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .more__title { font-family: var(--font-display); font-size: var(--t-lg); color: var(--ink); }
  .more a:hover .more__title { color: var(--navy); }
  .more__summary { font-size: var(--t-sm); color: var(--ink-muted); line-height: 1.6; }

  @media (prefers-reduced-motion: reduce) {
    .art__next-link:hover svg { transform: none; }
  }
</style>
