---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import ToolsPreview from '../../components/ToolsPreview.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import site, { abs } from '../../config/site';
import { locations } from '../../data/locations';
import { locationSchemaNodes } from '../../lib/location-schema';

export const getStaticPaths = (() =>
  locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }))) satisfies GetStaticPaths;

const { location } = Astro.props;
const others = locations.filter((l) => l.slug !== location.slug);

const title = `Medicare Help in ${location.label}`;
/**
 * `seoDescription`, not `summary` + a name/NPN/phone tail. That composition read
 * well and ran 40–70 characters past the 155 Google will show, so every city
 * page shipped a description truncated mid-sentence. The credentials still
 * appear on the page itself and in the Person/LocalBusiness schema.
 */
const description = location.seoDescription;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Service Area', path: '/service-area/' },
  { name: location.city, path: `/service-area/${location.slug}/` },
];

/**
 * Written per city in locations.ts, NOT generated here.
 *
 * This block used to build four questions from one template with the city, ZIP
 * and county tokens interpolated in, which meant every service-area page shipped
 * the same four questions and the same four answers — and then emitted them a
 * second time as FAQPage schema below. Measured against the Anthem page with
 * shared chrome stripped out, the city page bodies were 56–85% identical, and
 * Search Console classified the thin end of that range accordingly: 18 pages
 * "Discovered – currently not indexed", 5 "Crawled – currently not indexed"
 * (2026-08-13). Near-duplicate location pages are the doorway pattern Google
 * declines to index, and requesting indexing on them does nothing.
 *
 * `faqs` is required on Location for that reason — a page cannot be added
 * without somebody writing questions a resident of that town would really ask.
 */
const localFaqs = location.faqs;

const schemaNodes = locationSchemaNodes(
  location,
  { title, description },
  { origin: site.origin, abs },
);
---

<BaseLayout
  title={title}
  description={description}
  path={`/service-area/${location.slug}/`}
  breadcrumbs={breadcrumbs}
  schemaNodes={schemaNodes}
>
  <PageHero
    eyebrow={`${location.county} · ${location.zips.join(' · ')}`}
    title={`Medicare help in ${location.city}.`}
    lede={location.summary}
    breadcrumbs={breadcrumbs}
  >
    <div class="btn-row">
      <a href="/contact/" class="btn btn--lg" data-magnetic="0.3">Book a free review</a>
      <a href={site.phone.href} class="btn btn--ghost btn--lg" data-magnetic="0.22">
        Call {site.phone.display}
      </a>
    </div>
  </PageHero>

  <!-- ── Local context ────────────────────────────────────────────────── -->
  <section class="section section--tight" data-caustics="0.3">
    <div class="wrap loc">
      <div class="loc__main">
        <h2 class="loc__h2">What Medicare looks like in {location.city}</h2>
        <div class="loc__body">
          {location.local.map((para, i) => (
            <p data-rise data-armed style={`--rise-delay:${i * 70}ms`}>{para}</p>
          ))}
        </div>
      </div>

      <aside class="card loc__card" data-rise data-armed>
        <h2 class="loc__card-title">Getting to you</h2>
        <p class="loc__card-note">{location.proximity}</p>
        <dl class="loc__meta">
          <div>
            <dt>Based in</dt>
            <dd>{site.address.display}</dd>
          </div>
          <div>
            <dt>Covering</dt>
            <dd>{location.label} · {location.zips.join(', ')}</dd>
          </div>
          <div>
            <dt>County</dt>
            <dd>{location.county}</dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>{site.hours.display}</dd>
          </div>
          <div>
            <dt>Advisor</dt>
            <dd>{site.agent.name} · NPN {site.agent.npn}</dd>
          </div>
          {/*
            Visible, and matching `dateModified` in the WebPage node exactly.
            A date that exists only in structured data is a claim made to
            crawlers and withheld from readers — and on Medicare copy, which
            resets every January, "when was this checked" is a fair question to
            answer out loud rather than in a script tag.
          */}
          <div>
            <dt>Reviewed</dt>
            <dd>
              <time datetime={location.reviewed}>
                {new Date(`${location.reviewed}T12:00:00Z`).toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
            </dd>
          </div>
        </dl>
        <a href={site.phone.href} class="btn btn--block loc__card-cta" data-magnetic="0.2">
          Call {site.phone.display}
        </a>
      </aside>
    </div>
  </section>

  <!-- ── Services ─────────────────────────────────────────────────────── -->
  <section class="section band--tint" data-caustics="0.24">
    <div class="wrap">
      <SectionHead
        eyebrow={`Serving ${location.city}`}
        title="What I can help with."
        lede="Medicare at the center, and the coverage that surrounds it after 65 — which is why the answers are specific rather than general."
      />
      <ServicesGrid />
    </div>
  </section>

  <!-- ── Tools ────────────────────────────────────────────────────────── -->
  <section class="section" data-caustics="0.32">
    <div class="wrap">
      <SectionHead
        eyebrow="Before you call"
        title="Free tools, no email required."
      />
      <ToolsPreview limit={3} />
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="section band--tint-deep" data-caustics="0.22">
    <div class="wrap wrap--narrow">
      <SectionHead eyebrow="Questions" title={`Medicare in ${location.city}, answered.`} />
      <Faq items={localFaqs} openFirst />
    </div>
  </section>

  <!-- ── Sources ──────────────────────────────────────────────────────────
       The .gov / .mil pages behind the rules this city's copy relies on.
       Placed after the FAQ because that is where the load-bearing claims are
       made — the IRMAA lookback, the custodial-care gap, the Part B penalty —
       and a reader who wants to check one should not have to hunt.
       `rel="noopener"` on a new tab; not `nofollow`, because citing a
       government source is exactly the link a search engine should follow.
  ─────────────────────────────────────────────────────────────────────── -->
  <section class="section section--tight" data-caustics="0.18">
    <div class="wrap wrap--narrow">
      <h2 class="src__h2">Where these rules come from</h2>
      <p class="src__note">
        Official sources for the Medicare rules referenced on this page. Figures and
        rules are reviewed each plan year — this page was last checked {
          new Date(`${location.reviewed}T12:00:00Z`).toLocaleDateString('en-US', {
            month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
          })
        }.
      </p>
      <ul class="src">
        {
          location.sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">{s.label}</a>
              <span class="src__host">{new URL(s.url).hostname.replace(/^www\./, '')}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Nearby ───────────────────────────────────────────────────────── -->
  <section class="section" data-caustics="0.3">
    <div class="wrap">
      <SectionHead eyebrow="Nearby" title="Also serving." rule={false} />
      <ul class="nearby">
        {
          others.map((o, i) => (
            <li data-rise data-armed style={`--rise-delay:${i * 70}ms`}>
              <a href={`/service-area/${o.slug}/`} class="nearby__link">
                <span class="nearby__city">{o.label}</span>
                <span class="nearby__zip">{o.zips.join(' · ')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title={`Let's talk about your options in ${location.city}.`}
    body={`No cost, no obligation, no call center. ${site.agent.name} directly — ${site.agent.experience} doing exactly this.`}
  />
</BaseLayout>

<style>
  .src__h2 { font-size: var(--t-xl); margin-bottom: var(--s-2); }
  .src__note { font-size: var(--t-sm); color: var(--ink-muted); line-height: 1.55; margin-bottom: var(--s-4); }
  .src { display: grid; gap: var(--s-3); list-style: none; padding: 0; margin: 0; }
  .src li { display: grid; gap: 0.1rem; padding-bottom: var(--s-3); border-bottom: 1px solid var(--rule-soft); }
  .src li:last-child { border-bottom: 0; padding-bottom: 0; }
  .src a { font-size: var(--t-base); }
  .src__host { font-size: 0.75rem; color: var(--ink-muted); font-variant-numeric: tabular-nums; }

  .loc { display: grid; gap: var(--s-7); align-items: start; }
  .loc__h2 { font-size: var(--t-2xl); margin-bottom: var(--s-5); }
  .loc__body { color: var(--ink-body); font-size: var(--t-lg); line-height: 1.65; max-width: 62ch; }
  .loc__body p + p { margin-top: 1.1em; }

  .loc__card { background: color-mix(in srgb, var(--surface) 96%, transparent); }
  .loc__card-title { font-size: var(--t-lg); margin-bottom: var(--s-2); }
  .loc__card-note { font-size: var(--t-sm); color: var(--ink-muted); margin-bottom: var(--s-5); line-height: 1.55; }

  .loc__meta { display: grid; gap: var(--s-3); margin-bottom: var(--s-5); }
  .loc__meta div { display: grid; gap: 0.1rem; padding-bottom: var(--s-3); border-bottom: 1px solid var(--rule-soft); }
  .loc__meta div:last-child { border-bottom: 0; padding-bottom: 0; }
  .loc__meta dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .loc__meta dd { margin: 0; font-size: var(--t-sm); color: var(--ink-body); }

  @media (min-width: 900px) {
    .loc { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--s-9); }
    .loc__card { position: sticky; top: 6rem; }
  }

  .nearby {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border-block: 1px solid var(--rule);
  }
  .nearby__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-2);
    background: var(--page);
    transition: background-color 260ms var(--ease), padding-left 300ms var(--ease);
  }
  .nearby__link:hover { background: var(--surface); padding-left: var(--s-4); }
  .nearby__city { font-family: var(--font-display); font-size: var(--t-lg); color: var(--ink); }
  .nearby__link:hover .nearby__city { color: var(--navy); }
  .nearby__zip { font-size: var(--t-xs); color: var(--ink-faint); letter-spacing: 0.05em; }

  @media (prefers-reduced-motion: reduce) {
    .nearby__link:hover { padding-left: var(--s-2); }
  }
</style>
